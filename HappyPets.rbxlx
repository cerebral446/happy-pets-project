		P(m, "Block", V(0.25, 1.6, 0.06), V(-1.2, 0.8, 0.87), rgb(110, 170, 230))
		P(m, "Block", V(0.25, 1.6, 0.06), V(1.2, 0.8, 0.87), rgb(110, 170, 230))
		P(m, "Ball", V(0.8, 0.8, 0.8), V(1.0, 2.1, -0.2), rgb(200, 150, 100), Mat.Fabric)
