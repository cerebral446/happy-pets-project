		P(m, "Block", V(3.4, 1.6, 1.4), V(0, 2.45, 0), rgb(90, 170, 230), Mat.SmoothPlastic, nil, 0.6)
		P(m, "Block", V(3.4, 0.2, 1.4), V(0, 1.7, 0), rgb(230, 210, 160), Mat.Sand)
		P(m, "Ellipsoid", V(0.6, 0.35, 0.18), V(-0.7, 2.6, 0.2), rgb(250, 140, 40), nil, nil, nil, "Fish")
		P(m, "Ellipsoid", V(0.5, 0.3, 0.16), V(0.8, 2.2, -0.1), rgb(250, 220, 60), nil, nil, nil, "Fish")
		P(m, "Ellipsoid", V(0.2, 0.9, 0.2), V(1.3, 2.2, -0.3), rgb(80, 180, 90))
		P(m, "Block", V(3.7, 0.15, 1.7), V(0, 3.65, 0), rgb(60, 60, 70))
	end,
	flower_bed = function(m)
		P(m, "Block", V(3.6, 0.9, 1.6), V(0, 0.45, 0), rgb(200, 140, 100), Mat.Wood)
		P(m, "Block", V(3.3, 0.1, 1.3), V(0, 0.92, 0), rgb(110, 80, 60), Mat.Ground)
		local petals = { rgb(240, 80, 120), rgb(250, 200, 60), rgb(240, 120, 200), rgb(250, 130, 70), rgb(200, 120, 240) }
		for i = 1, 5 do
			local x = -1.4 + (i - 1) * 0.7
			P(m, "Cylinder", V(0.1, 1.0, 0.1), V(x, 1.4, (i % 2) * 0.3 - 0.15), rgb(80, 160, 80))
			P(m, "Ellipsoid", V(0.45, 0.55, 0.45), V(x, 2.0, (i % 2) * 0.3 - 0.15), petals[i])
		end
	end,
	garden_tree = function(m)
		P(m, "Cylinder", V(0.8, 3.0, 0.8), V(0, 1.5, 0), rgb(140, 100, 70), Mat.Wood)
		P(m, "Ellipsoid", V(3.6, 3.0, 3.6), V(0, 4.0, 0), rgb(100, 180, 90), Mat.Grass)
		P(m, "Ellipsoid", V(2.4, 2.2, 2.4), V(0.6, 5.2, 0.3), rgb(120, 196, 100), Mat.Grass)
		P(m, "Ball", V(0.35, 0.35, 0.35), V(1.2, 3.6, 1.3), rgb(230, 60, 60))
		P(m, "Ball", V(0.35, 0.35, 0.35), V(-1.1, 4.4, 1.0), rgb(230, 60, 60))
	end,
	fountain = function(m)
		local stone = rgb(214, 214, 224)
		P(m, "Cylinder", V(3.9, 0.9, 3.9), V(0, 0.45, 0), stone, Mat.Marble)
		P(m, "Cylinder", V(3.3, 0.1, 3.3), V(0, 0.88, 0), rgb(120, 190, 240), Mat.Glass, nil, 0.2)
		P(m, "Cylinder", V(0.6, 2.2, 0.6), V(0, 1.9, 0), stone, Mat.Marble)
		P(m, "Cylinder", V(1.8, 0.35, 1.8), V(0, 3.0, 0), stone, Mat.Marble)
		P(m, "Cylinder", V(0.25, 1.0, 0.25), V(0, 3.6, 0), rgb(160, 220, 255), Mat.Glass, nil, 0.3)
		P(m, "Ball", V(0.6, 0.6, 0.6), V(0, 4.15, 0), rgb(160, 220, 255), Mat.Glass, nil, 0.3)
	end,
}

-- A plain box sized to the footprint, used when an item has no builder.
local function fallback(m: Model, itemId: string)
	local item = Config.Items[itemId]
	local w, d = item.Footprint[1] * Config.Room.Cell, item.Footprint[2] * Config.Room.Cell
	P(m, "Block", V(w - 0.2, 1, d - 0.2), V(0, 0.5, 0), rgb(220, 200, 240))
end

-- Builds the item at the origin. The pivot is the floor centre.
function FurnitureModels.Create(itemId: string): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Furniture")
	local custom = folder and folder:FindFirstChild(itemId)
	if custom and custom:IsA("Model") then
		local m = custom:Clone()
		for _, p in m:GetDescendants() do
			if p:IsA("BasePart") then
				p.Anchored = true
			end
		end
		m:PivotTo(CFrame.identity)
		return m
	end
	local m = Instance.new("Model")
	m.Name = itemId
	local build = builders[itemId]
	if build then
		build(m)
	else
		fallback(m, itemId)
	end
	m.WorldPivot = CFrame.identity
	return m
end

-- World CFrame for an item at (cx, cz, rot) in a room whose floor centre is roomCF.
function FurnitureModels.PlacementCFrame(roomCF: CFrame, itemId: string, cx: number, cz: number, rot: number, Placement: any): CFrame
	local x, z = Placement.CellToLocal(itemId, cx, cz, rot)
	return roomCF * CFrame.new(x, 0, z) * CFrame.Angles(0, -rot * math.pi / 2, 0)
end

return FurnitureModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">PetModels</string><ProtectedString name="Source"><![CDATA[-- Builds pet models out of parts, coloured by species, coat colour, pattern
-- and eye colour. Used by the server (pets in the world) and the client
-- (adoption previews and portraits).
--
-- Animation rig: every part has a "Group" attribute (Body, Head, Tail, LegFL,
-- LegFR, LegBL, LegBR) and a "Rest" CFrame relative to that group's joint.
-- The model stores each joint as an attribute "Joint_<Group>" relative to the
-- invisible "Root" part at floor level. Head and Tail hang off the Body; legs
-- hang off the Root. The client's PetAnimator poses the groups.
--
-- Pets face -Z. To use real artwork instead, put a model named after the
-- species in ReplicatedStorage.Assets.Pets with the same part groups (see
-- the README); it is cloned and tinted instead of the built-in shapes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)
local Build = require(script.Parent.Build)

local PetModels = {}

local WHITE = Color3.fromRGB(250, 248, 244)
local PINK = Color3.fromRGB(240, 150, 170)
local DARK = Color3.fromRGB(40, 34, 38)

-- Body proportions per species (studs at scale 1).
local SHAPES = {
	Cat = { body = Vector3.new(1.6, 1.45, 2.3), head = Vector3.new(1.75, 1.55, 1.5), leg = 0.95, ears = "Pointy", tail = "Long", snout = 0 },
	Dog = { body = Vector3.new(1.75, 1.6, 2.5), head = Vector3.new(1.8, 1.6, 1.6), leg = 1.05, ears = "Floppy", tail = "Wag", snout = 0.45 },
	Bunny = { body = Vector3.new(1.7, 1.6, 2.0), head = Vector3.new(1.6, 1.5, 1.45), leg = 0.6, ears = "Long", tail = "Puff", snout = 0 },
	Fox = { body = Vector3.new(1.55, 1.4, 2.4), head = Vector3.new(1.7, 1.45, 1.5), leg = 1.0, ears = "Big", tail = "Bushy", snout = 0.55 },
	Panda = { body = Vector3.new(2.1, 1.9, 2.5), head = Vector3.new(2.0, 1.8, 1.7), leg = 0.85, ears = "Round", tail = "Stub", snout = 0.25 },
}

-- Spots on the body surface for "Spotted" and "Calico" (unit body space).
local SPOTS = {
	Vector3.new(0.35, 0.35, -0.3),
	Vector3.new(-0.4, 0.3, 0.2),
	Vector3.new(0.1, 0.45, 0.35),
	Vector3.new(-0.2, 0.42, -0.05),
	Vector3.new(0.45, 0.1, 0.3),
}

type Builder = {
	model: Model,
	scale: number,
	add: (self: Builder, group: string, name: string, shape: string, size: Vector3, pos: Vector3, rot: CFrame?, color: Color3, material: Enum.Material?) -> BasePart,
}

local function colorsFor(species: string, colorName: string, pattern: string)
	local base = Config.Colors[colorName] or Config.Colors.Orange
	local c = {
		coat = base,
		accent = Build.Shade(base, -0.35),
		belly = Build.Shade(base, 0.35),
		paws = base,
		muzzle = Build.Shade(base, 0.3),
		ears = base,
		tail = base,
		earInner = PINK,
	}
	if pattern == "Tuxedo" then
		c.belly, c.paws, c.muzzle = WHITE, WHITE, WHITE
	elseif pattern == "Socks" then
		c.paws = if species == "Fox" then DARK else WHITE
	elseif pattern == "Points" then
		c.coat = Build.Shade(base, 0.6)
		c.belly = Build.Shade(base, 0.7)
		local point = Build.Shade(base, -0.3)
		c.paws, c.muzzle, c.ears, c.tail = point, point, point, point
	elseif pattern == "Calico" then
		c.coat, c.belly, c.paws, c.muzzle = WHITE, WHITE, WHITE, WHITE
	elseif pattern == "Panda" then
		local dark = if colorName == "Brown" then Config.Colors.Chocolate else DARK
		c.coat, c.belly, c.muzzle, c.tail = WHITE, WHITE, WHITE, WHITE
		c.paws, c.ears, c.accent = dark, dark, dark
		c.earInner = dark
	end
	if species == "Fox" and pattern ~= "Points" then
		c.belly = WHITE
		c.muzzle = WHITE
		c.earInner = DARK
	end
	if species == "Bunny" then
		c.earInner = PINK
	end
	return c
end

local function newBuilder(model: Model, scale: number): Builder
	local b = { model = model, scale = scale } :: any
	function b.add(self: Builder, group: string, name: string, shape: string, size: Vector3, pos: Vector3, rot: CFrame?, color: Color3, material: Enum.Material?): BasePart
		local rest = CFrame.new(pos * self.scale) * (rot or CFrame.identity)
		local joint = self.model:GetAttribute("Joint_" .. group) :: CFrame
		local part = Build.Part({
			Name = name,
			Shape = shape,
			Size = size * self.scale,
			CFrame = joint * rest,
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
			Parent = self.model,
		})
		part:SetAttribute("Group", group)
		part:SetAttribute("Rest", rest)
		-- Cylinders are rotated inside Build.Part; record what was actually used.
		if shape == "Cylinder" then
			part:SetAttribute("Rest", rest * CFrame.Angles(0, 0, math.pi / 2))
		end
		part.CastShadow = false
		return part
	end
	return b
end

-- Builds a pet at the origin (floor level, facing -Z). `pet` needs species,
-- color, pattern, eyes and stage.
function PetModels.Build(pet: any): Model
	local species = pet.species
	local def = Config.Species[species] or Config.Species.Cat
	local shape = SHAPES[species] or SHAPES.Cat
	local baby = pet.stage == "Baby"
	local scale = def.Scale * (if baby then 0.7 else 1)
	local headBoost = if baby then 1.12 else 1
	local c = colorsFor(species, pet.color, pet.pattern)

	local model = Instance.new("Model")
	model.Name = pet.name or species

	local body, head = shape.body, shape.head * headBoost
	local legLen = shape.leg
	local hipY = legLen
	local bodyY = hipY + body.Y * 0.35
	local halfZ = body.Z / 2

	local joints = {
		Body = CFrame.new(0, bodyY * scale, 0),
		Head = CFrame.new(0, (bodyY + body.Y * 0.55) * scale, (-halfZ - head.Z * 0.05) * scale),
		Tail = CFrame.new(0, (bodyY + body.Y * 0.1) * scale, (halfZ - 0.15) * scale),
		LegFL = CFrame.new(-body.X * 0.27 * scale, hipY * scale, -halfZ * 0.55 * scale),
		LegFR = CFrame.new(body.X * 0.27 * scale, hipY * scale, -halfZ * 0.55 * scale),
		LegBL = CFrame.new(-body.X * 0.27 * scale, hipY * scale, halfZ * 0.55 * scale),
		LegBR = CFrame.new(body.X * 0.27 * scale, hipY * scale, halfZ * 0.55 * scale),
	}
	if species == "Bunny" then
		-- Bunnies sit upright-ish with the head tucked low and close.
		joints.Head = CFrame.new(0, (bodyY + body.Y * 0.5) * scale, (-halfZ + 0.15) * scale)
	end
	for group, cf in joints do
		model:SetAttribute("Joint_" .. group, cf)
	end

	-- Invisible root: floor-level pivot and click hitbox.
	local totalH = (bodyY + body.Y * 0.55 + head.Y * 0.9) * scale
	local root = Build.Part({
		Name = "Root",
		Size = Vector3.new(body.X + 0.4, totalH, body.Z + head.Z * 0.6) * Vector3.new(scale, 1, scale),
		CFrame = CFrame.new(0, totalH / 2, 0),
		Color = c.coat,
		Transparency = 1,
		Parent = model,
	})
	root:SetAttribute("Height", totalH)
	-- Pivot at floor level so PivotTo places the paws on the floor.
	root.PivotOffset = CFrame.new(0, -totalH / 2, 0)
	model.PrimaryPart = root

	local b = newBuilder(model, scale)

	-- Body
	b:add("Body", "Torso", "Ellipsoid", body, Vector3.zero, nil, c.coat)
	b:add("Body", "Belly", "Ellipsoid", Vector3.new(body.X * 0.7, body.Y * 0.7, body.Z * 0.45), Vector3.new(0, -body.Y * 0.12, -halfZ * 0.62), nil, c.belly)

	if pet.pattern == "Tabby" then
		for i = -1, 1 do
			b:add("Body", "Stripe", "Ellipsoid", Vector3.new(body.X * 1.04, body.Y * 0.55, 0.22), Vector3.new(0, body.Y * 0.2, i * body.Z * 0.24), nil, c.accent)
		end
	elseif pet.pattern == "Spotted" then
		for i, s in SPOTS do
			if i <= 4 then
				b:add("Body", "Spot", "Ellipsoid", Vector3.new(0.55, 0.45, 0.55), s * body, nil, c.accent)
			end
		end
	elseif pet.pattern == "Calico" then
		local patches = { Config.Colors.Orange, DARK, Config.Colors.Orange, DARK }
		for i = 1, 4 do
			b:add("Body", "Patch", "Ellipsoid", Vector3.new(0.85, 0.65, 0.85), SPOTS[i] * body, nil, patches[i])
		end
	elseif pet.pattern == "Panda" then
		b:add("Body", "Band", "Ellipsoid", Vector3.new(body.X * 1.04, body.Y * 1.02, body.Z * 0.32), Vector3.new(0, 0.02, -halfZ * 0.35), nil, c.accent)
	end

	-- Legs and paws
	for _, g in { "LegFL", "LegFR", "LegBL", "LegBR" } do
		local back = string.sub(g, 4, 4) == "B"
		local len = if species == "Bunny" and back then legLen * 1.1 else legLen
		local legColor = if pet.pattern == "Panda" or pet.pattern == "Points" then c.paws else c.coat
		local thick = if species == "Panda" then 0.62 else 0.48
		b:add(g, "Leg", "Ellipsoid", Vector3.new(thick, len + 0.25, thick), Vector3.new(0, -len / 2, 0), nil, legColor)
		b:add(g, "Paw", "Ellipsoid", Vector3.new(thick + 0.08, 0.3, thick + 0.22), Vector3.new(0, -len + 0.13, -0.08), nil, c.paws)
	end

	-- Head
	local hx, hy, hz = head.X, head.Y, head.Z
	b:add("Head", "Skull", "Ellipsoid", head, Vector3.zero, nil, c.coat)
	if pet.pattern == "Tabby" then
		b:add("Head", "Stripe", "Ellipsoid", Vector3.new(0.18, hy * 0.5, hz * 0.6), Vector3.new(0, hy * 0.28, -hz * 0.15), nil, c.accent)
		b:add("Head", "Stripe", "Ellipsoid", Vector3.new(0.14, hy * 0.42, hz * 0.6), Vector3.new(-0.28, hy * 0.26, -hz * 0.12), nil, c.accent)
		b:add("Head", "Stripe", "Ellipsoid", Vector3.new(0.14, hy * 0.42, hz * 0.6), Vector3.new(0.28, hy * 0.26, -hz * 0.12), nil, c.accent)
	elseif pet.pattern == "Calico" then
		b:add("Head", "Patch", "Ellipsoid", Vector3.new(hx * 0.6, hy * 0.6, hz * 0.9), Vector3.new(-hx * 0.22, hy * 0.18, 0), nil, Config.Colors.Orange)
	elseif pet.pattern == "Points" then
		b:add("Head", "Mask", "Ellipsoid", Vector3.new(hx * 0.62, hy * 0.62, hz * 0.4), Vector3.new(0, -hy * 0.08, -hz * 0.32), nil, c.muzzle)
	end

	-- Muzzle / snout
	local snout = shape.snout
	local muzzleZ = -hz * 0.42 - snout * 0.5
	b:add("Head", "Muzzle", "Ellipsoid", Vector3.new(hx * 0.5, hy * 0.36, hz * 0.4 + snout), Vector3.new(0, -hy * 0.2, muzzleZ), nil, c.muzzle)
	b:add("Head", "Nose", "Ellipsoid", Vector3.new(0.26, 0.18, 0.18), Vector3.new(0, -hy * 0.1, muzzleZ - (hz * 0.4 + snout) / 2 + 0.04), nil, if species == "Panda" or species == "Dog" or species == "Fox" then DARK else PINK)

	-- Eyes (open) and closed-eye lines for sleeping
	local eyeColor = Config.EyeColors[pet.eyes] or Config.EyeColors.Brown
	for _, side in { -1, 1 } do
		local ex, ey, ez = side * hx * 0.22, hy * 0.06, -hz * 0.43
		if pet.pattern == "Panda" then
			b:add("Head", "EyePatch", "Ellipsoid", Vector3.new(0.6, 0.75, 0.3), Vector3.new(ex, ey - 0.05, ez + 0.03), CFrame.Angles(0, 0, side * 0.5), c.accent)
		end
		local iris = b:add("Head", "Iris", "Ellipsoid", Vector3.new(0.36, 0.44, 0.16), Vector3.new(ex, ey, ez - 0.02), nil, eyeColor)
		local pupil = b:add("Head", "Pupil", "Ellipsoid", Vector3.new(0.22, 0.32, 0.12), Vector3.new(ex, ey - 0.02, ez - 0.07), nil, DARK)
		local shine = b:add("Head", "Shine", "Ellipsoid", Vector3.new(0.1, 0.1, 0.06), Vector3.new(ex + side * 0.05, ey + 0.09, ez - 0.12), nil, Color3.new(1, 1, 1))
		for _, p in { iris, pupil, shine } do
			p:SetAttribute("Eye", true)
		end
		local closed = b:add("Head", "EyeClosed", "Ellipsoid", Vector3.new(0.34, 0.07, 0.1), Vector3.new(ex, ey - 0.04, ez - 0.05), nil, DARK)
		closed:SetAttribute("EyeClosed", true)
		closed.Transparency = 1
		-- Rosy cheeks.
		b:add("Head", "Cheek", "Ellipsoid", Vector3.new(0.3, 0.16, 0.12), Vector3.new(side * hx * 0.33, -hy * 0.16, -hz * 0.36), nil, Build.Shade(PINK, 0.35))
	end

	-- Ears
	local earStyle = shape.ears
	for _, side in { -1, 1 } do
		if earStyle == "Pointy" or earStyle == "Big" then
			local s = if earStyle == "Big" then 0.75 else 0.55
			local pos = Vector3.new(side * hx * 0.3, hy * 0.36, -hz * 0.02)
			local tilt = CFrame.Angles(0, 0, side * -0.2) * CFrame.Angles(0, 0, math.rad(45))
			b:add("Head", "Ear", "Block", Vector3.new(s, s, 0.16), pos, tilt, c.ears)
			b:add("Head", "EarInner", "Block", Vector3.new(s * 0.6, s * 0.6, 0.06), pos + Vector3.new(0, 0.02, -0.07), tilt, c.earInner)
		elseif earStyle == "Floppy" then
			b:add("Head", "Ear", "Ellipsoid", Vector3.new(0.35, 0.95, 0.6), Vector3.new(side * hx * 0.47, hy * 0.02, 0.05), CFrame.Angles(0, 0, side * 0.25), Build.Shade(c.ears, -0.15))
		elseif earStyle == "Long" then
			local rot = CFrame.Angles(-0.15, 0, side * -0.12)
			b:add("Head", "Ear", "Ellipsoid", Vector3.new(0.42, 1.5, 0.28), Vector3.new(side * hx * 0.2, hy * 0.85, 0.08), rot, c.ears)
			b:add("Head", "EarInner", "Ellipsoid", Vector3.new(0.24, 1.2, 0.1), Vector3.new(side * hx * 0.2, hy * 0.85, -0.02), rot, c.earInner)
		elseif earStyle == "Round" then
			b:add("Head", "Ear", "Ellipsoid", Vector3.new(0.55, 0.55, 0.3), Vector3.new(side * hx * 0.36, hy * 0.38, 0.05), nil, c.ears)
		end
	end

	-- Tail
	local tail = shape.tail
	if tail == "Long" then
		b:add("Tail", "Tail", "Ellipsoid", Vector3.new(0.3, 0.3, 1.2), Vector3.new(0, 0.3, 0.45), CFrame.Angles(math.rad(-50), 0, 0), c.tail)
		b:add("Tail", "TailTip", "Ellipsoid", Vector3.new(0.28, 0.28, 0.95), Vector3.new(0, 1.0, 0.8), CFrame.Angles(math.rad(-80), 0, 0), if pet.pattern == "Tabby" then c.accent else c.tail)
	elseif tail == "Wag" then
		b:add("Tail", "Tail", "Ellipsoid", Vector3.new(0.3, 0.3, 1.1), Vector3.new(0, 0.35, 0.35), CFrame.Angles(math.rad(-55), 0, 0), c.tail)
	elseif tail == "Puff" then
		b:add("Tail", "Tail", "Ellipsoid", Vector3.new(0.65, 0.65, 0.6), Vector3.new(0, 0, 0.1), nil, WHITE)
	elseif tail == "Bushy" then
		b:add("Tail", "Tail", "Ellipsoid", Vector3.new(0.75, 0.75, 1.7), Vector3.new(0, 0.2, 0.75), CFrame.Angles(math.rad(-25), 0, 0), c.tail)
		b:add("Tail", "TailTip", "Ellipsoid", Vector3.new(0.6, 0.6, 0.6), Vector3.new(0, 0.6, 1.5), CFrame.Angles(math.rad(-25), 0, 0), WHITE)
	elseif tail == "Stub" then
		b:add("Tail", "Tail", "Ellipsoid", Vector3.new(0.45, 0.45, 0.4), Vector3.new(0, 0, 0.05), nil, c.tail)
	end

	return model
end

-- Uses a replacement model from ReplicatedStorage.Assets.Pets if one exists
-- for this species, tinting parts named Coat / Accent / Eye.
function PetModels.Create(pet: any): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Pets")
	local custom = folder and folder:FindFirstChild(pet.species)
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		local model = custom:Clone()
		local coat = Config.Colors[pet.color] or Config.Colors.Orange
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Anchored = true
				p.CanCollide = false
				if p.Name == "Coat" then
					p.Color = coat
				elseif p.Name == "Accent" then
					p.Color = Build.Shade(coat, -0.35)
				elseif p.Name == "Eye" then
					p.Color = Config.EyeColors[pet.eyes] or p.Color
				end
			end
		end
		model.Name = pet.name or pet.species
		return model
	end
	return PetModels.Build(pet)
end

return PetModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">PetRules</string><ProtectedString name="Source"><![CDATA[-- Pet game rules: creating pets, needs over time, care effects, growing up,
-- coat inheritance and the adoption centre's daily selection.
-- Pure functions (no Roblox APIs) so they're shared and unit-tested.

local Config = require(script.Parent.Config)
local Rng = require(script.Parent.Rng)

local PetRules = {}

export type Look = { color: string, pattern: string, eyes: string }

local function contains(list: { string }, value: string): boolean
	return table.find(list, value) ~= nil
end

local function clampNeed(v: number): number
	return math.clamp(v, 0, 100)
end

function PetRules.NewPet(id: string, species: string, look: Look, name: string, gender: string, stage: string, now: number, roomId: string): any
	return {
		id = id,
		name = name,
		gender = gender,
		species = species,
		color = look.color,
		pattern = look.pattern,
		eyes = look.eyes,
		stage = stage,
		bornAt = now,
		careCount = 0,
		room = roomId,
		x = 0,
		z = 2,
		needs = { Food = 80, Fun = 80, Energy = 90, Clean = 90, Health = 100 },
		sleeping = false,
		lastBredAt = 0,
		lastGiftAt = now,
		cooldowns = {},
		parents = nil,
	}
end

function PetRules.Mood(pet: any): number
	local n = pet.needs
	-- Health counts double: a poorly pet is never "ecstatic".
	return (n.Food + n.Fun + n.Energy + n.Clean + n.Health * 2) / 6
end

function PetRules.MoodLabel(mood: number): (string, string)
	if mood >= 85 then
		return "Ecstatic", "😻"
	elseif mood >= 65 then
		return "Happy", "😊"
	elseif mood >= 45 then
		return "Okay", "🙂"
	elseif mood >= 25 then
		return "Sad", "😢"
	end
	return "Miserable", "😿"
end

-- The need that most wants attention, if any is low.
function PetRules.LowestNeed(pet: any, threshold: number?): string?
	local limit = threshold or 35
	local worst, worstValue = nil, limit
	for _, need in Config.Needs do
		local v = pet.needs[need]
		if v < worstValue then
			worst, worstValue = need, v
		end
	end
	return worst
end

export type Env = { comfort: number, litter: boolean, hasBed: boolean }

-- Advances one pet's needs by dt seconds. Long gaps are simulated in
-- one-minute steps so sleeping and waking happen at the right moments.
-- Returns true if the pet fell asleep or woke up.
function PetRules.Simulate(pet: any, dt: number, env: Env): boolean
	if dt <= 0 then
		return false
	end
	local d = Config.Decay
	local changed = false
	local comfort = math.clamp(env.comfort, 0, d.ComfortCap) / d.ComfortCap
	local funFactor = 1 - d.ComfortMaxSlowdown * comfort
	local cleanFactor = if env.litter then d.LitterFactor else 1
	local remaining = dt
	while remaining > 0 do
		local step = math.min(remaining, 60)
		remaining -= step
		local minutes = step / 60
		local n = pet.needs
		local sleepFactor = if pet.sleeping then d.SleepingFactor else 1
		n.Food = clampNeed(n.Food - d.Food * minutes * sleepFactor)
		n.Fun = clampNeed(n.Fun - d.Fun * minutes * sleepFactor * funFactor)
		n.Clean = clampNeed(n.Clean - d.Clean * minutes * sleepFactor * cleanFactor)
		if pet.sleeping then
			local rate = if env.hasBed then d.EnergySleepBed else d.EnergySleep
			n.Energy = clampNeed(n.Energy + rate * minutes)
			if n.Energy >= 100 then
				pet.sleeping = false
				changed = true
			end
		else
			n.Energy = clampNeed(n.Energy - d.EnergyAwake * minutes)
			if n.Energy <= d.AutoSleepAt then
				pet.sleeping = true
				changed = true
			end
		end
		local low = n.Food < d.LowThreshold or n.Clean < d.LowThreshold or n.Fun < d.LowThreshold
		if low then
			n.Health = math.max(d.HealthMin, n.Health - d.HealthLoss * minutes)
		else
			n.Health = clampNeed(n.Health + d.HealthGain * minutes)
		end
	end
	return changed
end

function PetRules.ApplyEffects(pet: any, effects: { [string]: number })
	for need, amount in effects do
		if pet.needs[need] ~= nil then
			pet.needs[need] = clampNeed(pet.needs[need] + amount)
		end
	end
	-- Eating, bathing and playing keep health up a little too.
	if (effects.Food or 0) > 0 or (effects.Clean or 0) > 0 then
		pet.needs.Health = clampNeed(pet.needs.Health + 2)
	end
end

-- Babies grow up with time or with enough care. Returns true when it happens.
function PetRules.Grow(pet: any, now: number): boolean
	if pet.stage ~= "Baby" then
		return false
	end
	if now - pet.bornAt >= Config.Growth.AdultAfterSeconds or pet.careCount >= Config.Growth.AdultAfterCare then
		pet.stage = "Adult"
		return true
	end
	return false
end

function PetRules.DisplaySpecies(pet: any): string
	local def = Config.Species[pet.species]
	if not def then
		return pet.species
	end
	return if pet.stage == "Baby" then def.Baby else def.Name
end

-- Can the cooldown-limited care action run now? Returns seconds left if not.
function PetRules.CooldownLeft(pet: any, action: string, now: number): number
	local care = Config.Care[action]
	if not care or not care.Cooldown then
		return 0
	end
	local last = pet.cooldowns[action] or 0
	return math.max(0, last + care.Cooldown - now)
end

---------------------------------------------------------------------------
-- Rarity and adoption
---------------------------------------------------------------------------

function PetRules.Rarity(species: string, look: Look): string
	local def = Config.Species[species]
	if not def then
		return "Common"
	end
	if contains(def.RareColors, look.color) or contains(def.RarePatterns, look.pattern) or contains(def.RareEyes, look.eyes) then
		return "Rare"
	end
	return "Common"
end

function PetRules.AdoptPrice(species: string, look: Look): number
	local def = Config.Species[species]
	local price = def.Price
	if PetRules.Rarity(species, look) == "Rare" then
		price *= Config.Adoption.RareMultiplier
	end
	return price
end

local function randomLook(rng: Rng.Rng, species: string, rareChance: number): Look
	local def = Config.Species[species]
	local function pick(common: { string }, rare: { string }): string
		if #rare > 0 and rng:Chance(rareChance) then
			return rng:Pick(rare)
		end
		return rng:Pick(common)
	end
	return {
		color = pick(def.Colors, def.RareColors),
		pattern = pick(def.Patterns, def.RarePatterns),
		eyes = pick(def.Eyes, def.RareEyes),
	}
end

-- The adoption centre's pets for one species. The same seed always gives
-- the same list, so the server can re-derive what the player picked.
function PetRules.AdoptionCandidates(seed: number, species: string): { any }
	local rng = Rng.new(Rng.Hash(seed, species))
	local list = {}
	for i = 1, Config.Adoption.PerSpecies do
		local look = randomLook(rng, species, if i == Config.Adoption.PerSpecies then 0.5 else 0.12)
		table.insert(list, {
			index = i,
			species = species,
			look = look,
			rarity = PetRules.Rarity(species, look),
			price = PetRules.AdoptPrice(species, look),
		})
	end
	return list
end

function PetRules.AdoptionSeed(userId: number, day: number, rerolls: number): number
	return Rng.Hash("adopt", userId, day, rerolls)
end

---------------------------------------------------------------------------
-- Breeding
---------------------------------------------------------------------------

function PetRules.CanBreed(a: any, b: any, now: number): (boolean, string?)
	if not a or not b then
		return false, "Pick two pets."
	end
	if a.id == b.id then
		return false, "Pick two different pets."
	end
	if a.species ~= b.species then
		return false, "Both parents must be the same species."
	end
	if a.gender == b.gender then
		return false, "You need a boy and a girl."
	end
	if a.stage ~= "Adult" or b.stage ~= "Adult" then
		return false, "Both parents must be grown up."
	end
	for _, p in { a, b } do
		if now - (p.lastBredAt or 0) < Config.Breeding.Cooldown then
			return false, p.name .. " needs a rest before having more babies."
		end
		if PetRules.Mood(p) < Config.Breeding.MinMood then
			return false, p.name .. " isn't happy enough right now."
		end
	end
	return true, nil
end

-- The baby's look, decided by the stored seed. Each trait comes from one of
-- the parents, with a small chance of a different (sometimes rare) trait.
function PetRules.Inherit(a: any, b: any, seed: number): Look
	local def = Config.Species[a.species]
	local rng = Rng.new(seed)
	local cfg = Config.Breeding
	local function trait(fromA: string, fromB: string, mutation: number, common: { string }, rare: { string }): string
		local roll = rng:Float()
		if roll < mutation then
			-- A third of mutations are rare traits.
			if #rare > 0 and rng:Chance(0.35) then
				return rng:Pick(rare)
			end
			return rng:Pick(common)
		end
		return if rng:Chance(0.5) then fromA else fromB
	end
	return {
		color = trait(a.color, b.color, cfg.ColorMutation, def.Colors, def.RareColors),
		pattern = trait(a.pattern, b.pattern, cfg.PatternMutation, def.Patterns, def.RarePatterns),
		eyes = trait(a.eyes, b.eyes, cfg.EyeMutation, def.Eyes, def.RareEyes),
	}
end

-- Names: trimmed, 1-20 characters, letters/numbers/spaces and a little punctuation.
function PetRules.CleanName(name: any): string?
	if typeof(name) ~= "string" then
		return nil
	end
	local trimmed = string.gsub(string.gsub(name, "^%s+", ""), "%s+$", "")
	trimmed = string.gsub(trimmed, "%s+", " ")
	if #trimmed < 1 or utf8.len(trimmed) == nil or (utf8.len(trimmed) :: number) > 20 then
		return nil
	end
	if string.find(trimmed, "[^%w %-'%.!]") then
		return nil
	end
	return trimmed
end

return PetRules
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Placement</string><ProtectedString name="Source"><![CDATA[-- Furniture placement on a room's floor grid. Pure functions shared by the
-- server (which validates every move) and the client (which tints the preview
-- green or red as you drag).
--
-- A room is Cols x Rows cells. Cell (0, 0) is the back-left corner; columns
-- run left to right (+X) and rows run back to front (+Z, toward the camera).
-- An item's (cx, cz) is the cell under its back-left corner.

local Config = require(script.Parent.Config)

local Placement = {}

Placement.Cols = Config.Room.Width // Config.Room.Cell
Placement.Rows = Config.Room.Depth // Config.Room.Cell

-- Footprint in cells after rotating by rot * 90 degrees.
function Placement.Footprint(itemId: string, rot: number): (number, number)
	local item = Config.Items[itemId]
	local w, d = item.Footprint[1], item.Footprint[2]
	if rot % 2 == 1 then
		return d, w
	end
	return w, d
end

function Placement.Layer(itemId: string): string
	return Config.Items[itemId].Layer or "Object"
end

-- Room-local stud position of an item's centre (floor level).
function Placement.CellToLocal(itemId: string, cx: number, cz: number, rot: number): (number, number)
	local w, d = Placement.Footprint(itemId, rot)
	local cell = Config.Room.Cell
	local x = -Config.Room.Width / 2 + (cx + w / 2) * cell
	local z = -Config.Room.Depth / 2 + (cz + d / 2) * cell
	return x, z
end

-- Nearest cell for an item centred at room-local (x, z), clamped into the room.
function Placement.LocalToCell(itemId: string, x: number, z: number, rot: number): (number, number)
	local w, d = Placement.Footprint(itemId, rot)
	local cell = Config.Room.Cell
	local cx = math.floor((x + Config.Room.Width / 2) / cell - w / 2 + 0.5)
	local cz = math.floor((z + Config.Room.Depth / 2) / cell - d / 2 + 0.5)
	cx = math.clamp(cx, 0, Placement.Cols - w)
	cz = math.clamp(cz, 0, Placement.Rows - d)
	return cx, cz
end

local function overlaps(ax, az, aw, ad, bx, bz, bw, bd): boolean
	return ax < bx + bw and bx < ax + aw and az < bz + bd and bz < az + ad
end

-- Checks that an item fits at (cx, cz, rot) among the room's other furniture.
-- ignoreUid skips the item being moved.
function Placement.Validate(furniture: { any }, itemId: string, cx: number, cz: number, rot: number, ignoreUid: string?): (boolean, string?)
	local item = Config.Items[itemId]
	if not item or item.Kind ~= "Furniture" then
		return false, "That item can't be placed."
	end
	if typeof(cx) ~= "number" or typeof(cz) ~= "number" or cx ~= math.floor(cx) or cz ~= math.floor(cz) then
		return false, "Invalid position."
	end
	if rot ~= 0 and rot ~= 1 and rot ~= 2 and rot ~= 3 then
		return false, "Invalid rotation."
	end
	local w, d = Placement.Footprint(itemId, rot)
	if cx < 0 or cz < 0 or cx + w > Placement.Cols or cz + d > Placement.Rows then
		return false, "It doesn't fit there."
	end
	local layer = Placement.Layer(itemId)
	for _, f in furniture do
		if f.uid ~= ignoreUid and Config.Items[f.item] and Placement.Layer(f.item) == layer then
			local fw, fd = Placement.Footprint(f.item, f.rot)
			if overlaps(cx, cz, w, d, f.cx, f.cz, fw, fd) then
				return false, "Something is already there."
			end
		end
	end
	return true, nil
end

-- First free spot, scanning from the back of the room. Returns nil if full.
function Placement.FindFreeSpot(furniture: { any }, itemId: string): (number?, number?, number?)
	for _, rot in { 0, 1 } do
		local w, d = Placement.Footprint(itemId, rot)
		for cz = 0, Placement.Rows - d do
			for cx = 0, Placement.Cols - w do
				if Placement.Validate(furniture, itemId, cx, cz, rot) then
					return cx, cz, rot
				end
			end
		end
	end
	return nil, nil, nil
end

-- Total comfort of a room's furniture (decorations keep pets happy longer).
function Placement.Comfort(furniture: { any }): number
	local total = 0
	for _, f in furniture do
		local item = Config.Items[f.item]
		if item then
			total += item.Comfort or 0
		end
	end
	return total
end

function Placement.HasRole(furniture: { any }, role: string): boolean
	for _, f in furniture do
		local item = Config.Items[f.item]
		if item and item.Role == role then
			return true
		end
	end
	return false
end

-- Nearest furniture with the given role to room-local (x, z).
function Placement.NearestWithRole(furniture: { any }, role: string, x: number, z: number): any
	local best, bestDist = nil, math.huge
	for _, f in furniture do
		local item = Config.Items[f.item]
		if item and item.Role == role then
			local fx, fz = Placement.CellToLocal(f.item, f.cx, f.cz, f.rot)
			local dist = (fx - x) ^ 2 + (fz - z) ^ 2
			if dist < bestDist then
				best, bestDist = f, dist
			end
		end
	end
	return best
end

return Placement
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Rng</string><ProtectedString name="Source"><![CDATA[-- Small deterministic random number generator (xorshift32).
-- Unlike Roblox's Random, it gives identical results everywhere (server,
-- client, tests), so adoption lists and breeding results are reproducible
-- from a stored seed.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { s: number }, Rng))

local TWO32 = 4294967296

-- FNV-1a hash of any mix of strings and numbers, as a 32-bit seed.
function Rng.Hash(...: any): number
	local h = 2166136261
	for i = 1, select("#", ...) do
		local text = tostring((select(i, ...)))
		for c = 1, #text do
			h = bit32.bxor(h, string.byte(text, c))
			-- h * 16777619 mod 2^32, split so it stays exact in a double.
			h = (bit32.lshift(h, 24) + h * 403) % TWO32
		end
		h = bit32.bxor(h, 0x2C)
	end
	return h
end

function Rng.new(seed: number): Rng
	local s = math.floor(seed) % TWO32
	if s == 0 then
		s = 0x9E3779B9
	end
	return setmetatable({ s = s }, Rng)
end

function Rng.NextInt(self: Rng): number
	local x = self.s
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.s = x
	return x
end

-- Uniform float in [0, 1).
function Rng.Float(self: Rng): number
	return self:NextInt() / TWO32
end

-- Uniform integer in [a, b].
function Rng.Range(self: Rng, a: number, b: number): number
	return a + self:NextInt() % (b - a + 1)
end

function Rng.Pick<T>(self: Rng, list: { T }): T
	return list[self:Range(1, #list)]
end

function Rng.Chance(self: Rng, p: number): boolean
	return self:Float() < p
end

return Rng
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">SaveSchema</string><ProtectedString name="Source"><![CDATA[-- The save file: its default contents, migrations between versions, and a
-- sanitizer that repairs missing or corrupted fields instead of failing.
--
-- Layout (version 1):
--   version, coins, xp, level, createdAt, lastSeen
--   nextId                    counter for pet and furniture ids
--   pets       { [petId]: Pet }            (see PetRules.NewPet)
--   inventory  { [itemId]: count }         unplaced furniture and consumables
--   rooms      { { id, wallpaper, floor, furniture = { {uid, item, cx, cz, rot} } } }
--   styles     { [styleId]: true }         bought wallpapers and floors
--   births     { { id, species, parents = {a, b}, seed, readyAt } }
--   adopt      { day, rerolls, taken = { ["Cat:2"] = true } }
--   daily      { day }                     last daily bonus claimed
--   visits     { day, count, petted = { [key] = true } }
--   settings   { sound }
--   stats      { care, adopted, bred, gifts }
--   starterDone                            first free kitten taken

local Config = require(script.Parent.Config)
local Placement = require(script.Parent.Placement)

local SaveSchema = {}

local function newRoom(def: any): any
	return { id = def.Id, wallpaper = def.Wallpaper, floor = def.Floor, furniture = {} }
end

function SaveSchema.NewRoom(def: any): any
	return newRoom(def)
end

function SaveSchema.Default(now: number): any
	local data = {
		version = Config.SaveVersion,
		coins = Config.Start.Coins,
		xp = 0,
		level = 1,
		createdAt = now,
		lastSeen = now,
		nextId = 1,
		pets = {},
		inventory = {},
		rooms = { newRoom(Config.Rooms[1]) },
		styles = {},
		births = {},
		adopt = { day = 0, rerolls = 0, taken = {} },
		daily = { day = 0 },
		visits = { day = 0, count = 0, petted = {} },
		settings = { sound = true },
		stats = { care = 0, adopted = 0, bred = 0, gifts = 0 },
		starterDone = false,
	}
	for itemId, count in Config.Start.Inventory do
		data.inventory[itemId] = count
	end
	local living = data.rooms[1]
	for _, f in Config.Start.Furniture do
		table.insert(living.furniture, { uid = "f" .. data.nextId, item = f.item, cx = f.cx, cz = f.cz, rot = f.rot })
		data.nextId += 1
	end
	return data
end

-- Migrations from version N to N + 1. Add one for every SaveVersion bump.
local MIGRATIONS: { [number]: (any) -> () } = {
	-- [1] = function(data) data.newField = ...; end,
}

local function num(v: any, default: number, min: number?, max: number?): number
	if typeof(v) ~= "number" or v ~= v then
		return default
	end
	if min then
		v = math.max(min, v)
	end
	if max then
		v = math.min(max, v)
	end
	return v
end

local function tbl(v: any): { [any]: any }
	return if typeof(v) == "table" then v else {}
end

local function sanitizePet(id: string, p: any, now: number): any?
	if typeof(p) ~= "table" or not Config.Species[p.species] then
		return nil
	end
	local def = Config.Species[p.species]
	local function pickValid(v: any, common: { string }, rare: { string }): string
		if typeof(v) == "string" and (table.find(common, v) or table.find(rare, v)) then
			return v
		end
		return common[1]
	end
	local needs = tbl(p.needs)
	local pet = {
		id = id,
		name = if typeof(p.name) == "string" and #p.name > 0 then string.sub(p.name, 1, 20) else "Pet",
		gender = if p.gender == "F" then "F" else "M",
		species = p.species,
		color = pickValid(p.color, def.Colors, def.RareColors),
		pattern = pickValid(p.pattern, def.Patterns, def.RarePatterns),
		eyes = pickValid(p.eyes, def.Eyes, def.RareEyes),
		stage = if p.stage == "Baby" then "Baby" else "Adult",
		bornAt = num(p.bornAt, now),
		careCount = num(p.careCount, 0, 0),
		room = if typeof(p.room) == "string" then p.room else "living",
		x = num(p.x, 0, -Config.Room.Width / 2, Config.Room.Width / 2),
		z = num(p.z, 0, -Config.Room.Depth / 2, Config.Room.Depth / 2),
		needs = {},
		sleeping = p.sleeping == true,
		lastBredAt = num(p.lastBredAt, 0),
		lastGiftAt = num(p.lastGiftAt, now),
		cooldowns = {},
		parents = nil,
	}
	for _, need in Config.Needs do
		pet.needs[need] = num(needs[need], 80, 0, 100)
	end
	for action, t in tbl(p.cooldowns) do
		if typeof(action) == "string" and typeof(t) == "number" then
			pet.cooldowns[action] = t
		end
	end
	if typeof(p.parents) == "table" and typeof(p.parents[1]) == "string" and typeof(p.parents[2]) == "string" then
		pet.parents = { p.parents[1], p.parents[2] }
	end
	return pet
end

-- Brings any stored value up to the current layout. Never errors: unknown or
-- broken parts are replaced with defaults. Returns the data and a list of
-- repairs made (empty for a healthy save).
function SaveSchema.Load(raw: any, now: number): (any, { string })
	local repairs = {}
	if typeof(raw) ~= "table" then
		return SaveSchema.Default(now), {}
	end
	local version = num(raw.version, 1)
	if version > Config.SaveVersion then
		-- Saved by a newer build; keep what we understand.
		table.insert(repairs, "save from newer version " .. version)
	end
	while version < Config.SaveVersion do
		local migrate = MIGRATIONS[version]
		if migrate then
			migrate(raw)
		end
		version += 1
	end

	local data = SaveSchema.Default(now)
	data.coins = math.floor(num(raw.coins, Config.Start.Coins, 0))
	data.level = math.floor(num(raw.level, 1, 1, Config.MaxLevel))
	data.xp = math.floor(num(raw.xp, 0, 0))
	data.createdAt = num(raw.createdAt, now)
	data.lastSeen = num(raw.lastSeen, now, 0, now)
	data.nextId = math.floor(num(raw.nextId, 1, 1))
	data.starterDone = raw.starterDone == true

	data.inventory = {}
	for itemId, count in tbl(raw.inventory) do
		if Config.Items[itemId] and typeof(count) == "number" and count >= 1 then
			data.inventory[itemId] = math.floor(count)
		end
	end

	-- Rooms: keep known ones in unlock order, always including the first.
	local rawRooms = tbl(raw.rooms)
	local byId = {}
	for _, r in rawRooms do
		if typeof(r) == "table" and typeof(r.id) == "string" then
			byId[r.id] = r
		end
	end
	data.rooms = {}
	local usedIds = {}
	for i, def in Config.Rooms do
		local r = byId[def.Id]
		if not r and i > 1 then
			break
		end
		local room = newRoom(def)
		if r then
			if typeof(r.wallpaper) == "string" and Config.WallpaperById(r.wallpaper) then
				room.wallpaper = r.wallpaper
			end
			if typeof(r.floor) == "string" and Config.FloorById(r.floor) then
				room.floor = r.floor
			end
			for _, f in tbl(r.furniture) do
				if typeof(f) ~= "table" or typeof(f.uid) ~= "string" or usedIds[f.uid] then
					continue
				end
				local rot = num(f.rot, 0, 0, 3)
				local cx, cz = num(f.cx, -1), num(f.cz, -1)
				if Config.Items[f.item] and Placement.Validate(room.furniture, f.item, cx, cz, rot) then
					table.insert(room.furniture, { uid = f.uid, item = f.item, cx = cx, cz = cz, rot = rot })
					usedIds[f.uid] = true
				elseif Config.Items[f.item] and Config.Items[f.item].Kind == "Furniture" then
					-- Doesn't fit any more: return it to the inventory.
					data.inventory[f.item] = (data.inventory[f.item] or 0) + 1
					table.insert(repairs, "returned " .. f.item .. " to inventory")
				end
			end
		end
		table.insert(data.rooms, room)
	end

	data.styles = {}
	for styleId, owned in tbl(raw.styles) do
		if owned == true and (Config.WallpaperById(styleId) or Config.FloorById(styleId)) then
			data.styles[styleId] = true
		end
	end

	data.pets = {}
	for id, p in tbl(raw.pets) do
		if typeof(id) == "string" then
			local pet = sanitizePet(id, p, now)
			if pet then
				local known = false
				for _, room in data.rooms do
					known = known or room.id == pet.room
				end
				if not known then
					pet.room = data.rooms[1].id
				end
				data.pets[id] = pet
			else
				table.insert(repairs, "dropped unreadable pet " .. id)
			end
		end
	end

	data.births = {}
	for _, b in tbl(raw.births) do
		if typeof(b) == "table" and Config.Species[b.species] and typeof(b.id) == "string" then
			table.insert(data.births, {
				id = b.id,
				species = b.species,
				parents = if typeof(b.parents) == "table" then { tostring(b.parents[1]), tostring(b.parents[2]) } else { "", "" },
				look = b.look,
				readyAt = num(b.readyAt, now),
			})
		end
	end
	-- The baby's look is fixed when breeding starts; drop births without one.
	for i = #data.births, 1, -1 do
		local look = data.births[i].look
		if typeof(look) ~= "table" or typeof(look.color) ~= "string" or typeof(look.pattern) ~= "string" or typeof(look.eyes) ~= "string" then
			table.remove(data.births, i)
		end
	end

	local adopt = tbl(raw.adopt)
	data.adopt = { day = num(adopt.day, 0), rerolls = num(adopt.rerolls, 0, 0), taken = {} }
	for key, v in tbl(adopt.taken) do
		if typeof(key) == "string" and v == true then
			data.adopt.taken[key] = true
		end
	end
	data.daily = { day = num(tbl(raw.daily).day, 0) }
	local visits = tbl(raw.visits)
	data.visits = { day = num(visits.day, 0), count = num(visits.count, 0, 0), petted = {} }
	for key, v in tbl(visits.petted) do
		if typeof(key) == "string" and v == true then
			data.visits.petted[key] = true
		end
	end
	data.settings = { sound = tbl(raw.settings).sound ~= false }
	local stats = tbl(raw.stats)
	data.stats = {
		care = num(stats.care, 0, 0),
		adopted = num(stats.adopted, 0, 0),
		bred = num(stats.bred, 0, 0),
		gifts = num(stats.gifts, 0, 0),
	}
	data.version = Config.SaveVersion
	return data, repairs
end

function SaveSchema.NewId(data: any, prefix: string): string
	local id = prefix .. data.nextId
	data.nextId += 1
	return id
end

return SaveSchema
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000014"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Actions</string><ProtectedString name="Source"><![CDATA[-- Every request a client can make, validated and applied on the server.
-- Each handler receives the player's session and the request payload and
-- returns { ok = boolean, msg = string?, ... }. Nothing the client sends is
-- trusted: prices, positions, ownership and cooldowns are all re-checked.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local PetRules = require(Shared:WaitForChild("PetRules"))
local Placement = require(Shared:WaitForChild("Placement"))
local SaveSchema = require(Shared:WaitForChild("SaveSchema"))
local Rng = require(Shared:WaitForChild("Rng"))

local Plots = require(script.Parent:WaitForChild("Plots"))
local PetService = require(script.Parent:WaitForChild("PetService"))
local Names = require(script.Parent:WaitForChild("Names"))

local Actions = {}

export type Session = {
	player: Player,
	data: any,
	plot: Model,
	online: boolean,
	dirty: boolean,
	busy: boolean,
}

type Result = { [string]: any }

-- Set by the main script: sends a notification table to one player.
local notify: (Player, any) -> () = function() end
-- Set by the main script: finds another player's session (for visits).
local sessionFor: (number) -> Session? = function()
	return nil
end
-- Set by the main script: rebuilds a session from a fresh save.
local resetSession: (Session) -> () = function() end

function Actions.Init(notifyFn: (Player, any) -> (), sessionFn: (number) -> Session?, resetFn: (Session) -> ())
	notify = notifyFn
	sessionFor = sessionFn
	resetSession = resetFn
end

local function fail(msg: string): Result
	return { ok = false, msg = msg }
end

local function str(v: any): string?
	return if typeof(v) == "string" and #v <= 64 then v else nil
end

local function int(v: any): number?
	if typeof(v) == "number" and v == v and v == math.floor(v) and math.abs(v) < 1e6 then
		return v
	end
	return nil
end

-- Grants XP and coins, announces level-ups, and floats the reward above a pet.
local function reward(s: Session, xp: number, coins: number, petId: string?, text: string?)
	Economy.AddCoins(s.data, coins)
	local reached, bonus = Economy.AddXP(s.data, xp)
	s.dirty = true
	notify(s.player, { kind = "reward", xp = xp, coins = coins, petId = petId, text = text })
	for _, level in reached do
		notify(s.player, { kind = "levelup", level = level, coins = Config.LevelReward(level), unlocks = Economy.UnlocksAt(level) })
	end
	if bonus > 0 then
		s.dirty = true
	end
end

local function getPet(s: Session, petId: any): any
	local id = str(petId)
	return id and s.data.pets[id]
end

local function randomSpot(): (number, number)
	return math.random(-10, 10), math.random(-5, 6)
end

local function today(): number
	return Economy.DayIndex(os.time())
end

local function refreshAdoptDay(data: any)
	if data.adopt.day ~= today() then
		data.adopt = { day = today(), rerolls = 0, taken = {} }
	end
end

local function adoptionSeed(s: Session): number
	return PetRules.AdoptionSeed(s.player.UserId, s.data.adopt.day, s.data.adopt.rerolls)
end

---------------------------------------------------------------------------
-- Adoption
---------------------------------------------------------------------------

function Actions.GetAdoption(s: Session, _payload: any): Result
	refreshAdoptDay(s.data)
	local seed = adoptionSeed(s)
	local list = {}
	for _, species in Config.SpeciesOrder do
		local def = Config.Species[species]
		local candidates = PetRules.AdoptionCandidates(seed, species)
		for _, c in candidates do
			c.taken = s.data.adopt.taken[species .. ":" .. c.index] == true
		end
		table.insert(list, { species = species, level = def.Level, unlocked = s.data.level >= def.Level, candidates = candidates })
	end
	return { ok = true, species = list, starter = not s.data.starterDone, rerollCost = Config.Adoption.RerollCost }
end

function Actions.RerollAdoption(s: Session, _payload: any): Result
	refreshAdoptDay(s.data)
	if not Economy.Spend(s.data, Config.Adoption.RerollCost) then
		return fail("You need " .. Config.Adoption.RerollCost .. " coins to see new pets.")
	end
	s.data.adopt.rerolls += 1
	s.data.adopt.taken = {}
	s.dirty = true
	return Actions.GetAdoption(s, nil)
end

local function placeNewPet(s: Session, pet: any)
	local x, z = randomSpot()
	pet.x, pet.z = x, z
	s.data.pets[pet.id] = pet
	PetService.Spawn(s.plot, pet)
	PetService.UpdateSleep(s.plot, s.data, pet)
	s.dirty = true
end

function Actions.Adopt(s: Session, payload: any): Result
	refreshAdoptDay(s.data)
	local species = str(payload.species)
	local index = int(payload.index)
	local def = species and Config.Species[species]
	if not def or not index then
		return fail("That pet isn't available.")
	end
	if s.data.level < def.Level then
		return fail(def.Name .. "s unlock at level " .. def.Level .. ".")
	end
	local gender = payload.gender
	if gender ~= "M" and gender ~= "F" then
		return fail("Choose boy or girl.")
	end
	local candidate = PetRules.AdoptionCandidates(adoptionSeed(s), species)[index]
	local takenKey = species .. ":" .. index
	if not candidate or s.data.adopt.taken[takenKey] then
		return fail("Someone already adopted that pet. Pick another!")
	end
	local room = Economy.RoomWithSpace(s.data)
	if not room then
		return fail("Your home is full! Unlock another room to make space.")
	end
	local free = not s.data.starterDone and species == "Cat"
	local price = if free then 0 else candidate.price
	if not Economy.CanAfford(s.data, price) then
		return fail("You need " .. price .. " coins to adopt this pet.")
	end
	-- Filtering yields; re-check money afterwards in case it changed.
	local name, err = Names.Filter(s.player, payload.name)
	if not name then
		return fail(err or "Invalid name.")
	end
	if not Economy.Spend(s.data, price) then
		return fail("You need " .. price .. " coins to adopt this pet.")
	end
	local pet = PetRules.NewPet(SaveSchema.NewId(s.data, "p"), species, candidate.look, name, gender, "Adult", os.time(), room)
	s.data.adopt.taken[takenKey] = true
	s.data.starterDone = true
	s.data.stats.adopted += 1
	placeNewPet(s, pet)
	PetService.StartAction(s.plot, s.data, pet, "Pet", 3)
	reward(s, Config.Adoption.XP, 0, pet.id, "Welcome home, " .. name .. "!")
	return { ok = true, petId = pet.id, room = room }
end

---------------------------------------------------------------------------
-- Pet care
---------------------------------------------------------------------------

local ITEM_ACTION_ANIM = { Feed = "Eat", Treat = "Treat", Bath = "Bath", Medicine = "Medicine" }

local function careDone(s: Session, pet: any)
	pet.careCount += 1
	s.data.stats.care += 1
	if PetRules.Grow(pet, os.time()) then
		PetService.Spawn(s.plot, pet)
		notify(s.player, { kind = "toast", text = pet.name .. " has grown up! 🎉" })
	end
	PetService.UpdateAttributes(s.plot, pet)
	s.dirty = true
end

local function isBusy(s: Session, pet: any): boolean
	local model = PetService.Find(s.plot, pet.id)
	return model ~= nil and (model:GetAttribute("ActionEnd") :: number) > workspace:GetServerTimeNow()
end

function Actions.Care(s: Session, payload: any): Result
	local pet = getPet(s, payload.petId)
	if not pet then
		return fail("That pet isn't here.")
	end
	local action = str(payload.action)
	local now = os.time()

	if action == "Wake" then
		if not pet.sleeping then
			return fail(pet.name .. " is already awake.")
		end
		pet.sleeping = false
		PetService.UpdateSleep(s.plot, s.data, pet)
		s.dirty = true
		return { ok = true }
	end

	if action == "Sleep" then
		if pet.sleeping then
			return fail(pet.name .. " is already asleep.")
		end
		if pet.needs.Energy >= 90 then
			return fail(pet.name .. " isn't sleepy yet.")
		end
		pet.sleeping = true
		PetService.UpdateSleep(s.plot, s.data, pet)
		s.dirty = true
		return { ok = true }
	end

	if pet.sleeping and action ~= "Pet" then
		return fail(pet.name .. " is asleep. Wake them up first, or let them rest.")
	end

	if action == "Pet" then
		local left = PetRules.CooldownLeft(pet, "Pet", now)
		if not pet.sleeping then
			PetService.StartAction(s.plot, s.data, pet, "Pet", Config.Care.Pet.Duration)
		end
		if left > 0 then
			-- Still a happy reaction, just no reward until the cooldown passes.
			return { ok = true, noReward = true }
		end
		pet.cooldowns.Pet = now
		PetRules.ApplyEffects(pet, Config.Care.Pet.Effects)
		careDone(s, pet)
		reward(s, Config.Care.Pet.XP, Config.Care.Pet.Coins, pet.id)
		return { ok = true }
	end

	if isBusy(s, pet) then
		return fail(pet.name .. " is busy right now.")
	end

	if action == "Play" or action == "Brush" then
		local care = Config.Care[action]
		local left = PetRules.CooldownLeft(pet, action, now)
		if left > 0 then
			return fail(string.format("%s needs a little break first (%ds).", pet.name, math.ceil(left)))
		end
		if action == "Play" then
			if pet.needs.Energy < care.MinEnergy then
				return fail(pet.name .. " is too tired to play. Let them sleep!")
			end
			local room = Economy.GetRoom(s.data, pet.room)
			if not room or not Placement.HasRole(room.furniture, "Toy") then
				return fail("Put a toy in this room so " .. pet.name .. " can play!")
			end
		end
		pet.cooldowns[action] = now
		PetRules.ApplyEffects(pet, care.Effects)
		PetService.StartAction(s.plot, s.data, pet, action, care.Duration, if action == "Play" then "Toy" else nil)
		careDone(s, pet)
		reward(s, care.XP, care.Coins, pet.id)
		return { ok = true }
	end

	if action == "UseItem" then
		local itemId = str(payload.itemId)
		local item = itemId and Config.Items[itemId]
		if not item or item.Kind ~= "Consumable" then
			return fail("You can't use that on a pet.")
		end
		if Economy.InventoryCount(s.data, itemId :: string) < 1 then
			return fail("You don't have any " .. item.Name .. ". Buy some in the shop!")
		end
		local n = pet.needs
		if item.Action == "Feed" and n.Food >= 95 then
			return fail(pet.name .. " isn't hungry right now.")
		elseif item.Action == "Bath" and n.Clean >= 95 then
			return fail(pet.name .. " is already squeaky clean.")
		elseif item.Action == "Medicine" and n.Health >= 95 then
			return fail(pet.name .. " is perfectly healthy.")
		elseif item.Action == "Treat" then
			local full = true
			for need, amount in item.Effects do
				if amount > 0 and n[need] < 95 then
					full = false
				end
			end
			if full then
				return fail(pet.name .. " doesn't need that right now.")
			end
		end
		Economy.TakeItem(s.data, itemId :: string, 1)
		PetRules.ApplyEffects(pet, item.Effects)
		local text = nil
		local def = Config.Species[pet.species]
		if item.Action == "Feed" and def.Favorite == itemId then
			PetRules.ApplyEffects(pet, { Fun = Config.Care.FavoriteFun })
			text = "Yum! My favourite!"
		end
		PetService.StartAction(s.plot, s.data, pet, ITEM_ACTION_ANIM[item.Action] or "Treat", Config.Care.Item.Duration, if item.Action == "Feed" then "Bowl" else nil)
		careDone(s, pet)
		reward(s, Config.Care.Item.XP, Config.Care.Item.Coins, pet.id, text)
		return { ok = true }
	end

	return fail("Unknown action.")
end

function Actions.CollectGift(s: Session, payload: any): Result
	local pet = getPet(s, payload.petId)
	if not pet then
		return fail("That pet isn't here.")
	end
	local now = os.time()
	if now - pet.lastGiftAt < Config.Gift.Interval or PetRules.Mood(pet) < Config.Gift.MinMood then
		return fail("No gift yet. Happy pets leave gifts every few minutes!")
	end
	pet.lastGiftAt = now
	s.data.stats.gifts += 1
	local model = PetService.Find(s.plot, pet.id)
	if model then
		model:SetAttribute("Gift", false)
	end
	reward(s, Config.Gift.XP, Economy.GiftCoins(s.data), pet.id, "A gift from " .. pet.name .. "!")
	return { ok = true }
end

function Actions.Rename(s: Session, payload: any): Result
	local pet = getPet(s, payload.petId)
	if not pet then
		return fail("That pet isn't here.")
	end
	local name, err = Names.Filter(s.player, payload.name)
	if not name then
		return fail(err or "Invalid name.")
	end
	pet.name = name
	PetService.UpdateAttributes(s.plot, pet)
	s.dirty = true
	return { ok = true, name = name }
end

function Actions.MovePet(s: Session, payload: any): Result
	local pet = getPet(s, payload.petId)
	local roomId = str(payload.roomId)
	if not pet or not roomId then
		return fail("That pet isn't here.")
	end
	local def = Config.RoomById(roomId)
	if not def or not Economy.HasRoom(s.data, roomId) then
		return fail("You haven't unlocked that room yet.")
	end
	if pet.room == roomId then
		return fail(pet.name .. " is already in the " .. def.Name .. ".")
	end
	if Economy.PetsInRoom(s.data, roomId) >= def.Capacity then
		return fail("The " .. def.Name .. " is full (" .. def.Capacity .. " pets).")
	end
	pet.room = roomId
	pet.x, pet.z = randomSpot()
	PetService.Relocate(s.plot, pet)
	PetService.UpdateSleep(s.plot, s.data, pet)
	s.dirty = true
	return { ok = true }
end

---------------------------------------------------------------------------
-- Shop
---------------------------------------------------------------------------

function Actions.Buy(s: Session, payload: any): Result
	local itemId = str(payload.itemId)
	local qty = if payload.qty == nil then 1 else int(payload.qty)
	local item = itemId and Config.Items[itemId]
	if not item then
		return fail("That item isn't for sale.")
	end
	if not qty or qty < 1 or qty > 10 then
		return fail("You can buy 1 to 10 at a time.")
	end
	if s.data.level < item.Level then
		return fail(item.Name .. " unlocks at level " .. item.Level .. ".")
	end
	local cost = item.Price * qty
	if not Economy.Spend(s.data, cost) then
		return fail("You need " .. cost .. " coins for that.")
	end
	Economy.AddItem(s.data, itemId :: string, qty)
	reward(s, math.max(1, cost // 20), 0, nil, nil)
	return { ok = true, itemId = itemId, count = Economy.InventoryCount(s.data, itemId :: string) }
end

function Actions.BuyStyle(s: Session, payload: any): Result
	local kind = payload.kind
	local styleId = str(payload.styleId)
	local def = if kind == "Wallpaper" and styleId then Config.WallpaperById(styleId) elseif kind == "Floor" and styleId then Config.FloorById(styleId) else nil
	if not def then
		return fail("That style isn't for sale.")
	end
	if Economy.OwnsStyle(s.data, kind, styleId :: string) then
		return fail("You already own " .. def.Name .. ".")
	end
	if s.data.level < def.Level then
		return fail(def.Name .. " unlocks at level " .. def.Level .. ".")
	end
	if not Economy.Spend(s.data, def.Price) then
		return fail("You need " .. def.Price .. " coins for that.")
	end
	s.data.styles[styleId :: string] = true
	reward(s, math.max(1, def.Price // 20), 0, nil, nil)
	return { ok = true }
end

function Actions.SetStyle(s: Session, payload: any): Result
	local kind = payload.kind
	local roomId = str(payload.roomId)
	local styleId = str(payload.styleId)
	local room = roomId and Economy.GetRoom(s.data, roomId)
	if not room or not styleId or (kind ~= "Wallpaper" and kind ~= "Floor") then
		return fail("You can't decorate that room.")
	end
	if not Economy.OwnsStyle(s.data, kind, styleId) then
		return fail("Buy that style in the shop first.")
	end
	if kind == "Wallpaper" then
		room.wallpaper = styleId
	else
		room.floor = styleId
	end
	Plots.RefreshRoom(s.plot, s.data, room.id)
	s.dirty = true
	return { ok = true }
end

function Actions.UnlockRoom(s: Session, payload: any): Result
	local roomId = str(payload.roomId)
	local nextRoom = Economy.NextRoom(s.data)
	if not nextRoom or nextRoom.Id ~= roomId then
		return fail("Unlock the rooms in order.")
	end
	if s.data.level < nextRoom.Level then
		return fail(nextRoom.Name .. " unlocks at level " .. nextRoom.Level .. ".")
	end
	if not Economy.Spend(s.data, nextRoom.Price) then
		return fail("You need " .. nextRoom.Price .. " coins to open the " .. nextRoom.Name .. ".")
	end
	table.insert(s.data.rooms, SaveSchema.NewRoom(nextRoom))
	Plots.RefreshRoom(s.plot, s.data, nextRoom.Id)
	reward(s, 50, 0, nil, nextRoom.Name .. " unlocked!")
	return { ok = true }
end

---------------------------------------------------------------------------
-- Decorating
---------------------------------------------------------------------------

local function findFurniture(data: any, uid: string): (any, any, number?)
	for _, room in data.rooms do
		for i, f in room.furniture do
			if f.uid == uid then
				return f, room, i
			end
		end
	end
	return nil, nil, nil
end

function Actions.Place(s: Session, payload: any): Result
	local itemId = str(payload.itemId)
	local roomId = str(payload.roomId)
	local cx, cz, rot = int(payload.cx), int(payload.cz), int(payload.rot)
	local room = roomId and Economy.GetRoom(s.data, roomId)
	if not itemId or not room or not cx or not cz or not rot then
		return fail("You can't place that there.")
	end
	if Economy.InventoryCount(s.data, itemId) < 1 then
		return fail("You don't have that item.")
	end
	local ok, why = Placement.Validate(room.furniture, itemId, cx, cz, rot)
	if not ok then
		return fail(why or "It doesn't fit there.")
	end
	Economy.TakeItem(s.data, itemId, 1)
	local uid = SaveSchema.NewId(s.data, "f")
	table.insert(room.furniture, { uid = uid, item = itemId, cx = cx, cz = cz, rot = rot })
	Plots.SyncFurniture(s.plot, room)
	s.dirty = true
	return { ok = true, uid = uid }
end

function Actions.MoveFurniture(s: Session, payload: any): Result
	local uid = str(payload.uid)
	local roomId = str(payload.roomId)
	local cx, cz, rot = int(payload.cx), int(payload.cz), int(payload.rot)
	local target = roomId and Economy.GetRoom(s.data, roomId)
	if not uid or not target or not cx or not cz or not rot then
		return fail("You can't move that there.")
	end
	local f, fromRoom, index = findFurniture(s.data, uid)
	if not f then
		return fail("That furniture isn't in your home.")
	end
	local ok, why = Placement.Validate(target.furniture, f.item, cx, cz, rot, uid)
	if not ok then
		return fail(why or "It doesn't fit there.")
	end
	f.cx, f.cz, f.rot = cx, cz, rot
	if fromRoom ~= target then
		table.remove(fromRoom.furniture, index :: number)
		table.insert(target.furniture, f)
		Plots.SyncFurniture(s.plot, fromRoom)
	end
	Plots.SyncFurniture(s.plot, target)
	s.dirty = true
	return { ok = true }
end

function Actions.StoreFurniture(s: Session, payload: any): Result
	local uid = str(payload.uid)
	local f, room, index = findFurniture(s.data, uid or "")
	if not f then
		return fail("That furniture isn't in your home.")
	end
	table.remove(room.furniture, index :: number)
	Economy.AddItem(s.data, f.item, 1)
	Plots.SyncFurniture(s.plot, room)
	-- Pets sleeping on it look for another bed.
	for _, pet in s.data.pets do
		if pet.sleeping and pet.room == room.id then
			PetService.UpdateSleep(s.plot, s.data, pet)
		end
	end
	s.dirty = true
	return { ok = true }
end

---------------------------------------------------------------------------
-- Breeding
---------------------------------------------------------------------------

function Actions.Breed(s: Session, payload: any): Result
	local a, b = getPet(s, payload.a), getPet(s, payload.b)
	local now = os.time()
	local ok, why = PetRules.CanBreed(a, b, now)
	if not ok then
		return fail(why or "They can't have babies right now.")
	end
	if #s.data.births >= Config.Breeding.MaxPending then
		return fail("You already have " .. Config.Breeding.MaxPending .. " babies on the way!")
	end
	if Economy.PetCount(s.data) + #s.data.births >= Economy.PetCapacity(s.data) then
		return fail("There's no room for a baby. Unlock another room first.")
	end
	if not Economy.Spend(s.data, Config.Breeding.Cost) then
		return fail("Breeding costs " .. Config.Breeding.Cost .. " coins.")
	end
	local seed = Rng.Hash(s.player.UserId, a.id, b.id, now, s.data.nextId)
	local birth = {
		id = SaveSchema.NewId(s.data, "b"),
		species = a.species,
		parents = { a.id, b.id },
		look = PetRules.Inherit(a, b, seed),
		readyAt = now + Config.Breeding.Duration,
	}
	table.insert(s.data.births, birth)
	a.lastBredAt, b.lastBredAt = now, now
	for _, p in { a, b } do
		PetService.StartAction(s.plot, s.data, p, "Love", 4)
	end
	s.data.stats.bred += 1
	reward(s, Config.Breeding.XP, 0, a.id, "A baby is on the way! 💕")
	return { ok = true, birthId = birth.id, readyAt = birth.readyAt }
end

function Actions.ClaimBirth(s: Session, payload: any): Result
	local id = str(payload.birthId)
	local index = nil
	for i, b in s.data.births do
		if b.id == id then
			index = i
		end
	end
	if not index then
		return fail("That baby isn't here.")
	end
	local birth = s.data.births[index]
	if os.time() < birth.readyAt then
		return fail("The baby isn't ready yet.")
	end
	local gender = payload.gender
	if gender ~= "M" and gender ~= "F" then
		return fail("Choose boy or girl.")
	end
	local room = Economy.RoomWithSpace(s.data, s.data.pets[birth.parents[1]] and s.data.pets[birth.parents[1]].room)
	if not room then
		return fail("Your home is full! Unlock another room to make space.")
	end
	local name, err = Names.Filter(s.player, payload.name)
	if not name then
		return fail(err or "Invalid name.")
	end
	-- Re-find: the list may have changed while the name was being filtered.
	index = table.find(s.data.births, birth)
	if not index then
		return fail("That baby isn't here.")
	end
	table.remove(s.data.births, index)
	local pet = PetRules.NewPet(SaveSchema.NewId(s.data, "p"), birth.species, birth.look, name, gender, "Baby", os.time(), room)
	pet.parents = { birth.parents[1], birth.parents[2] }
	placeNewPet(s, pet)
	PetService.StartAction(s.plot, s.data, pet, "Pet", 3)
	reward(s, 20, 0, pet.id, "Say hello to " .. name .. "!")
	return { ok = true, petId = pet.id, room = room }
end

---------------------------------------------------------------------------
-- Daily bonus, visiting, settings, reset
---------------------------------------------------------------------------

function Actions.ClaimDaily(s: Session, _payload: any): Result
	if s.data.daily.day == today() then
		return fail("You've already collected today's bonus. Come back tomorrow!")
	end
	s.data.daily.day = today()
	reward(s, Config.Daily.XP, Economy.DailyCoins(s.data), nil, "Daily bonus!")
	return { ok = true }
end

function Actions.VisitPet(s: Session, payload: any): Result
	local ownerId = int(payload.ownerId)
	local petId = str(payload.petId)
	if not ownerId or not petId or ownerId == s.player.UserId then
		return fail("You can't visit that pet.")
	end
	local owner = sessionFor(ownerId)
	local pet = owner and owner.data.pets[petId]
	if not owner or not pet then
		return fail("That pet isn't around any more.")
	end
	if pet.sleeping then
		return fail(pet.name .. " is asleep. Shh!")
	end
	local visits = s.data.visits
	if visits.day ~= today() then
		s.data.visits = { day = today(), count = 0, petted = {} }
		visits = s.data.visits
	end
	PetService.StartAction(owner.plot, owner.data, pet, "Pet", Config.Care.Pet.Duration)
	local key = ownerId .. ":" .. petId
	if visits.petted[key] or visits.count >= Config.Visit.PerDay then
		return { ok = true, noReward = true }
	end
	visits.petted[key] = true
	visits.count += 1
	PetRules.ApplyEffects(pet, { Fun = Config.Visit.Fun })
	PetService.UpdateAttributes(owner.plot, pet)
	owner.dirty = true
	reward(s, Config.Visit.XP, Config.Visit.Coins, pet.id, "You made " .. pet.name .. " happy!")
	notify(owner.player, { kind = "toast", text = s.player.DisplayName .. " petted " .. pet.name .. "! 💕" })
	return { ok = true }
end

function Actions.SetSetting(s: Session, payload: any): Result
	if payload.key == "sound" and typeof(payload.value) == "boolean" then
		s.data.settings.sound = payload.value
		s.dirty = true
		return { ok = true }
	end
	return fail("Unknown setting.")
end

function Actions.ResetSave(s: Session, payload: any): Result
	if payload.confirm ~= "RESET" then
		return fail("Reset not confirmed.")
	end
	resetSession(s)
	return { ok = true }
end

return Actions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Loading and saving player data with a DataStore.
--
-- If DataStores are unavailable (Studio without "Enable Studio Access to API
-- Services", or an unpublished place) the game still runs with a fresh save
-- that isn't kept, and the client shows "Not saving".
--
-- A light session lock stops two servers from writing the same save at once
-- when a player hops between servers quickly.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local SaveSchema = require(Shared:WaitForChild("SaveSchema"))

local DataService = {}

local LOCK_SECONDS = 90

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[HappyPets] DataStores unavailable, progress won't be saved:", result)
	end
end

local function key(userId: number): string
	return "player_" .. userId
end

local function retry<T>(attempts: number, fn: () -> T): (boolean, T | string)
	local lastErr: any = nil
	for i = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if i < attempts then
			task.wait(1.5 * i)
		end
	end
	return false, tostring(lastErr)
end

-- Returns the player's data and whether it will be saved.
function DataService.Load(player: Player): (any, boolean)
	local now = os.time()
	if not store then
		return SaveSchema.Default(now), false
	end
	local raw: any = nil
	local jobId = game.JobId
	-- Claim the save. If another server holds a fresh lock, wait for it to
	-- finish saving (it releases on leave) before taking over.
	for attempt = 1, 6 do
		local blocked = false
		local ok, err = retry(3, function()
			return (store :: DataStore):UpdateAsync(key(player.UserId), function(old)
				if typeof(old) == "table" and typeof(old.session) == "table" then
					local s = old.session
					if s.job ~= jobId and typeof(s.at) == "number" and os.time() - s.at < LOCK_SECONDS and attempt < 6 then
						blocked = true
						raw = old
						return nil
					end
				end
				raw = old
				if typeof(old) == "table" then
					old.session = { job = jobId, at = os.time() }
					return old
				end
				return nil
			end)
		end)
		if not ok then
			warn("[HappyPets] Couldn't load data for", player.Name, err)
			return SaveSchema.Default(now), false
		end
		if not blocked then
			break
		end
		task.wait(5)
		if not player.Parent then
			return SaveSchema.Default(now), false
		end
	end
	local data, repairs = SaveSchema.Load(raw, now)
	if #repairs > 0 then
		warn("[HappyPets] Repaired save for", player.Name, table.concat(repairs, "; "))
	end
	return data, true
end

-- Writes the data. `release` drops the session lock (on leave).
function DataService.Save(player: Player, data: any, release: boolean): boolean
	if not store then
		return false
	end
	data.lastSeen = os.time()
	local jobId = game.JobId
	local ok, err = retry(3, function()
		return (store :: DataStore):UpdateAsync(key(player.UserId), function(old)
			-- Another server took over (we lost the lock): don't overwrite it.
			if typeof(old) == "table" and typeof(old.session) == "table" and old.session.job ~= jobId and os.time() - (old.session.at or 0) < LOCK_SECONDS then
				return nil
			end
			local copy = table.clone(data)
			copy.session = if release then nil else { job = jobId, at = os.time() }
			return copy
		end)
	end)
	if not ok then
		warn("[HappyPets] Save failed for", player.Name, err)
	end
	return ok
end

-- Deletes the save (used by "Reset save").
function DataService.Reset(player: Player): boolean
	if not store then
		return true
	end
	local ok = retry(3, function()
		return (store :: DataStore):RemoveAsync(key(player.UserId))
	end)
	return ok
end

function DataService.Available(): boolean
	return store ~= nil
end

return DataService
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000010"><Properties><string name="Name">HappyPetsServer</string><ProtectedString name="Source"><![CDATA[-- Happy Pets: main server script.
-- Loads each player's save, builds their home and pets, runs the needs
-- simulation, answers requests from the client and autosaves.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local SaveSchema = require(Shared:WaitForChild("SaveSchema"))
local PetRules = require(Shared:WaitForChild("PetRules"))

-- Networking objects must exist before the client looks for them.
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local requestRemote = Instance.new("RemoteFunction")
requestRemote.Name = "Request"
requestRemote.Parent = remotes
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

local Plots = require(script.Parent:WaitForChild("Plots"))
local PetService = require(script.Parent:WaitForChild("PetService"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local Actions = require(script.Parent:WaitForChild("Actions"))

-- No avatars: the game is played with the mouse or touch from a fixed camera.
Players.CharacterAutoLoads = false

-- Soft, sunny lighting.
Lighting.ClockTime = 14.5
Lighting.Brightness = 2.2
Lighting.Ambient = Color3.fromRGB(150, 140, 150)
Lighting.OutdoorAmbient = Color3.fromRGB(170, 165, 175)
Lighting.EnvironmentDiffuseScale = 0.5
Lighting.EnvironmentSpecularScale = 0.3
Lighting.GlobalShadows = true
do
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.12
	cc.Contrast = 0.05
	cc.TintColor = Color3.fromRGB(255, 250, 245)
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.4
	bloom.Size = 20
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = false
	sky.Parent = Lighting
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.25
	atmo.Color = Color3.fromRGB(220, 230, 255)
	atmo.Decay = Color3.fromRGB(250, 220, 230)
	atmo.Haze = 1
	atmo.Parent = Lighting
end

Plots.Init()

type Session = Actions.Session & { lastTick: number, lastSave: number, lastRequest: number, saving: boolean, profileSent: string? }

local sessions: { [Player]: Session } = {}

local function sessionByUserId(userId: number): Session?
	for player, s in sessions do
		if player.UserId == userId then
			return s
		end
	end
	return nil
end

local function notify(player: Player, message: any)
	if player.Parent then
		notifyRemote:FireClient(player, message)
	end
end

-- What the client sees of its own save. Everything except visit bookkeeping.
local function clientView(s: Session): string
	local d = s.data
	return HttpService:JSONEncode({
		coins = d.coins,
		xp = d.xp,
		level = d.level,
		xpNext = Config.XPToNext(d.level),
		pets = d.pets,
		inventory = d.inventory,
		rooms = d.rooms,
		styles = d.styles,
		births = d.births,
		settings = d.settings,
		stats = d.stats,
		starterDone = d.starterDone,
		dailyReady = d.daily.day ~= Economy.DayIndex(os.time()),
		capacity = Economy.PetCapacity(d),
		petCount = Economy.PetCount(d),
		online = s.online,
		plot = s.plot.Name,
	})
end

local function pushProfile(s: Session)
	local json = clientView(s)
	if json ~= s.profileSent then
		s.profileSent = json
		s.player:SetAttribute("Profile", json)
	end
	s.player:SetAttribute("Coins", s.data.coins)
	s.player:SetAttribute("Level", s.data.level)
end

local function save(s: Session, release: boolean)
	if not s.online then
		s.player:SetAttribute("SaveStatus", "Offline")
		return
	end
	if s.saving and not release then
		return
	end
	s.saving = true
	s.player:SetAttribute("SaveStatus", "Saving")
	local ok = DataService.Save(s.player, s.data, release)
	s.saving = false
	s.lastSave = os.clock()
	if s.player.Parent then
		s.player:SetAttribute("SaveStatus", if ok then "Saved" else "Error")
	end
end

-- Simulates the time a player was away (capped) before their pets appear.
local function catchUp(s: Session)
	local now = os.time()
	local away = math.clamp(now - s.data.lastSeen, 0, Config.MaxOfflineHours * 3600)
	if away > 0 then
		for _, pet in s.data.pets do
			PetRules.Simulate(pet, away, PetService.RoomEnv(s.data, pet.room))
			PetRules.Grow(pet, now)
		end
	end
	s.data.lastSeen = now
	s.lastTick = now
end

local function resetSession(s: any)
	(s.plot:FindFirstChild("Pets") :: Folder):ClearAllChildren()
	DataService.Reset(s.player)
	s.data = SaveSchema.Default(os.time())
	Plots.Rebuild(s.plot, s.data)
	s.dirty = true
	pushProfile(s)
	save(s, false)
	notify(s.player, { kind = "reset" })
end

Actions.Init(notify, sessionByUserId, resetSession)

local function onPlayerAdded(player: Player)
	player:SetAttribute("SaveStatus", "Loading")
	local data, online = DataService.Load(player)
	if not player.Parent then
		if online then
			DataService.Save(player, data, true)
		end
		return
	end
	local s: Session = {
		player = player,
		data = data,
		plot = nil :: any,
		online = online,
		dirty = false,
		busy = false,
		lastTick = os.time(),
		lastSave = os.clock(),
		lastRequest = 0,
		saving = false,
		profileSent = nil,
	}
	catchUp(s)
	s.plot = Plots.Create(player, data)
	PetService.SpawnAll(s.plot, data)
	sessions[player] = s
	player:SetAttribute("Plot", s.plot.Name)
	player:SetAttribute("SaveStatus", if online then "Saved" else "Offline")
	pushProfile(s)
	if online then
		task.spawn(save, s, false)
	end
end

local function onPlayerRemoving(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	sessions[player] = nil
	save(s, true)
	Plots.Destroy(s.plot)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	local pending = 0
	for player, s in sessions do
		pending += 1
		task.spawn(function()
			save(s, true)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end)

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------

local HANDLERS = {
	GetAdoption = Actions.GetAdoption,
	RerollAdoption = Actions.RerollAdoption,
	Adopt = Actions.Adopt,
	Care = Actions.Care,
	CollectGift = Actions.CollectGift,
	Rename = Actions.Rename,
	MovePet = Actions.MovePet,
	Buy = Actions.Buy,
	BuyStyle = Actions.BuyStyle,
	SetStyle = Actions.SetStyle,
	UnlockRoom = Actions.UnlockRoom,
	Place = Actions.Place,
	MoveFurniture = Actions.MoveFurniture,
	StoreFurniture = Actions.StoreFurniture,
	Breed = Actions.Breed,
	ClaimBirth = Actions.ClaimBirth,
	ClaimDaily = Actions.ClaimDaily,
	VisitPet = Actions.VisitPet,
	SetSetting = Actions.SetSetting,
	ResetSave = Actions.ResetSave,
}

requestRemote.OnServerInvoke = function(player: Player, name: any, payload: any)
	local s = sessions[player]
	if not s then
		return { ok = false, msg = "Still loading your home..." }
	end
	local handler = typeof(name) == "string" and HANDLERS[name]
	if not handler then
		return { ok = false, msg = "Unknown request." }
	end
	if typeof(payload) ~= "table" then
		payload = {}
	end
	-- One request at a time per player stops double purchases.
	if s.busy or os.clock() - s.lastRequest < 0.08 then
		return { ok = false, msg = "One moment..." }
	end
	s.busy = true
	s.lastRequest = os.clock()
	local ok, result = pcall(handler, s, payload)
	s.busy = false
	if not ok then
		warn("[HappyPets] Request", name, "failed:", result)
		return { ok = false, msg = "Something went wrong. Please try again." }
	end
	if s.dirty then
		pushProfile(s)
	end
	return result
end

---------------------------------------------------------------------------
-- Simulation and autosave
---------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(Config.TickSeconds)
		local now = os.time()
		for _, s in sessions do
			local dt = now - s.lastTick
			if dt > 0 then
				s.lastTick = now
				s.data.lastSeen = now
				PetService.Tick(s.plot, s.data, dt, now)
				s.dirty = true
			end
			if s.dirty then
				s.dirty = false
				pushProfile(s)
			end
			if s.online and not s.saving and os.clock() - s.lastSave >= Config.AutosaveSeconds then
				task.spawn(save, s, false)
			end
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Names</string><ProtectedString name="Source"><![CDATA[-- Pet names are visible to visitors, so Roblox requires them to go through
-- the text filter before they're shown.

local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetRules = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetRules"))

local Names = {}

-- Returns the filtered name, or nil and a message for the player.
function Names.Filter(player: Player, raw: any): (string?, string?)
	local clean = PetRules.CleanName(raw)
	if not clean then
		return nil, "Names need 1-20 letters or numbers."
	end
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(clean, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return nil, "Couldn't check that name right now. Please try again."
	end
	if string.find(result, "#") then
		return nil, "That name isn't allowed. Try another!"
	end
	return result, nil
end

return Names
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[-- Pet models in the world and their replicated state.
--
-- The server owns each pet's data (needs, room, sleeping) and builds one
-- model per pet in its plot's Pets folder. The model's attributes tell every
-- client what the pet is doing:
--   PetId, Owner, Name, Species, Gender, Stage, Room, Mood, Sleeping,
--   Gift (a coin gift is waiting), Low (the need that wants attention),
--   Action ("Eat", "Play", "Pet", "Bath", "Brush", "Treat", "Medicine", "Sleep")
--   ActionTarget (furniture uid to walk to), ActionEnd (server time),
--   ActionId (increments so repeated actions retrigger)
-- Clients animate the walking, wandering and reactions locally.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetRules = require(Shared:WaitForChild("PetRules"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local Placement = require(Shared:WaitForChild("Placement"))
local Economy = require(Shared:WaitForChild("Economy"))

local Plots = require(script.Parent:WaitForChild("Plots"))

local PetService = {}

local function lookKey(pet: any): string
	return table.concat({ pet.species, pet.color, pet.pattern, pet.eyes, pet.stage }, "|")
end

function PetService.Find(plot: Model, petId: string): Model?
	return (plot:FindFirstChild("Pets") :: Folder):FindFirstChild(petId) :: Model?
end

-- Room environment used by the needs simulation.
function PetService.RoomEnv(data: any, roomId: string): PetRules.Env
	local room = Economy.GetRoom(data, roomId)
	local furniture = if room then room.furniture else {}
	return {
		comfort = Placement.Comfort(furniture),
		litter = Placement.HasRole(furniture, "Litter"),
		hasBed = Placement.HasRole(furniture, "Bed"),
	}
end

local function roomFloorCFrame(plot: Model, roomId: string): CFrame
	local _, order = Config.RoomById(roomId)
	return Plots.RoomCFrame(plot, order or 1)
end

function PetService.UpdateAttributes(plot: Model, pet: any)
	local model = PetService.Find(plot, pet.id)
	if not model then
		return
	end
	local mood = PetRules.Mood(pet)
	model:SetAttribute("Name", pet.name)
	model:SetAttribute("Gender", pet.gender)
	model:SetAttribute("Stage", pet.stage)
	model:SetAttribute("Room", pet.room)
	model:SetAttribute("Mood", math.floor(mood + 0.5))
	model:SetAttribute("Sleeping", pet.sleeping)
	model:SetAttribute("Low", PetRules.LowestNeed(pet) or "")
end

-- Creates (or rebuilds, after growing up) the model for a pet.
function PetService.Spawn(plot: Model, pet: any)
	local existing = PetService.Find(plot, pet.id)
	if existing then
		if existing:GetAttribute("Look") == lookKey(pet) then
			PetService.UpdateAttributes(plot, pet)
			return
		end
		existing:Destroy()
	end
	local model = PetModels.Create(pet)
	model.Name = pet.id
	model:SetAttribute("PetId", pet.id)
	model:SetAttribute("Owner", plot:GetAttribute("Owner"))
	model:SetAttribute("Species", pet.species)
	model:SetAttribute("Look", lookKey(pet))
	model:SetAttribute("Action", "")
	model:SetAttribute("ActionTarget", "")
	model:SetAttribute("ActionEnd", 0)
	model:SetAttribute("ActionId", 0)
	model:SetAttribute("Gift", false)
	local floorCF = roomFloorCFrame(plot, pet.room)
	model:PivotTo(floorCF * CFrame.new(pet.x, 0, pet.z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = (plot:FindFirstChild("Pets") :: Folder)
	PetService.UpdateAttributes(plot, pet)
end

function PetService.Remove(plot: Model, petId: string)
	local model = PetService.Find(plot, petId)
	if model then
		model:Destroy()
	end
end

-- Moves a pet's model to its (new) room.
function PetService.Relocate(plot: Model, pet: any)
	local model = PetService.Find(plot, pet.id)
	if model then
		model:PivotTo(roomFloorCFrame(plot, pet.room) * CFrame.new(pet.x, 0, pet.z))
		model:SetAttribute("Room", pet.room)
		-- Tell clients to snap rather than walk across the house.
		model:SetAttribute("Teleport", (model:GetAttribute("Teleport") or 0) + 1)
	end
end

-- Starts a visible action. `role` picks furniture to walk to (nearest of
-- that role in the pet's room).
function PetService.StartAction(plot: Model, data: any, pet: any, action: string, duration: number, role: string?)
	local model = PetService.Find(plot, pet.id)
	if not model then
		return
	end
	local target = ""
	if role then
		local room = Economy.GetRoom(data, pet.room)
		local f = room and Placement.NearestWithRole(room.furniture, role, pet.x, pet.z)
		if f then
			target = f.uid
		end
	end
	model:SetAttribute("Action", action)
	model:SetAttribute("ActionTarget", target)
	-- Walking to the furniture takes a moment, so allow a little longer.
	model:SetAttribute("ActionEnd", workspace:GetServerTimeNow() + duration + (if target ~= "" then 2.5 else 0))
	model:SetAttribute("ActionId", (model:GetAttribute("ActionId") or 0) + 1)
end

-- Sleeping pets head to the nearest bed in their room.
function PetService.UpdateSleep(plot: Model, data: any, pet: any)
	local model = PetService.Find(plot, pet.id)
	if not model then
		return
	end
	model:SetAttribute("Sleeping", pet.sleeping)
	if pet.sleeping then
		local room = Economy.GetRoom(data, pet.room)
		local bed = room and Placement.NearestWithRole(room.furniture, "Bed", pet.x, pet.z)
		model:SetAttribute("SleepTarget", if bed then bed.uid else "")
	else
		model:SetAttribute("SleepTarget", "")
	end
end

-- Advances every pet's needs by dt seconds and refreshes attributes.
function PetService.Tick(plot: Model, data: any, dt: number, now: number)
	local envs = {}
	for _, pet in data.pets do
		local env = envs[pet.room]
		if not env then
			env = PetService.RoomEnv(data, pet.room)
			envs[pet.room] = env
		end
		local sleepChanged = PetRules.Simulate(pet, dt, env)
		if PetRules.Grow(pet, now) then
			PetService.Spawn(plot, pet)
		end
		if sleepChanged then
			PetService.UpdateSleep(plot, data, pet)
		end
		local model = PetService.Find(plot, pet.id)
		if model then
			local ready = now - pet.lastGiftAt >= Config.Gift.Interval and PetRules.Mood(pet) >= Config.Gift.MinMood
			model:SetAttribute("Gift", ready)
		end
		PetService.UpdateAttributes(plot, pet)
	end
end

function PetService.SpawnAll(plot: Model, data: any)
	for _, pet in data.pets do
		PetService.Spawn(plot, pet)
		PetService.UpdateSleep(plot, data, pet)
	end
end

return PetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Plots</string><ProtectedString name="Source"><![CDATA[-- Each player gets a plot: a little dollhouse of rooms side by side, open at
-- the front so the camera can look in. This module builds the rooms (walls,
-- floors, wallpaper patterns), keeps the furniture models in sync with the
-- save data, and shows locked rooms as "for sale".
--
-- Workspace.Plots.Plot_<n>            attributes Owner, OwnerName, Index
--   Rooms.<roomId>                    attributes RoomId, Order, Locked
--     Shell                           floor, walls, decoration
--     Furniture.<uid>                 attributes Uid, Item, RoomId
--   Pets.<petId>                      built by PetService

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Build = require(Shared:WaitForChild("Build"))
local Placement = require(Shared:WaitForChild("Placement"))
local FurnitureModels = require(Shared:WaitForChild("FurnitureModels"))
local Economy = require(Shared:WaitForChild("Economy"))

local Plots = {}

local plotsFolder: Folder
local used: { [number]: boolean } = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local W, D, H = Config.Room.Width, Config.Room.Depth, Config.Room.WallHeight
local WALL = 1

function Plots.Init()
	plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace
end

local function part(parent: Instance, props: any): BasePart
	props.Parent = parent
	local p = Build.Part(props)
	p.CanQuery = props.CanQuery ~= false
	return p
end

-- Floor-centre CFrame of a room (index 1..#Config.Rooms) on a plot.
function Plots.RoomCFrame(plot: Model, order: number): CFrame
	local origin = plot:GetAttribute("Origin") :: Vector3
	return CFrame.new(origin + V((order - 1) * Config.Room.Spacing, 0, 0))
end

local function buildWallPattern(shell: Model, wallCF: CFrame, width: number, height: number, style: any)
	-- wallCF: centre of the wall's inner face, facing into the room (+Z of the CFrame).
	local accent = style.Accent
	if style.Pattern == "Stripes" then
		local count = math.floor(width / 2)
		for i = 0, count - 1 do
			if i % 2 == 0 then
				local x = -width / 2 + (i + 0.5) * (width / count)
				part(shell, { Name = "Stripe", Size = V(width / count, height - 1.4, 0.05), CFrame = wallCF * CFrame.new(x, 0.3, 0.03), Color = accent, CanQuery = false })
			end
		end
	elseif style.Pattern == "Dots" or style.Pattern == "Stars" then
		local cols = math.floor(width / 3.5)
		local rows = math.floor(height / 3.2)
		for r = 0, rows - 1 do
			for c = 0, cols - 1 do
				local x = -width / 2 + (c + 0.5 + (r % 2) * 0.5) * (width / cols)
				local y = -height / 2 + (r + 0.7) * (height / rows)
				if x < width / 2 - 0.6 and y < height / 2 - 1.5 then
					if style.Pattern == "Dots" then
						part(shell, { Name = "Dot", Shape = "Cylinder", Size = V(0.7, 0.05, 0.7), CFrame = wallCF * CFrame.new(x, y, 0.03) * CFrame.Angles(math.pi / 2, 0, 0), Color = accent, CanQuery = false })
					else
						local star = part(shell, { Name = "Star", Size = V(0.45, 0.45, 0.05), CFrame = wallCF * CFrame.new(x, y, 0.03) * CFrame.Angles(0, 0, math.rad(45)), Color = accent, Material = Enum.Material.Neon, CanQuery = false })
						star.CastShadow = false
					end
				end
			end
		end
	end
end

local function buildShell(room: Model, roomCF: CFrame, def: any, roomData: any?, locked: boolean)
	local old = room:FindFirstChild("Shell")
	if old then
		old:Destroy()
	end
	local shell = Instance.new("Model")
	shell.Name = "Shell"

	local floorStyle = Config.FloorById(if roomData then roomData.floor else def.Floor) or Config.Floors[1]
	local wallStyle = Config.WallpaperById(if roomData then roomData.wallpaper else def.Wallpaper) or Config.Wallpapers[1]
	if locked then
		floorStyle = { Color = rgb(190, 180, 170), Alt = rgb(190, 180, 170), Material = Enum.Material.WoodPlanks, Pattern = "Plain" }
		wallStyle = { Color = rgb(214, 206, 196), Accent = rgb(200, 190, 180), Pattern = "Plain" }
	end

	-- Floor (top surface at y = 0). Tagged so the decorate tool can raycast it.
	local floor = part(shell, {
		Name = "Floor",
		Size = V(W + WALL * 2, 1, D),
		CFrame = roomCF * CFrame.new(0, -0.5, 0),
		Color = floorStyle.Color,
		Material = floorStyle.Material,
	})
	floor:SetAttribute("RoomFloor", true)
	if floorStyle.Pattern == "Checker" then
		local cell = Config.Room.Cell
		for cx = 0, Placement.Cols - 1 do
			for cz = 0, Placement.Rows - 1 do
				if (cx + cz) % 2 == 1 then
					local tile = part(shell, {
						Name = "Tile",
						Size = V(cell, 0.04, cell),
						CFrame = roomCF * CFrame.new(-W / 2 + (cx + 0.5) * cell, 0.02, -D / 2 + (cz + 0.5) * cell),
						Color = floorStyle.Alt,
						CanQuery = false,
					})
					tile.CastShadow = false
				end
			end
		end
	end
	-- Front edge trim.
	part(shell, { Name = "Trim", Size = V(W + WALL * 2, 1.2, 0.6), CFrame = roomCF * CFrame.new(0, -0.4, D / 2 + 0.3), Color = rgb(250, 246, 236), CanQuery = false })

	if def.Outdoor and not locked then
		-- Garden: picket fence instead of walls, open to the sky.
		local white = rgb(250, 250, 250)
		local function fence(fromCF: CFrame, length: number)
			part(shell, { Name = "Rail", Size = V(length, 0.3, 0.2), CFrame = fromCF * CFrame.new(0, 1.2, 0), Color = white, CanQuery = false })
			part(shell, { Name = "Rail", Size = V(length, 0.3, 0.2), CFrame = fromCF * CFrame.new(0, 2.2, 0), Color = white, CanQuery = false })
			for i = 0, math.floor(length / 1.4) do
				local x = -length / 2 + i * 1.4
				part(shell, { Name = "Picket", Size = V(0.5, 3, 0.25), CFrame = fromCF * CFrame.new(x, 1.5, 0.05), Color = white, CanQuery = false })
			end
		end
		fence(roomCF * CFrame.new(0, 0, -D / 2 - 0.3), W + 2)
		fence(roomCF * CFrame.new(-W / 2 - 0.6, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), D)
		fence(roomCF * CFrame.new(W / 2 + 0.6, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), D)
	else
		local wallColor = wallStyle.Color
		-- Back wall with a window.
		local backCF = roomCF * CFrame.new(0, H / 2, -D / 2 - WALL / 2)
		part(shell, { Name = "Wall", Size = V(W + WALL * 2, H, WALL), CFrame = backCF, Color = wallColor })
		local faceCF = roomCF * CFrame.new(0, H / 2, -D / 2)
		buildWallPattern(shell, faceCF, W, H, wallStyle)
		-- Side walls.
		for _, side in { -1, 1 } do
			part(shell, { Name = "Wall", Size = V(WALL, H, D), CFrame = roomCF * CFrame.new(side * (W / 2 + WALL / 2), H / 2, 0), Color = wallColor })
			local sideFace = roomCF * CFrame.new(side * W / 2, H / 2, 0) * CFrame.Angles(0, -side * math.pi / 2, 0)
			buildWallPattern(shell, sideFace, D, H, wallStyle)
		end
		-- Skirting boards.
		local skirting = rgb(255, 252, 245)
		part(shell, { Name = "Skirting", Size = V(W, 0.6, 0.15), CFrame = roomCF * CFrame.new(0, 0.3, -D / 2 + 0.08), Color = skirting, CanQuery = false })
		for _, side in { -1, 1 } do
			part(shell, { Name = "Skirting", Size = V(0.15, 0.6, D), CFrame = roomCF * CFrame.new(side * (W / 2 - 0.08), 0.3, 0), Color = skirting, CanQuery = false })
		end
		-- Window.
		if not locked then
			local winCF = roomCF * CFrame.new(W * 0.22, H * 0.58, -D / 2 + 0.05)
			part(shell, { Name = "WindowFrame", Size = V(5.4, 4.4, 0.2), CFrame = winCF, Color = rgb(255, 255, 255), CanQuery = false })
			local glass = part(shell, { Name = "Window", Size = V(4.8, 3.8, 0.22), CFrame = winCF, Color = rgb(170, 220, 255), Material = Enum.Material.Neon, CanQuery = false })
			glass.Transparency = 0.15
			part(shell, { Name = "WindowBar", Size = V(0.2, 3.8, 0.26), CFrame = winCF, Color = rgb(255, 255, 255), CanQuery = false })
			part(shell, { Name = "WindowBar", Size = V(4.8, 0.2, 0.26), CFrame = winCF, Color = rgb(255, 255, 255), CanQuery = false })
			part(shell, { Name = "Sill", Size = V(6, 0.3, 0.7), CFrame = winCF * CFrame.new(0, -2.3, 0.3), Color = rgb(255, 255, 255), CanQuery = false })
			-- A ceiling light so rooms aren't gloomy.
			local lamp = part(shell, { Name = "Light", Size = V(1, 0.2, 1), CFrame = roomCF * CFrame.new(0, H - 0.1, -2), Color = rgb(255, 250, 230), Transparency = 1, CanQuery = false })
			local light = Instance.new("PointLight")
			light.Range = 26
			light.Brightness = 0.8
			light.Color = rgb(255, 240, 220)
			light.Shadows = false
			light.Parent = lamp
		end
		-- Roof edge along the top of the back wall.
		part(shell, { Name = "Roof", Size = V(W + WALL * 2 + 1, 0.8, 3), CFrame = roomCF * CFrame.new(0, H + 0.4, -D / 2 + 0.5), Color = rgb(214, 110, 110), CanQuery = false })
	end

	if locked then
		local sign = part(shell, { Name = "LockedSign", Size = V(10, 5, 0.3), CFrame = roomCF * CFrame.new(0, 5, -D / 2 + 0.3), Color = rgb(255, 246, 220), CanQuery = false })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.CanvasSize = Vector2.new(400, 200)
		gui.Parent = sign
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = rgb(120, 80, 70)
		label.Text = string.format("🔒 %s\nLevel %d · %d coins", def.Name, def.Level, def.Price)
		label.Parent = gui
		-- The sign faces -Z by default (Front face); turn it to face the camera.
		sign.CFrame = sign.CFrame * CFrame.Angles(0, math.pi, 0)
		-- Boards across the opening.
		for i = 0, 2 do
			part(shell, { Name = "Board", Size = V(W * 0.9, 0.7, 0.3), CFrame = roomCF * CFrame.new(0, 1.5 + i * 3.5, D / 2 - 0.5) * CFrame.Angles(0, 0, (i % 2 - 0.5) * 0.12), Color = rgb(190, 150, 110), Material = Enum.Material.Wood, CanQuery = false })
		end
	end

	shell.Parent = room
end

local function furnitureFolder(room: Model): Folder
	return room:FindFirstChild("Furniture") :: Folder
end

local function placeFurniture(room: Model, roomCF: CFrame, f: any)
	local model = FurnitureModels.Create(f.item)
	model.Name = f.uid
	model:SetAttribute("Uid", f.uid)
	model:SetAttribute("Item", f.item)
	model:SetAttribute("RoomId", room:GetAttribute("RoomId"))
	model:PivotTo(FurnitureModels.PlacementCFrame(roomCF, f.item, f.cx, f.cz, f.rot, Placement))
	model.Parent = furnitureFolder(room)
end

-- Makes the furniture models in a room match the save data.
function Plots.SyncFurniture(plot: Model, roomData: any)
	local room = (plot:FindFirstChild("Rooms") :: Folder):FindFirstChild(roomData.id) :: Model?
	if not room then
		return
	end
	local roomCF = Plots.RoomCFrame(plot, room:GetAttribute("Order"))
	local folder = furnitureFolder(room)
	local wanted = {}
	for _, f in roomData.furniture do
		wanted[f.uid] = f
	end
	for _, model in folder:GetChildren() do
		local f = wanted[model.Name]
		if not f or model:GetAttribute("Item") ~= f.item then
			model:Destroy()
		else
			model:PivotTo(FurnitureModels.PlacementCFrame(roomCF, f.item, f.cx, f.cz, f.rot, Placement))
			wanted[model.Name] = nil
		end
	end
	for _, f in wanted do
		placeFurniture(room, roomCF, f)
	end
end

-- Rebuilds a room's shell (after a wallpaper/floor change or an unlock).
function Plots.RefreshRoom(plot: Model, data: any, roomId: string)
	local def, order = Config.RoomById(roomId)
	local room = (plot:FindFirstChild("Rooms") :: Folder):FindFirstChild(roomId) :: Model?
	if not def or not room then
		return
	end
	local roomData = Economy.GetRoom(data, roomId)
	local locked = roomData == nil
	room:SetAttribute("Locked", locked)
	buildShell(room, Plots.RoomCFrame(plot, order), def, roomData, locked)
	if roomData then
		Plots.SyncFurniture(plot, roomData)
	else
		furnitureFolder(room):ClearAllChildren()
	end
end

local function buildGrounds(plot: Model)
	local origin = plot:GetAttribute("Origin") :: Vector3
	local span = (#Config.Rooms - 1) * Config.Room.Spacing
	local center = origin + V(span / 2, 0, 0)
	local grounds = Instance.new("Model")
	grounds.Name = "Grounds"
	part(grounds, { Name = "Lawn", Size = V(span + 140, 2, 140), CFrame = CFrame.new(center + V(0, -1.2, 10)), Color = rgb(140, 204, 110), Material = Enum.Material.Grass, CanQuery = false })
	part(grounds, { Name = "Path", Size = V(span + 60, 0.2, 6), CFrame = CFrame.new(center + V(0, -0.15, D / 2 + 8)), Color = rgb(236, 220, 190), Material = Enum.Material.Pebble, CanQuery = false })
	-- A few round trees and bushes behind the house.
	local rng = Random.new(7)
	for i = 1, 14 do
		local x = center.X + rng:NextNumber(-span / 2 - 50, span / 2 + 50)
		local z = center.Z - D / 2 - rng:NextNumber(12, 50)
		local s = rng:NextNumber(0.8, 1.6)
		part(grounds, { Name = "Trunk", Shape = "Cylinder", Size = V(1.2 * s, 6 * s, 1.2 * s), CFrame = CFrame.new(x, 3 * s - 0.2, z), Color = rgb(140, 100, 70), Material = Enum.Material.Wood, CanQuery = false })
		part(grounds, { Name = "Leaves", Shape = "Ellipsoid", Size = V(8, 7, 8) * s, CFrame = CFrame.new(x, 8 * s, z), Color = rgb(96 + i * 3, 176, 92), Material = Enum.Material.Grass, CanQuery = false })
	end
	for i = 1, 10 do
		local x = center.X + (i - 5.5) * (span + 40) / 10
		part(grounds, { Name = "Bush", Shape = "Ellipsoid", Size = V(4, 2.6, 3), CFrame = CFrame.new(x, 0.9, origin.Z + D / 2 + 14), Color = rgb(110, 186, 100), Material = Enum.Material.Grass, CanQuery = false })
	end
	grounds.Parent = plot
end

-- Creates a plot for the player and builds every room (locked ones too).
function Plots.Create(player: Player, data: any): Model
	local index = 0
	while used[index] do
		index += 1
	end
	used[index] = true
	local plot = Instance.new("Model")
	plot.Name = "Plot_" .. index
	plot:SetAttribute("Index", index)
	plot:SetAttribute("Owner", player.UserId)
	plot:SetAttribute("OwnerName", player.DisplayName)
	plot:SetAttribute("Origin", V(index * Config.PlotSpacing, 0, 0))

	local rooms = Instance.new("Folder")
	rooms.Name = "Rooms"
	rooms.Parent = plot
	local pets = Instance.new("Folder")
	pets.Name = "Pets"
	pets.Parent = plot

	buildGrounds(plot)
	for order, def in Config.Rooms do
		local room = Instance.new("Model")
		room.Name = def.Id
		room:SetAttribute("RoomId", def.Id)
		room:SetAttribute("Order", order)
		room:SetAttribute("RoomName", def.Name)
		local furniture = Instance.new("Folder")
		furniture.Name = "Furniture"
		furniture.Parent = room
		room.Parent = rooms
		Plots.RefreshRoom(plot, data, def.Id)
	end
	plot.Parent = plotsFolder
	return plot
end

function Plots.Rebuild(plot: Model, data: any)
	for _, def in Config.Rooms do
		Plots.RefreshRoom(plot, data, def.Id)
	end
end

function Plots.Destroy(plot: Model)
	used[plot:GetAttribute("Index") :: number] = nil
	plot:Destroy()
end

return Plots
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000020"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000001E"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- A fixed dollhouse camera looking into the current room from the front.
-- Mouse wheel / pinch zooms; Q/E or dragging with the right mouse button
-- swings the view a little; switching rooms glides across the house.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))

local CameraController = {}

local camera = workspace.CurrentCamera
local zoom = 1 -- 0.55 (close) .. 1.35 (far)
local swing = 0 -- radians, -0.5 .. 0.5
local current: CFrame? = nil
local dragging = false

local OFFSET = Vector3.new(0, 15, 27)
local LOOK = Vector3.new(0, 2.2, -1.5)

local function goal(): CFrame
	local roomCF = State.RoomCFrame(State.ViewPlot, State.RoomIndex)
	local focus = roomCF.Position + LOOK
	local offset = CFrame.Angles(0, swing, 0) * (OFFSET * zoom)
	return CFrame.lookAt(focus + offset, focus)
end

function CameraController.Zoom(delta: number)
	zoom = math.clamp(zoom + delta, 0.55, 1.35)
end

function CameraController.Snap()
	current = nil
end

function CameraController.Init()
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 50

	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			CameraController.Zoom(-input.Position.Z * 0.08)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
			swing = math.clamp(swing - input.Delta.X * 0.004, -0.55, 0.55)
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = true
		elseif input.KeyCode == Enum.KeyCode.Q then
			swing = math.clamp(swing + 0.2, -0.55, 0.55)
		elseif input.KeyCode == Enum.KeyCode.E then
			swing = math.clamp(swing - 0.2, -0.55, 0.55)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			dragging = false
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, inputState, processed)
		if not processed and inputState == Enum.UserInputState.Change then
			CameraController.Zoom((1 - scale) * 0.05)
		end
	end)
	State.RoomChanged:Connect(function()
		swing = 0
	end)

	RunService:BindToRenderStep("HappyPetsCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		if not State.ViewPlot then
			return
		end
		local target = goal()
		if not current or (current.Position - target.Position).Magnitude > Config.PlotSpacing * 0.5 then
			current = target
		else
			current = (current :: CFrame):Lerp(target, math.min(1, dt * 6))
		end
		camera.CFrame = current :: CFrame
	end)
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000016"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Happy Pets client: starts the UI, camera and pet animation, handles
-- clicking/tapping pets and furniture, and shows server notifications.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local PetAnimator = require(script.Parent:WaitForChild("PetAnimator"))
local PetPanel = require(script.Parent:WaitForChild("PetPanel"))
local Windows = require(script.Parent:WaitForChild("Windows"))
local Decorate = require(script.Parent:WaitForChild("Decorate"))
local CameraController = require(script.Parent:WaitForChild("CameraController"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyRemote = remotes:WaitForChild("Notify") :: RemoteEvent

-- No backpack, health bar or player list clutter; this is a click game.
for _, coreType in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(coreType, false)
	end)
end

UI.Init()
State.Init()

---------------------------------------------------------------------------
-- Wiring between modules
---------------------------------------------------------------------------

local function openWindow(id: string)
	if id ~= "Decorate" and State.Decorating then
		Decorate.Exit()
	end
	if id == "Adopt" then
		Windows.Adopt()
	elseif id == "Pets" then
		Windows.Pets()
	elseif id == "Shop" then
		Windows.Shop()
	elseif id == "Items" then
		Windows.Items()
	elseif id == "Decorate" then
		UI.CloseWindow()
		if State.Decorating then
			Decorate.Exit()
		else
			Decorate.Enter()
		end
	elseif id == "Breed" then
		Windows.Breed()
	elseif id == "Rooms" then
		Windows.Rooms()
	elseif id == "Visit" then
		Windows.Visit()
	elseif id == "Settings" then
		Windows.Settings()
	end
end

local function claimDaily()
	local r = State.Request("ClaimDaily")
	if r.ok then
		UI.Play("Coin", 0.6)
	end
end

Hud.Init(openWindow, claimDaily)
PetPanel.Init()
PetAnimator.Init()
Decorate.Init()
CameraController.Init()

Windows.Toast = function(text)
	Hud.Toast(text)
end
Windows.StartPlacing = function(itemId)
	UI.CloseWindow()
	if State.IsVisiting() then
		State.SetView(State.HomePlot(), 1)
	end
	-- Place in the current room if it's unlocked, otherwise the first room.
	if not State.HasRoom(State.RoomId()) then
		State.SetRoom(1)
	end
	Decorate.StartPlacing(itemId)
end
Decorate.OpenItems = Windows.Items
Decorate.Toast = function(text)
	Hud.Toast(text)
end
PetPanel.OpenShop = function(tab)
	Windows.Shop(tab)
end
PetPanel.Rename = Windows.Rename

local function collectGift(model: Model)
	local r = State.Request("CollectGift", { petId = model:GetAttribute("PetId") })
	if r.ok then
		PetAnimator.Hearts(model)
	end
end
PetAnimator.OnGiftClicked = collectGift

State.DecorateChanged:Connect(function(on)
	local nav = Hud.NavButton("Decorate")
	if nav then
		nav.BackgroundColor3 = if on then UI.Colors.Pink else UI.Colors.Green
		nav:SetAttribute("BaseColor", nav.BackgroundColor3)
	end
end)

---------------------------------------------------------------------------
-- Clicking pets and furniture
---------------------------------------------------------------------------

local function petAt(point: Vector2): Model?
	local plot = State.ViewPlot
	local folder = plot and plot:FindFirstChild("Pets")
	if not folder then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if not hit then
		return nil
	end
	local inst: Instance? = hit.Instance
	while inst and inst.Parent ~= folder do
		inst = inst.Parent
	end
	return inst :: Model?
end

local function furnitureAt(point: Vector2): Model?
	local room = State.RoomModel()
	local folder = room and room:FindFirstChild("Furniture")
	if not folder then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	local inst: Instance? = hit and hit.Instance
	while inst and inst.Parent ~= folder do
		inst = inst.Parent
	end
	return inst :: Model?
end

local ROLE_TIPS = {
	Bowl = "Pets eat here when you feed them.",
	Bed = "Sleepy pets nap here and recover energy faster.",
	Toy = "Pets play with this when you press Play.",
	Litter = "Keeps pets in this room clean for longer.",
}

local function handlePress(point: Vector2)
	if Decorate.HandlePress(point) then
		return
	end
	local pet = petAt(point)
	if pet then
		local own = not State.IsVisiting()
		if own and pet:GetAttribute("Gift") == true then
			collectGift(pet)
		end
		if State.SelectedPet == pet then
			-- Clicking the selected pet again gives it a pat.
			if own then
				State.Request("Care", { petId = pet:GetAttribute("PetId"), action = "Pet" })
			else
				State.Request("VisitPet", { ownerId = pet:GetAttribute("Owner"), petId = pet:GetAttribute("PetId") })
			end
		else
			UI.Play("Pop", 0.3)
			State.Select(pet)
			PetAnimator.Bubble(pet, if pet:GetAttribute("Sleeping") then "💤" else "❤️", 1.2)
		end
		return
	end
	local furniture = furnitureAt(point)
	if furniture and not State.IsVisiting() then
		local item = Config.Items[furniture:GetAttribute("Item") :: string]
		if item then
			local tip = (item.Role and ROLE_TIPS[item.Role]) or (if (item.Comfort or 0) > 0 then "Decorations keep pets happy for longer." else "")
			Hud.Toast(string.format("%s %s: %s Use 🛋️ Decorate to move it.", item.Icon, item.Name, tip))
		end
		return
	end
	State.Select(nil)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		handlePress(UserInputService:GetMouseLocation())
	elseif input.UserInputType == Enum.UserInputType.Touch then
		-- Touch positions exclude the top bar inset; convert to viewport space.
		handlePress(Vector2.new(input.Position.X, input.Position.Y + UI.Inset()))
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		PetAnimator.SetHover(if State.Decorating then nil else petAt(UserInputService:GetMouseLocation()))
	end
end)

-- Arrow keys / A-D switch rooms.
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.A then
		State.SetRoom(State.RoomIndex - 1)
	elseif input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.D then
		State.SetRoom(State.RoomIndex + 1)
	end
end)

---------------------------------------------------------------------------
-- Server notifications
---------------------------------------------------------------------------

notifyRemote.OnClientEvent:Connect(function(msg)
	if typeof(msg) ~= "table" then
		return
	end
	if msg.kind == "reward" then
		local worldPos = nil
		local plot = State.ViewPlot
		local model = plot and msg.petId and (plot:FindFirstChild("Pets") :: Folder):FindFirstChild(msg.petId)
		if model then
			worldPos = PetAnimator.WorldPosition(model :: Model)
		end
		Hud.FloatReward(worldPos, msg.xp or 0, msg.coins or 0)
		if msg.text then
			if model then
				PetAnimator.Bubble(model :: Model, "💖", 2)
			end
			Hud.Toast(msg.text)
		end
	elseif msg.kind == "levelup" then
		Hud.LevelUp(msg.level, msg.coins, msg.unlocks or {})
	elseif msg.kind == "toast" then
		Hud.Toast(msg.text)
	elseif msg.kind == "reset" then
		UI.CloseWindow()
		State.SetView(State.HomePlot(), 1)
	end
end)

---------------------------------------------------------------------------
-- Start: wait for our home, then look at it.
---------------------------------------------------------------------------

local loading = UI.new("Frame", {
	Name = "Loading",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 232, 240),
	ZIndex = 50,
	Parent = UI.Screen(),
})
local loadingTitle = UI.title({ Text = "🐾 " .. Config.GameName .. " 🐾", Size = UDim2.new(1, 0, 0, 80), Position = UDim2.fromScale(0, 0.38), TextSize = 64, TextColor3 = UI.Colors.Pink, Parent = loading })
UI.textStroke(Color3.fromRGB(170, 60, 100), 3).Parent = loadingTitle
UI.label({ Text = "Fluffing the cushions…", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromScale(0, 0.52), TextSize = 22, Font = UI.Font, Parent = loading })
Hud.SetVisible(false)

task.spawn(function()
	local plot = State.HomePlot()
	while not plot or not State.Profile do
		task.wait(0.2)
		plot = State.HomePlot()
	end
	State.SetView(plot, 1)
	CameraController.Snap()
	task.wait(0.3)
	loading:Destroy()
	Hud.SetVisible(true)
	-- First visit: straight to choosing a kitten.
	if State.Profile and not State.Profile.starterDone then
		task.wait(0.5)
		Windows.Adopt()
	end
end)

player:GetAttributeChangedSignal("Plot"):Connect(function()
	if not State.IsVisiting() then
		State.SetView(State.HomePlot(), State.RoomIndex)
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Decorate</string><ProtectedString name="Source"><![CDATA[-- Decorate mode: pick up furniture, slide a see-through preview around the
-- room's floor grid (green = fits, red = blocked), rotate it, then place it,
-- put it back in the inventory, or cancel. New items from the inventory are
-- placed the same way. The server re-checks every placement.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Placement = require(Shared:WaitForChild("Placement"))
local FurnitureModels = require(Shared:WaitForChild("FurnitureModels"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))

local Decorate = {}

-- Set by the client.
Decorate.OpenItems = function() end
Decorate.Toast = function(_text: string) end

local camera = workspace.CurrentCamera

local toolbar: Frame
local hint: TextLabel
local carryButtons: { [string]: TextButton } = {}
local idleButtons: { [string]: TextButton } = {}
local hoverBox: SelectionBox

type Carry = {
	itemId: string,
	uid: string?, -- nil for a new item from the inventory
	original: Model?,
	ghost: Model,
	tint: Highlight,
	rot: number,
	cx: number,
	cz: number,
	valid: boolean,
}
local carry: Carry? = nil
local pointer: Vector2? = nil -- last pointer position (viewport space)

local function roomFurnitureData(): { any }
	local room = State.RoomData(State.RoomId())
	return if room then room.furniture else {}
end

local function roomCF(): CFrame
	return State.RoomCFrame(State.ViewPlot, State.RoomIndex)
end

local function setHidden(model: Model?, hidden: boolean)
	if not model then
		return
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

local function refreshToolbar()
	local carrying = carry ~= nil
	for _, b in carryButtons do
		b.Visible = carrying
	end
	for _, b in idleButtons do
		b.Visible = not carrying
	end
	if carry then
		local item = Config.Items[carry.itemId]
		hint.Text = if UI.IsTouch() then "Tap the floor to move the " .. item.Name .. ", then press Place." else "Move the " .. item.Name .. " and click to place it. R rotates."
	else
		hint.Text = if UI.IsTouch() then "Tap furniture to move it." else "Click furniture to move it, or place something from your items."
	end
end

-- Moves the preview to the cell under a viewport point.
local function moveGhost(point: Vector2?)
	local c = carry
	if not c then
		return
	end
	if point then
		local ray = camera:ViewportPointToRay(point.X, point.Y)
		local floorY = roomCF().Position.Y
		if math.abs(ray.Direction.Y) > 1e-4 then
			local t = (floorY - ray.Origin.Y) / ray.Direction.Y
			if t > 0 then
				local hit = ray.Origin + ray.Direction * t
				local localPos = roomCF():PointToObjectSpace(hit)
				c.cx, c.cz = Placement.LocalToCell(c.itemId, localPos.X, localPos.Z, c.rot)
			end
		end
	end
	local w, d = Placement.Footprint(c.itemId, c.rot)
	c.cx = math.clamp(c.cx, 0, Placement.Cols - w)
	c.cz = math.clamp(c.cz, 0, Placement.Rows - d)
	c.ghost:PivotTo(FurnitureModels.PlacementCFrame(roomCF(), c.itemId, c.cx, c.cz, c.rot, Placement))
	c.valid = (Placement.Validate(roomFurnitureData(), c.itemId, c.cx, c.cz, c.rot, c.uid))
	c.tint.FillColor = if c.valid then Color3.fromRGB(110, 230, 110) else Color3.fromRGB(240, 80, 80)
	c.tint.OutlineColor = c.tint.FillColor
	if carryButtons.Place then
		UI.SetEnabled(carryButtons.Place, c.valid)
	end
end

local function makeGhost(itemId: string): (Model, Highlight)
	local ghost = FurnitureModels.Create(itemId)
	ghost.Name = "PlacementGhost"
	for _, p in ghost:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanQuery = false
			p.Transparency = math.max(p.Transparency, 0.35)
		elseif p:IsA("Light") then
			p.Enabled = false
		end
	end
	ghost.Parent = workspace
	local tint = UI.new("Highlight", { FillTransparency = 0.55, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = ghost, Parent = ghost })
	return ghost, tint
end

local function stopCarry()
	local c = carry
	if c then
		carry = nil
		c.ghost:Destroy()
		setHidden(c.original, false)
	end
	refreshToolbar()
end

local function beginCarry(itemId: string, uid: string?, original: Model?, cx: number?, cz: number?, rot: number?)
	stopCarry()
	local ghost, tint = makeGhost(itemId)
	carry = { itemId = itemId, uid = uid, original = original, ghost = ghost, tint = tint, rot = rot or 0, cx = cx or 0, cz = cz or 0, valid = false }
	setHidden(original, true)
	if not cx then
		-- New item: start in the first free spot, or the middle.
		local fx, fz, frot = Placement.FindFreeSpot(roomFurnitureData(), itemId)
		local c = carry :: Carry
		if fx then
			c.cx, c.cz, c.rot = fx, fz :: number, frot :: number
		else
			c.cx, c.cz = Placement.Cols // 2, Placement.Rows // 2
		end
	end
	moveGhost(nil)
	refreshToolbar()
end

local function rotate()
	local c = carry
	if c then
		c.rot = (c.rot + 1) % 4
		moveGhost(nil)
	end
end

local function confirm()
	local c = carry
	if not c then
		return
	end
	if not c.valid then
		Decorate.Toast("That spot is blocked. Try somewhere else!")
		return
	end
	local result
	if c.uid then
		result = State.Request("MoveFurniture", { uid = c.uid, roomId = State.RoomId(), cx = c.cx, cz = c.cz, rot = c.rot })
	else
		result = State.Request("Place", { itemId = c.itemId, roomId = State.RoomId(), cx = c.cx, cz = c.cz, rot = c.rot })
	end
	if result.ok then
		UI.Play("Pop", 0.4)
		stopCarry()
	end
end

local function store()
	local c = carry
	if not c then
		return
	end
	if not c.uid then
		stopCarry()
		return
	end
	local result = State.Request("StoreFurniture", { uid = c.uid })
	if result.ok then
		Decorate.Toast(Config.Items[c.itemId].Name .. " was put away in your items.")
		carry = nil
		c.ghost:Destroy()
		refreshToolbar()
	end
end

-- Furniture model under a viewport point in the current room.
local function furnitureAt(point: Vector2): Model?
	local room = State.RoomModel()
	local folder = room and room:FindFirstChild("Furniture")
	if not folder then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if not hit then
		return nil
	end
	local inst: Instance? = hit.Instance
	while inst and inst.Parent ~= folder do
		inst = inst.Parent
	end
	return inst :: Model?
end

local function pickUp(model: Model)
	local uid = model:GetAttribute("Uid") :: string
	for _, f in roomFurnitureData() do
		if f.uid == uid then
			beginCarry(f.item, uid, model, f.cx, f.cz, f.rot)
			return
		end
	end
end

function Decorate.IsActive(): boolean
	return State.Decorating
end

function Decorate.Enter()
	if State.IsVisiting() then
		State.SetView(State.HomePlot(), State.RoomIndex)
	end
	if not State.HasRoom(State.RoomId()) then
		Decorate.Toast("Unlock this room before decorating it.")
		return
	end
	State.Select(nil)
	State.Decorating = true
	toolbar.Visible = true
	refreshToolbar()
	State.DecorateChanged:Fire(true)
end

function Decorate.Exit()
	stopCarry()
	State.Decorating = false
	toolbar.Visible = false
	hoverBox.Adornee = nil
	State.DecorateChanged:Fire(false)
end

-- Starts placing a new item from the inventory in the current room.
function Decorate.StartPlacing(itemId: string)
	if not State.Decorating then
		Decorate.Enter()
	end
	if not State.Decorating then
		return
	end
	if not State.Profile or (State.Profile.inventory[itemId] or 0) < 1 then
		Decorate.Toast("You don't have that item.")
		return
	end
	beginCarry(itemId, nil, nil)
end

-- Called by the client for clicks/taps while decorating. Returns true if handled.
function Decorate.HandlePress(point: Vector2): boolean
	if not State.Decorating then
		return false
	end
	pointer = point
	if carry then
		if UI.IsTouch() then
			moveGhost(point)
		else
			moveGhost(point)
			confirm()
		end
		return true
	end
	local model = furnitureAt(point)
	if model then
		pickUp(model)
	end
	return true
end

function Decorate.Init()
	local screen = UI.Screen()
	toolbar = UI.new("Frame", {
		Name = "DecorateBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(640, 96),
		BackgroundColor3 = UI.Colors.Cream,
		Visible = false,
		Parent = screen,
	}, { UI.corner(16), UI.stroke(UI.Colors.Green, 4) })
	UI.title({ Text = "🛋️ Decorating", Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 24), TextSize = 20, Parent = toolbar })
	hint = UI.label({ Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 18), TextSize = 14, TextColor3 = UI.Colors.Soft, Parent = toolbar })
	local row = UI.new("Frame", { Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = toolbar }, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })

	carryButtons.Rotate = UI.button({ Text = "⟳ Rotate", Color = UI.Colors.Blue, Size = UDim2.fromOffset(110, 38), TextSize = 16, LayoutOrder = 1, Parent = row, Tooltip = "Rotate (R)", OnClick = rotate })
	carryButtons.Place = UI.button({ Text = "✓ Place", Color = UI.Colors.Green, Size = UDim2.fromOffset(110, 38), TextSize = 16, LayoutOrder = 2, Parent = row, OnClick = confirm })
	carryButtons.Store = UI.button({ Text = "📦 Put away", Color = UI.Colors.Orange, Size = UDim2.fromOffset(130, 38), TextSize = 16, LayoutOrder = 3, Parent = row, Tooltip = "Move it back to your items", OnClick = store })
	carryButtons.Cancel = UI.button({ Text = "✕ Cancel", Color = UI.Colors.Gray, Size = UDim2.fromOffset(110, 38), TextSize = 16, LayoutOrder = 4, Parent = row, OnClick = stopCarry })
	idleButtons.Items = UI.button({ Text = "🎒 Place an item", Color = UI.Colors.Blue, Size = UDim2.fromOffset(180, 38), TextSize = 16, LayoutOrder = 5, Parent = row, OnClick = function()
		Decorate.OpenItems()
	end })
	idleButtons.Done = UI.button({ Text = "✓ Done", Color = UI.Colors.Green, Size = UDim2.fromOffset(120, 38), TextSize = 16, LayoutOrder = 6, Parent = row, OnClick = Decorate.Exit })

	hoverBox = UI.new("SelectionBox", { Color3 = UI.Colors.Green, LineThickness = 0.08, SurfaceTransparency = 0.85, SurfaceColor3 = UI.Colors.Green, Parent = workspace })

	ContextActionService:BindAction("HappyPetsRotate", function(_, inputState)
		if inputState == Enum.UserInputState.Begin and State.Decorating and carry then
			rotate()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.R)
	ContextActionService:BindAction("HappyPetsCancel", function(_, inputState)
		if inputState == Enum.UserInputState.Begin and State.Decorating then
			if carry then
				stopCarry()
			else
				Decorate.Exit()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Escape, Enum.KeyCode.Delete)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			pointer = UserInputService:GetMouseLocation()
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not State.Decorating then
			return
		end
		if carry and pointer and not UI.IsTouch() then
			moveGhost(pointer)
			hoverBox.Adornee = nil
		elseif not carry and pointer and not UI.IsTouch() then
			hoverBox.Adornee = furnitureAt(pointer)
		end
	end)
	-- Leaving the room or visiting someone ends what you were holding.
	State.RoomChanged:Connect(function()
		if carry then
			stopCarry()
		end
		if State.Decorating and (State.IsVisiting() or not State.HasRoom(State.RoomId())) then
			Decorate.Exit()
		end
	end)
	-- The server's copy of the room changed (e.g. after placing): re-check.
	State.ProfileChanged:Connect(function()
		if carry then
			moveGhost(nil)
		end
	end)
end

return Decorate
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- The always-on interface: status bar (level, XP, coins, daily bonus, save
-- state), the navigation bar, the room switcher, the "visiting" banner,
-- toasts, floating rewards and the level-up celebration.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local Hud = {}

local screen: ScreenGui
local toastHolder: Frame
local navButtons: { [string]: TextButton } = {}
local navBadges: { [string]: TextLabel } = {}
local roomLabel: TextLabel
local visitBanner: Frame
local visitLabel: TextLabel
local roomBar: Frame

export type NavHandler = (string) -> ()

local NAV = {
	{ id = "Adopt", icon = "🐾", label = "Adopt", color = UI.Colors.Pink, tip = "Adopt a new pet" },
	{ id = "Pets", icon = "📖", label = "My Pets", color = UI.Colors.Purple, tip = "Your pet collection" },
	{ id = "Shop", icon = "🛍️", label = "Shop", color = UI.Colors.Orange, tip = "Buy food, toys and furniture" },
	{ id = "Items", icon = "🎒", label = "Items", color = UI.Colors.Blue, tip = "Your inventory" },
	{ id = "Decorate", icon = "🛋️", label = "Decorate", color = UI.Colors.Green, tip = "Move and place furniture" },
	{ id = "Breed", icon = "💞", label = "Breed", color = Color3.fromRGB(240, 100, 130), tip = "Have baby pets" },
	{ id = "Rooms", icon = "🏠", label = "Rooms", color = Color3.fromRGB(120, 180, 200), tip = "Unlock rooms, wallpaper and floors" },
	{ id = "Visit", icon = "👋", label = "Visit", color = Color3.fromRGB(110, 170, 150), tip = "Visit other players' pets" },
	{ id = "Settings", icon = "⚙️", label = "Settings", color = UI.Colors.Gray, tip = "Sound and save options" },
}

function Hud.Toast(text: string, color: Color3?)
	local toast = UI.new("Frame", {
		Size = UDim2.fromOffset(420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = color or UI.Colors.Cream,
		Parent = toastHolder,
	}, { UI.corner(14), UI.stroke(UI.Colors.Edge, 3), UI.padding(10) })
	local label = UI.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		Font = UI.Font,
		TextSize = 18,
		TextColor3 = if color then UI.Colors.White else UI.Colors.Ink,
		Parent = toast,
	})
	if color then
		UI.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.4), 1.5).Parent = label
	end
	task.delay(3.2, function()
		local info = TweenInfo.new(0.4)
		TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, info, { TextTransparency = 1 }):Play()
		local stroke = toast:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		toast:Destroy()
	end)
	-- Keep at most four.
	local list = {}
	for _, c in toastHolder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(list, c)
		end
	end
	if #list > 4 then
		list[1]:Destroy()
	end
end

function Hud.Error(text: string)
	UI.Play("Pop", 0.4)
	Hud.Toast(text, Color3.fromRGB(232, 110, 110))
end

-- "+5 XP  +2 🪙" rising from a point on screen (or the screen centre).
function Hud.FloatReward(worldPos: Vector3?, xp: number, coins: number)
	local parts = {}
	if xp > 0 then
		table.insert(parts, "+" .. xp .. " XP")
	end
	if coins > 0 then
		table.insert(parts, "+" .. coins .. " 🪙")
	end
	if #parts == 0 then
		return
	end
	local scale = UI.UIScale()
	local camera = workspace.CurrentCamera
	local pos = camera.ViewportSize / 2
	if worldPos then
		local p, onScreen = camera:WorldToViewportPoint(worldPos)
		if onScreen then
			pos = Vector2.new(p.X, p.Y)
		end
	end
	local label = UI.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromOffset(pos.X / scale, pos.Y / scale),
		Size = UDim2.fromOffset(220, 34),
		Text = table.concat(parts, "   "),
		Font = UI.Font,
		TextSize = 26,
		TextColor3 = if coins > 0 then UI.Colors.Yellow else Color3.fromRGB(140, 230, 120),
		ZIndex = 15,
		Parent = screen,
	})
	UI.textStroke(UI.Colors.Ink, 2.5).Parent = label
	local info = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(label, info, { Position = label.Position - UDim2.fromOffset(0, 70) }):Play()
	task.delay(0.8, function()
		TweenService:Create(label, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end
	end)
	task.delay(1.5, function()
		label:Destroy()
	end)
	if coins > 0 then
		UI.Play("Coin", 0.35)
	end
end

function Hud.LevelUp(level: number, coins: number, unlocks: { string })
	UI.Play("Coin", 0.6)
	local holder = UI.new("Frame", {
		Name = "LevelUp",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Active = true,
		Parent = screen,
	})
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Colors.Cream,
		Parent = holder,
	}, { UI.corner(20), UI.stroke(UI.Colors.Yellow, 5), UI.padding(18), UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center) })
	local big = UI.title({ Text = "⭐ Level " .. level .. "! ⭐", Size = UDim2.new(1, 0, 0, 44), TextSize = 36, TextColor3 = UI.Colors.Yellow, LayoutOrder = 1, Parent = card })
	UI.textStroke(Color3.fromRGB(170, 110, 30), 2.5).Parent = big
	UI.label({ Text = "You earned " .. coins .. " 🪙", Size = UDim2.new(1, 0, 0, 26), TextSize = 20, Font = UI.Font, LayoutOrder = 2, Parent = card })
	if #unlocks > 0 then
		UI.label({ Text = "New things unlocked:", Size = UDim2.new(1, 0, 0, 22), TextSize = 16, TextColor3 = UI.Colors.Soft, LayoutOrder = 3, Parent = card })
		UI.label({
			Text = table.concat(unlocks, " · "),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = 17,
			LayoutOrder = 4,
			Parent = card,
		})
	end
	UI.button({
		Text = "Hooray!",
		Color = UI.Colors.Green,
		Size = UDim2.fromOffset(160, 46),
		LayoutOrder = 5,
		Parent = card,
		OnClick = function()
			holder:Destroy()
		end,
	})
	local s = UI.new("UIScale", { Scale = 0.6, Parent = card })
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function Hud.SetBadge(id: string, text: string?)
	local badge = navBadges[id]
	if badge then
		badge.Visible = text ~= nil
		badge.Text = text or ""
	end
end

function Hud.NavButton(id: string): TextButton?
	return navButtons[id]
end

local function buildStatusBar(onDaily: () -> ())
	local bar = UI.new("Frame", {
		Name = "StatusBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 52),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.Colors.Cream,
		Parent = screen,
	}, { UI.corner(18), UI.stroke(UI.Colors.Edge, 3), UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })

	local star = UI.new("Frame", { Size = UDim2.fromOffset(44, 44), BackgroundColor3 = UI.Colors.Yellow, LayoutOrder = 1, Parent = bar }, { UI.corner(22), UI.stroke(Color3.fromRGB(200, 140, 30), 3) })
	local levelText = UI.title({ Size = UDim2.fromScale(1, 1), Text = "1", TextSize = 22, TextColor3 = UI.Colors.White, Parent = star })
	UI.textStroke(Color3.fromRGB(170, 110, 30), 2).Parent = levelText
	UI.tooltip(star, "Your level")

	local xpBack, setXP = UI.bar({ Size = UDim2.fromOffset(180, 22), LayoutOrder = 2, Parent = bar, TextSize = 14 }, Color3.fromRGB(130, 210, 110))
	UI.tooltip(xpBack, function()
		local p = State.Profile
		return if p then string.format("%d / %d XP to level %d", p.xp, p.xpNext, p.level + 1) else ""
	end)

	local coinPill = UI.new("Frame", { Size = UDim2.fromOffset(130, 36), BackgroundColor3 = Color3.fromRGB(255, 236, 170), LayoutOrder = 3, Parent = bar }, { UI.corner(18), UI.stroke(Color3.fromRGB(220, 170, 60), 3) })
	local coinText = UI.title({ Size = UDim2.fromScale(1, 1), Text = "🪙 0", TextSize = 20, TextColor3 = UI.Colors.Ink, Parent = coinPill })
	UI.tooltip(coinPill, "Coins: earn them by caring for pets and collecting gifts")

	local daily = UI.button({ Text = "🎁 Daily", Color = UI.Colors.Purple, Size = UDim2.fromOffset(100, 38), TextSize = 16, LayoutOrder = 4, Parent = bar, OnClick = onDaily, Tooltip = "Collect your daily bonus" })

	local saveText = UI.label({ Size = UDim2.fromOffset(92, 36), Text = "…", TextSize = 13, TextColor3 = UI.Colors.Soft, LayoutOrder = 5, Parent = bar })
	UI.tooltip(saveText, function()
		local status = player:GetAttribute("SaveStatus")
		if status == "Offline" then
			return "DataStores aren't available here, so progress won't be kept."
		end
		return "Your home saves automatically."
	end)

	local function refresh()
		local p = State.Profile
		if not p then
			return
		end
		levelText.Text = tostring(p.level)
		setXP(if p.xpNext > 0 then p.xp / p.xpNext else 1, string.format("%d / %d XP", p.xp, p.xpNext))
		local function commas(n: number): string
			local s = tostring(math.floor(n))
			local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
			return (string.gsub(out, "^,", ""))
		end
		coinText.Text = "🪙 " .. commas(p.coins)
		daily.Visible = p.dailyReady == true
	end
	State.ProfileChanged:Connect(refresh)
	refresh()

	local function refreshSave()
		local status = player:GetAttribute("SaveStatus")
		local text = {
			Loading = "⏳ Loading",
			Saving = "💾 Saving…",
			Saved = "✓ Saved",
			Offline = "⚠ Not saving",
			Error = "⚠ Save failed",
		}
		saveText.Text = text[status] or ""
		saveText.TextColor3 = if status == "Offline" or status == "Error" then UI.Colors.Red else UI.Colors.Soft
	end
	player:GetAttributeChangedSignal("SaveStatus"):Connect(refreshSave)
	refreshSave()
end

local function buildNav(onNav: NavHandler)
	local nav = UI.new("Frame", {
		Name = "Nav",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(0, 74),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.Colors.Cream,
		Parent = screen,
	}, { UI.corner(20), UI.stroke(UI.Colors.Edge, 3), UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center), UI.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
	for i, item in NAV do
		local btn = UI.button({
			Name = item.id,
			Text = "",
			Color = item.color,
			Size = UDim2.fromOffset(72, 62),
			LayoutOrder = i,
			Parent = nav,
			Tooltip = item.tip,
			OnClick = function()
				onNav(item.id)
			end,
		})
		UI.label({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 2), Text = item.icon, TextSize = 26, Parent = btn })
		local label = UI.label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -22), Text = item.label, Font = UI.Font, TextSize = 14, TextColor3 = UI.Colors.White, Parent = btn })
		UI.textStroke(item.color:Lerp(Color3.new(0, 0, 0), 0.45), 1.5).Parent = label
		local badge = UI.label({
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(24, 24),
			BackgroundTransparency = 0,
			BackgroundColor3 = UI.Colors.Red,
			Text = "!",
			Font = UI.Font,
			TextSize = 15,
			TextColor3 = UI.Colors.White,
			Visible = false,
			ZIndex = 3,
			Parent = btn,
		})
		UI.corner(12).Parent = badge
		UI.stroke(UI.Colors.White, 2).Parent = badge
		navButtons[item.id] = btn
		navBadges[item.id] = badge
	end
	return nav
end

local function buildRoomBar()
	roomBar = UI.new("Frame", {
		Name = "RoomBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -92),
		Size = UDim2.fromOffset(360, 44),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	UI.button({
		Text = "◀",
		Color = UI.Colors.Blue,
		Size = UDim2.fromOffset(48, 42),
		Parent = roomBar,
		Tooltip = "Previous room",
		OnClick = function()
			State.SetRoom(State.RoomIndex - 1)
		end,
	})
	UI.button({
		Text = "▶",
		Color = UI.Colors.Blue,
		Size = UDim2.fromOffset(48, 42),
		Position = UDim2.new(1, -48, 0, 0),
		Parent = roomBar,
		Tooltip = "Next room",
		OnClick = function()
			State.SetRoom(State.RoomIndex + 1)
		end,
	})
	local plate = UI.new("Frame", { Position = UDim2.fromOffset(56, 2), Size = UDim2.new(1, -112, 1, -4), BackgroundColor3 = UI.Colors.Cream, Parent = roomBar }, { UI.corner(14), UI.stroke(UI.Colors.Edge, 3) })
	roomLabel = UI.title({ Size = UDim2.fromScale(1, 1), TextSize = 18, Text = "", Parent = plate })

	local function refresh()
		local def = Config.Rooms[State.RoomIndex]
		local plot = State.ViewPlot
		local text = def.Name
		if plot and not State.IsVisiting() and State.Profile then
			if State.HasRoom(def.Id) then
				local n = 0
				for _, pet in State.Profile.pets do
					if pet.room == def.Id then
						n += 1
					end
				end
				text = string.format("%s  (%d/%d 🐾)", def.Name, n, def.Capacity)
			else
				text = "🔒 " .. def.Name
			end
		end
		roomLabel.Text = text
	end
	State.RoomChanged:Connect(refresh)
	State.ProfileChanged:Connect(refresh)
	refresh()
end

local function buildVisitBanner()
	visitBanner = UI.new("Frame", {
		Name = "VisitBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(440, 46),
		BackgroundColor3 = Color3.fromRGB(110, 170, 150),
		Visible = false,
		Parent = screen,
	}, { UI.corner(14), UI.stroke(Color3.fromRGB(70, 120, 100), 3) })
	visitLabel = UI.title({ Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -150, 1, 0), TextSize = 18, TextColor3 = UI.Colors.White, TextXAlignment = Enum.TextXAlignment.Left, Text = "", Parent = visitBanner })
	UI.textStroke(Color3.fromRGB(60, 100, 90), 1.5).Parent = visitLabel
	UI.button({
		Text = "🏠 Go home",
		Color = UI.Colors.Pink,
		Size = UDim2.fromOffset(126, 36),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		TextSize = 16,
		Parent = visitBanner,
		OnClick = function()
			State.SetView(State.HomePlot(), 1)
		end,
	})
	State.RoomChanged:Connect(function()
		local visiting = State.IsVisiting()
		visitBanner.Visible = visiting
		if visiting and State.ViewPlot then
			visitLabel.Text = "Visiting " .. tostring(State.ViewPlot:GetAttribute("OwnerName")) .. "'s home"
		end
	end)
end

function Hud.SetVisible(visible: boolean)
	for _, name in { "StatusBar", "Nav", "RoomBar" } do
		local f = screen:FindFirstChild(name)
		if f then
			(f :: GuiObject).Visible = visible
		end
	end
end

function Hud.Init(onNav: NavHandler, onDaily: () -> ())
	screen = UI.Screen()
	toastHolder = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 124),
		Size = UDim2.fromOffset(420, 300),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = screen,
	}, { UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	buildStatusBar(onDaily)
	buildNav(onNav)
	buildRoomBar()
	buildVisitBanner()

	State.OnError = Hud.Error
	State.ProfileChanged:Connect(function(p)
		local readyBirths = 0
		local t = workspace:GetServerTimeNow()
		for _, b in p.births do
			if b.readyAt <= t then
				readyBirths += 1
			end
		end
		Hud.SetBadge("Breed", if readyBirths > 0 then tostring(readyBirths) else nil)
		Hud.SetBadge("Adopt", if not p.starterDone then "!" else nil)
		UI.SoundOn = p.settings and p.settings.sound ~= false
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">PetAnimator</string><ProtectedString name="Source"><![CDATA[-- Brings the pets in the room you're looking at to life, entirely on this
-- client: wandering, sitting, looking around, walking to the bowl or a toy,
-- eating, playing, sleeping in bed, plus hearts, bubbles and thought bubbles.
--
-- The server only says *what* a pet is doing (attributes on its model, see
-- PetService); every pose here is computed locally from the rig attributes
-- written by PetModels, so it costs no network traffic.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local PetAnimator = {}

type PartInfo = { part: BasePart, group: string, rest: CFrame, eye: boolean, eyeClosed: boolean }
type PetState = {
	model: Model,
	root: BasePart,
	parts: { PartInfo },
	joints: { [string]: CFrame },
	bodyInv: CFrame,
	height: number,
	hip: number,
	scale: number,
	pos: Vector3,
	yaw: number,
	target: Vector3?,
	targetYaw: number?,
	mode: string, -- "idle", "walk", "sit", "look", "groom"
	modeUntil: number,
	phase: number,
	stride: number,
	blinkAt: number,
	lastActionId: number,
	lastTeleport: number,
	thoughtAt: number,
	bubble: BillboardGui,
	bubbleText: TextLabel,
	bubbleUntil: number,
	nameTag: BillboardGui,
	gift: BillboardGui?,
	effectAt: number,
	room: string,
	toy: Model?,
	toyPivot: CFrame?,
}

local pets: { [Model]: PetState } = {}
local hovered: Model? = nil
local highlight: Highlight
local giftFolder: Folder

-- Called when the player clicks a coin gift above a pet.
PetAnimator.OnGiftClicked = function(_model: Model) end

local W, D = Config.Room.Width, Config.Room.Depth

local function now(): number
	return workspace:GetServerTimeNow()
end

local function roomFloor(model: Model): CFrame
	local plot = model.Parent and model.Parent.Parent :: Model
	local roomId = model:GetAttribute("Room") :: string
	local _, order = Config.RoomById(roomId)
	return State.RoomCFrame(plot, order or 1)
end

local function randomSpot(model: Model): Vector3
	local floor = roomFloor(model)
	local x = (math.random() - 0.5) * (W - 5)
	local z = (math.random() - 0.5) * (D - 6) + 0.5
	return (floor * CFrame.new(x, 0, z)).Position
end

local function clampToRoom(model: Model, p: Vector3): Vector3
	local floor = roomFloor(model)
	local l = floor:PointToObjectSpace(p)
	local x = math.clamp(l.X, -W / 2 + 1.5, W / 2 - 1.5)
	local z = math.clamp(l.Z, -D / 2 + 1.5, D / 2 - 1)
	return (floor * CFrame.new(x, 0, z)).Position
end

local function findFurniture(model: Model, uid: string): Model?
	if uid == "" then
		return nil
	end
	local plot = model.Parent and model.Parent.Parent
	local rooms = plot and plot:FindFirstChild("Rooms")
	if not rooms then
		return nil
	end
	for _, room in rooms:GetChildren() do
		local f = room:FindFirstChild("Furniture")
		local item = f and f:FindFirstChild(uid)
		if item then
			return item :: Model
		end
	end
	return nil
end

-- Where a sleeping pet lies on each kind of bed (relative to the bed's pivot).
local SLEEP_SPOTS = {
	pet_bed = Vector3.new(0, 0.95, 0),
	cushion = Vector3.new(0, 0.55, 0),
	sofa = Vector3.new(-1.2, 1.4, 0.15),
	dog_house = Vector3.new(0, 0, 2.6),
}

local function bubbleGui(parent: BasePart, height: number): (BillboardGui, TextLabel)
	local gui = UI.new("BillboardGui", {
		Name = "Bubble",
		Size = UDim2.fromOffset(64, 56),
		StudsOffsetWorldSpace = Vector3.new(0, height * 0.5 + 1.6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		LightInfluence = 0,
		Adornee = parent,
		Parent = parent,
	})
	local frame = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.Colors.White,
		Parent = gui,
	}, { UI.corner(24), UI.stroke(UI.Colors.Edge, 2) })
	local text = UI.label({ Size = UDim2.fromScale(1, 1), TextScaled = true, Text = "", Parent = frame, Font = UI.Font })
	return gui, text
end

local function nameTagGui(model: Model, root: BasePart, height: number): BillboardGui
	local gui = UI.new("BillboardGui", {
		Name = "NameTag",
		Size = UDim2.fromOffset(160, 26),
		StudsOffsetWorldSpace = Vector3.new(0, height * 0.5 + 0.6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		LightInfluence = 0,
		Adornee = root,
		Parent = root,
	})
	local label = UI.label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = UI.Font,
		TextSize = 18,
		TextColor3 = UI.Colors.White,
		Parent = gui,
	})
	UI.textStroke(UI.Colors.Ink, 2).Parent = label
	local function refresh()
		local g = model:GetAttribute("Gender")
		label.Text = tostring(model:GetAttribute("Name") or "") .. (if g == "F" then " ♀" elseif g == "M" then " ♂" else "")
	end
	model:GetAttributeChangedSignal("Name"):Connect(refresh)
	refresh()
	return gui
end

local function giftGui(state: PetState): BillboardGui
	-- Interactive billboards have to live in PlayerGui.
	local gui = UI.new("BillboardGui", {
		Name = "Gift_" .. state.model.Name,
		Size = UDim2.fromOffset(52, 52),
		StudsOffsetWorldSpace = Vector3.new(0, state.height * 0.5 + 1.4, 0),
		AlwaysOnTop = true,
		Active = true,
		LightInfluence = 0,
		Adornee = state.root,
		Parent = giftFolder,
	})
	local btn = UI.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.Colors.Yellow,
		Text = "🪙",
		TextScaled = true,
		Font = UI.Font,
		Parent = gui,
	}, { UI.corner(26), UI.stroke(Color3.fromRGB(200, 140, 30), 3) })
	btn.Activated:Connect(function()
		PetAnimator.OnGiftClicked(state.model)
	end)
	UI.tooltip(btn, "Collect gift")
	return gui
end

local function track(model: Model)
	if pets[model] then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root") :: BasePart?
	if not root then
		return
	end
	local joints = {}
	for name, value in model:GetAttributes() do
		if string.sub(name, 1, 6) == "Joint_" and typeof(value) == "CFrame" then
			joints[string.sub(name, 7)] = value
		end
	end
	local parts = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p ~= root then
			local group = p:GetAttribute("Group")
			local rest = p:GetAttribute("Rest")
			if typeof(group) == "string" and typeof(rest) == "CFrame" and joints[group] then
				table.insert(parts, { part = p, group = group, rest = rest, eye = p:GetAttribute("Eye") == true, eyeClosed = p:GetAttribute("EyeClosed") == true })
			end
		end
	end
	local height = (root:GetAttribute("Height") :: number?) or root.Size.Y
	local pivot = model:GetPivot()
	local look = pivot.LookVector
	local bubble, bubbleText = bubbleGui(root, height)
	local state: PetState = {
		model = model,
		root = root,
		parts = parts,
		joints = joints,
		bodyInv = (joints.Body or CFrame.identity):Inverse(),
		height = height,
		hip = if joints.LegFL then joints.LegFL.Position.Y else 0.8,
		scale = height / 3.2,
		pos = pivot.Position,
		yaw = math.atan2(-look.X, -look.Z),
		target = nil,
		mode = "idle",
		modeUntil = os.clock() + math.random() * 2,
		phase = math.random() * 6,
		stride = 0,
		blinkAt = os.clock() + 2 + math.random() * 3,
		lastActionId = (model:GetAttribute("ActionId") :: number?) or 0,
		lastTeleport = (model:GetAttribute("Teleport") :: number?) or 0,
		thoughtAt = os.clock() + 4 + math.random() * 6,
		bubble = bubble,
		bubbleText = bubbleText,
		bubbleUntil = 0,
		nameTag = nameTagGui(model, root, height),
		gift = nil,
		effectAt = 0,
		room = model:GetAttribute("Room") :: string,
		toy = nil,
		toyPivot = nil,
	}
	pets[model] = state
end

local function untrack(model: Model)
	local state = pets[model]
	if state then
		if state.gift then
			state.gift:Destroy()
		end
		if state.toy and state.toyPivot and state.toy.Parent then
			state.toy:PivotTo(state.toyPivot)
		end
		pets[model] = nil
	end
end

function PetAnimator.Bubble(model: Model, text: string, seconds: number?)
	local state = pets[model]
	if not state then
		return
	end
	state.bubbleText.Text = text
	state.bubble.Enabled = true
	state.bubbleUntil = os.clock() + (seconds or 2)
end

-- Floating particles (hearts, bubbles, sparkles) rising from a pet.
local function burst(state: PetState, symbols: { string }, count: number)
	for i = 1, count do
		task.delay((i - 1) * 0.12, function()
			if not state.root.Parent then
				return
			end
			local gui = UI.new("BillboardGui", {
				Size = UDim2.fromOffset(34, 34),
				StudsOffsetWorldSpace = Vector3.new((math.random() - 0.5) * 2 * state.scale, state.height * 0.3, (math.random() - 0.5) * 1.2),
				AlwaysOnTop = true,
				LightInfluence = 0,
				Adornee = state.root,
				Parent = state.root,
			})
			local label = UI.label({ Size = UDim2.fromScale(1, 1), Text = symbols[math.random(1, #symbols)], TextScaled = true, Parent = gui })
			local info = TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(gui, info, { StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }):Play()
			TweenService:Create(label, info, { TextTransparency = 1 }):Play()
			task.delay(1.35, function()
				gui:Destroy()
			end)
		end)
	end
end

function PetAnimator.Hearts(model: Model)
	local state = pets[model]
	if state then
		burst(state, { "💕", "💖", "❤️" }, 5)
	end
end

function PetAnimator.WorldPosition(model: Model): Vector3?
	local state = pets[model]
	if state then
		return state.pos + Vector3.new(0, state.height, 0)
	end
	return model:GetPivot().Position
end

function PetAnimator.SetHover(model: Model?)
	hovered = model
end

---------------------------------------------------------------------------
-- Behaviour
---------------------------------------------------------------------------

local ACTION_EFFECTS = {
	Pet = { "💕", "💖", "❤️" },
	Love = { "💕", "💗", "💞" },
	Bath = { "🫧", "🫧", "💧" },
	Brush = { "✨", "⭐" },
	Treat = { "😋", "⭐" },
	Medicine = { "💊", "✨" },
	Eat = { "😋" },
	Play = { "🎵", "⭐", "💫" },
}

local function actionGoal(state: PetState, action: string, target: Model?): (Vector3?, Vector3?)
	if not target then
		return nil, nil
	end
	local pivot = target:GetPivot()
	local item = target:GetAttribute("Item") :: string
	local def = Config.Items[item]
	local radius = if def then math.max(def.Footprint[1], def.Footprint[2]) * Config.Room.Cell * 0.5 else 1
	-- Stand at the edge of the item, on the side nearest the pet.
	local away = state.pos - pivot.Position
	away = Vector3.new(away.X, 0, away.Z)
	if away.Magnitude < 0.1 then
		away = Vector3.new(0, 0, 1)
	end
	local stand = pivot.Position + away.Unit * (radius + state.scale * 1.1)
	return clampToRoom(state.model, Vector3.new(stand.X, pivot.Position.Y, stand.Z)), pivot.Position
end

local function sleepSpot(state: PetState, bed: Model?): Vector3?
	if not bed then
		return nil
	end
	local item = bed:GetAttribute("Item") :: string
	local offset = SLEEP_SPOTS[item]
	local pivot = bed:GetPivot()
	if offset then
		return pivot:PointToWorldSpace(offset)
	end
	local cf, size = bed:GetBoundingBox()
	return Vector3.new(cf.Position.X, cf.Position.Y + size.Y / 2 - 0.2, cf.Position.Z)
end

local function walkTo(state: PetState, target: Vector3, dt: number, speed: number): boolean
	local delta = target - state.pos
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local dist = flat.Magnitude
	if dist < 0.15 then
		state.pos = Vector3.new(target.X, target.Y, target.Z)
		return true
	end
	local step = math.min(dist, speed * dt)
	local dir = flat.Unit
	state.pos += dir * step
	-- Hop down from a bed straight away, but up onto one only when close.
	if dist < 2.2 or target.Y < state.pos.Y then
		state.pos = Vector3.new(state.pos.X, state.pos.Y + (target.Y - state.pos.Y) * math.min(1, dt * 6), state.pos.Z)
	end
	state.targetYaw = math.atan2(-dir.X, -dir.Z)
	state.stride = math.min(1, state.stride + dt * 5)
	state.phase += dt * speed * 2.4 / math.max(state.scale, 0.5)
	return false
end

local function turnTo(state: PetState, yaw: number, dt: number)
	local diff = (yaw - state.yaw + math.pi) % (2 * math.pi) - math.pi
	state.yaw += diff * math.min(1, dt * 8)
end

local function cameraYaw(state: PetState): number
	local cam = workspace.CurrentCamera.CFrame.Position
	local d = cam - state.pos
	return math.atan2(-d.X, -d.Z)
end

-- Returns the pose name for this frame and moves the pet.
local function behave(state: PetState, dt: number, t: number): string
	local model = state.model
	local clock = os.clock()

	-- Teleports (moved to another room) snap instantly.
	local tp = (model:GetAttribute("Teleport") :: number?) or 0
	if tp ~= state.lastTeleport then
		state.lastTeleport = tp
		state.pos = model:GetPivot().Position
		state.target = nil
		state.mode = "idle"
	end
	if model:GetAttribute("Room") ~= state.room then
		state.room = model:GetAttribute("Room") :: string
		state.pos = clampToRoom(model, model:GetPivot().Position)
	end

	local speedFactor = 0.6 + 0.4 * (((model:GetAttribute("Mood") :: number?) or 70) / 100)
	local walkSpeed = 5 * speedFactor * math.max(0.7, state.scale)

	-- Actions requested by the server take priority.
	local action = model:GetAttribute("Action") :: string
	local actionEnd = (model:GetAttribute("ActionEnd") :: number?) or 0
	local actionId = (model:GetAttribute("ActionId") :: number?) or 0
	if actionId ~= state.lastActionId then
		state.lastActionId = actionId
		state.effectAt = 0
		if action == "Eat" then
			PetAnimator.Bubble(model, "🍽️", 1.5)
		end
	end
	if action ~= "" and actionEnd > now() then
		local target = findFurniture(model, model:GetAttribute("ActionTarget") :: string)
		local stand, look = actionGoal(state, action, target)
		if stand and not walkTo(state, stand, dt, walkSpeed * 1.4) then
			return "walk"
		end
		if look then
			local d = look - state.pos
			turnTo(state, math.atan2(-d.X, -d.Z), dt)
		elseif action == "Pet" or action == "Love" or action == "Treat" or action == "Medicine" then
			turnTo(state, cameraYaw(state), dt)
		end
		if action == "Play" and target and target ~= state.toy then
			state.toy = target
			state.toyPivot = target:GetPivot()
		end
		local fx = ACTION_EFFECTS[action]
		if fx and clock >= state.effectAt then
			state.effectAt = clock + (if action == "Bath" then 0.6 else 1.4)
			burst(state, fx, if action == "Pet" or action == "Love" then 3 else 2)
		end
		state.stride = math.max(0, state.stride - dt * 5)
		return action
	end
	if state.toy then
		if state.toy.Parent and state.toyPivot then
			state.toy:PivotTo(state.toyPivot)
		end
		state.toy, state.toyPivot = nil, nil
	end

	-- Sleeping: walk to bed (if any) and curl up.
	if model:GetAttribute("Sleeping") then
		local bed = findFurniture(model, (model:GetAttribute("SleepTarget") :: string?) or "")
		local spot = sleepSpot(state, bed)
		if spot and not walkTo(state, spot, dt, walkSpeed) then
			return "walk"
		end
		state.stride = math.max(0, state.stride - dt * 5)
		if clock >= state.effectAt then
			state.effectAt = clock + 2.2
			burst(state, { "💤" }, 1)
		end
		return "sleep"
	end
	-- Woke up on a bed: hop down.
	local floorY = roomFloor(model).Position.Y
	if state.pos.Y > floorY + 0.05 and not state.target then
		state.target = clampToRoom(model, state.pos + Vector3.new(0, 0, 2.5))
		state.mode = "walk"
	end

	-- Thought bubble when a need is low.
	local low = model:GetAttribute("Low") :: string?
	if low and low ~= "" and clock >= state.thoughtAt then
		state.thoughtAt = clock + 9 + math.random() * 6
		local info = Config.NeedInfo[low]
		if info then
			PetAnimator.Bubble(model, info.Icon, 2.5)
		end
	end

	-- Wandering.
	if state.mode == "walk" and state.target then
		if walkTo(state, state.target, dt, walkSpeed) then
			state.target = nil
			local r = math.random()
			state.mode = if r < 0.35 then "sit" elseif r < 0.6 then "look" elseif r < 0.75 then "groom" else "idle"
			state.modeUntil = clock + 2 + math.random() * 5
		end
		return "walk"
	end
	state.stride = math.max(0, state.stride - dt * 5)
	if clock >= state.modeUntil then
		if model == State.SelectedPet and math.random() < 0.6 then
			-- Selected pets tend to stay put and look at you.
			state.mode = "look"
			state.targetYaw = cameraYaw(state)
			state.modeUntil = clock + 3
		else
			state.mode = "walk"
			state.target = randomSpot(model)
		end
	end
	if model == State.SelectedPet then
		turnTo(state, cameraYaw(state), dt * 0.5)
	end
	return state.mode
end

---------------------------------------------------------------------------
-- Posing
---------------------------------------------------------------------------

local partsBuffer: { BasePart } = {}
local cframeBuffer: { CFrame } = {}

local function pose(state: PetState, poseName: string, t: number, dt: number)
	if state.targetYaw then
		turnTo(state, state.targetYaw, dt)
	end
	local s = state.scale
	local swing = math.sin(state.phase) * math.rad(32) * state.stride
	local lift = 0
	local body = CFrame.identity
	local head = CFrame.identity
	local tail = CFrame.Angles(0, math.sin(t * 3) * 0.25, 0)
	local legs = {
		LegFL = CFrame.Angles(swing, 0, 0),
		LegBR = CFrame.Angles(swing, 0, 0),
		LegFR = CFrame.Angles(-swing, 0, 0),
		LegBL = CFrame.Angles(-swing, 0, 0),
	}
	local eyesClosed = false

	if poseName == "walk" then
		body = CFrame.new(0, math.abs(math.sin(state.phase)) * 0.12 * s, 0)
		head = CFrame.Angles(math.sin(state.phase * 2) * 0.04, 0, 0)
		tail = CFrame.Angles(0.15, math.sin(t * 6) * 0.4, 0)
	elseif poseName == "sit" then
		local drop = state.hip * 0.35
		body = CFrame.new(0, -drop, 0.15 * s) * CFrame.Angles(math.rad(22), 0, 0)
		legs.LegBL = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(75), 0, 0)
		legs.LegBR = legs.LegBL
		legs.LegFL = CFrame.Angles(math.rad(-8), 0, 0)
		legs.LegFR = legs.LegFL
		head = CFrame.Angles(math.rad(-18), math.sin(t * 0.7) * 0.3, 0)
		lift = -drop * 0.6
		tail = CFrame.Angles(-0.4, math.sin(t * 1.5) * 0.5, 0)
	elseif poseName == "look" then
		head = CFrame.Angles(math.sin(t * 0.9) * 0.1, math.sin(t * 1.1) * 0.6, math.sin(t * 0.8) * 0.15)
	elseif poseName == "groom" then
		head = CFrame.Angles(math.rad(-35) + math.sin(t * 8) * 0.12, 0.6, 0.3)
		legs.LegFL = CFrame.Angles(math.rad(-50), 0, 0)
	elseif poseName == "sleep" then
		local drop = state.hip * 0.85
		lift = -drop
		body = CFrame.Angles(0, 0, 0.08)
		legs.LegFL = CFrame.Angles(math.rad(80), 0, 0)
		legs.LegFR = legs.LegFL
		legs.LegBL = CFrame.Angles(math.rad(-80), 0, 0)
		legs.LegBR = legs.LegBL
		head = CFrame.new(0, -0.35 * s, -0.1 * s) * CFrame.Angles(math.rad(-12), 0.35, 0.3)
		tail = CFrame.Angles(0.5, 1.1, 0)
		eyesClosed = true
		-- Gentle breathing.
		body = body * CFrame.new(0, math.sin(t * 1.6) * 0.04 * s, 0)
	elseif poseName == "Eat" then
		body = CFrame.Angles(math.rad(-10), 0, 0)
		head = CFrame.Angles(math.rad(-38) + math.sin(t * 10) * 0.12, 0, 0)
		tail = CFrame.Angles(0.2, math.sin(t * 8) * 0.5, 0)
	elseif poseName == "Play" then
		local hop = math.abs(math.sin(t * 5.5))
		lift = hop * 1.1 * s
		state.yaw += dt * 2.2
		legs.LegFL = CFrame.Angles(math.rad(-40) * hop, 0, 0)
		legs.LegFR = legs.LegFL
		tail = CFrame.Angles(0.3, math.sin(t * 12) * 0.6, 0)
		if state.toy and state.toyPivot and state.toy.Parent then
			local bounce = math.abs(math.sin(t * 5.5 + 1.2)) * 1.2
			state.toy:PivotTo(state.toyPivot * CFrame.new(0, bounce, 0) * CFrame.Angles(0, t * 3, 0))
		end
	elseif poseName == "Pet" or poseName == "Love" or poseName == "Treat" or poseName == "Medicine" then
		local hop = math.max(0, math.sin(t * 7))
		lift = hop * 0.35 * s
		head = CFrame.Angles(math.rad(10), 0, math.sin(t * 3) * 0.3)
		tail = CFrame.Angles(0.4, math.sin(t * 16) * 0.7, 0)
		eyesClosed = poseName == "Pet" and math.sin(t * 2) > 0
	elseif poseName == "Bath" or poseName == "Brush" then
		body = CFrame.Angles(0, 0, math.sin(t * 9) * 0.12)
		head = CFrame.Angles(0, math.sin(t * 9) * 0.3, 0)
		tail = CFrame.Angles(0.2, math.sin(t * 14) * 0.6, 0)
	else
		-- Idle: breathing and the odd tail flick.
		body = CFrame.new(0, math.sin(t * 2) * 0.03 * s, 0)
		head = CFrame.Angles(0, math.sin(t * 0.5) * 0.15, 0)
	end

	-- Blinking.
	local clock = os.clock()
	if not eyesClosed and clock >= state.blinkAt then
		eyesClosed = true
		if clock >= state.blinkAt + 0.14 then
			state.blinkAt = clock + 2 + math.random() * 4
		end
	end

	local ground = CFrame.new(state.pos) * CFrame.Angles(0, state.yaw, 0) * CFrame.new(0, lift, 0)
	local bodyWorld = ground * (state.joints.Body or CFrame.identity) * body
	local groupCF: { [string]: CFrame } = {
		Body = bodyWorld,
		Head = bodyWorld * state.bodyInv * (state.joints.Head or CFrame.identity) * head,
		Tail = bodyWorld * state.bodyInv * (state.joints.Tail or CFrame.identity) * tail,
	}
	for _, leg in { "LegFL", "LegFR", "LegBL", "LegBR" } do
		if state.joints[leg] then
			groupCF[leg] = ground * state.joints[leg] * legs[leg]
		end
	end

	local n = 0
	for _, info in state.parts do
		local cf = groupCF[info.group]
		if cf then
			n += 1
			partsBuffer[n] = info.part
			cframeBuffer[n] = cf * info.rest
		end
		if info.eye or info.eyeClosed then
			local hidden = if info.eye then eyesClosed else not eyesClosed
			local want = if hidden then 1 else 0
			if info.part.Transparency ~= want then
				info.part.Transparency = want
			end
		end
	end
	n += 1
	partsBuffer[n] = state.root
	cframeBuffer[n] = CFrame.new(state.pos) * CFrame.Angles(0, state.yaw, 0) * CFrame.new(0, state.height / 2, 0)
	for i = #partsBuffer, n + 1, -1 do
		partsBuffer[i] = nil
		cframeBuffer[i] = nil
	end
	workspace:BulkMoveTo(partsBuffer, cframeBuffer, Enum.BulkMoveMode.FireCFrameChanged)
end

---------------------------------------------------------------------------

local function petsFolder(): Folder?
	local plot = State.ViewPlot
	return plot and plot:FindFirstChild("Pets") :: Folder?
end

local watchedFolder: Folder? = nil
local folderConns: { RBXScriptConnection } = {}

local function watch(folder: Folder?)
	if folder == watchedFolder then
		return
	end
	for _, c in folderConns do
		c:Disconnect()
	end
	table.clear(folderConns)
	for model in pets do
		untrack(model)
	end
	watchedFolder = folder
	if not folder then
		return
	end
	for _, m in folder:GetChildren() do
		if m:IsA("Model") then
			track(m)
		end
	end
	table.insert(folderConns, folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			-- Parts and attributes replicate with the model; give them a frame.
			task.defer(track, m)
		end
	end))
	table.insert(folderConns, folder.ChildRemoved:Connect(function(m)
		untrack(m :: Model)
	end))
end

function PetAnimator.Init()
	giftFolder = UI.new("Folder", { Name = "PetGifts", Parent = player:WaitForChild("PlayerGui") })
	highlight = UI.new("Highlight", {
		Name = "PetSelection",
		FillTransparency = 1,
		OutlineColor = Color3.fromRGB(255, 120, 180),
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Parent = workspace,
	})
	State.SelectionChanged:Connect(function(model)
		highlight.Adornee = model
	end)
	State.RoomChanged:Connect(function()
		watch(petsFolder())
	end)

	RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 0.1)
		watch(petsFolder())
		local t = os.clock()
		local own = State.ViewPlot == State.HomePlot()
		local roomId = State.RoomId()
		for model, state in pets do
			if not model.Parent or not state.root.Parent then
				untrack(model)
				continue
			end
			-- Only animate pets in (or next to) the room on screen.
			local _, roomIdx = Config.RoomById(model:GetAttribute("Room") :: string)
			roomIdx = roomIdx or 1
			if math.abs(roomIdx - State.RoomIndex) <= 1 then
				local poseName = behave(state, dt, t)
				pose(state, poseName, t + state.phase * 0.1, dt)
			end
			state.nameTag.Enabled = model == hovered or model == State.SelectedPet
			if state.bubble.Enabled and t >= state.bubbleUntil then
				state.bubble.Enabled = false
			end
			-- Coin gifts only for your own pets in the room you're looking at.
			local wantsGift = own and model:GetAttribute("Gift") == true and model:GetAttribute("Room") == roomId and not State.Decorating
			if wantsGift and not state.gift then
				state.gift = giftGui(state)
			elseif not wantsGift and state.gift then
				state.gift:Destroy()
				state.gift = nil
			end
			if state.gift then
				state.gift.StudsOffsetWorldSpace = Vector3.new(0, state.height * 0.5 + 1.4 + math.sin(t * 3) * 0.25, 0)
			end
		end
	end)
end

return PetAnimator
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">PetPanel</string><ProtectedString name="Source"><![CDATA[-- The panel that opens when you click a pet: portrait, needs, mood and the
-- care actions. Visitors get a smaller panel with just "Pet".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetRules = require(Shared:WaitForChild("PetRules"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))

local PetPanel = {}

local panel: Frame
local portrait: ViewportFrame
local nameLabel: TextLabel
local infoLabel: TextLabel
local moodLabel: TextLabel
local needBars: { [string]: (number, string?) -> () } = {}
local needsFrame: Frame
local actionsFrame: Frame
local popup: Frame? = nil
local buttons: { [string]: TextButton } = {}
local current: Model? = nil

-- Set by the client: opens the shop on a tab, opens the rename dialog.
PetPanel.OpenShop = function(_tab: string) end
PetPanel.Rename = function(_petId: string, _name: string) end

local function closePopup()
	if popup then
		popup:Destroy()
		popup = nil
	end
end

local function petId(): string?
	return current and current:GetAttribute("PetId") :: string?
end

local function care(action: string, extra: { [string]: any }?)
	local id = petId()
	if not id then
		return
	end
	local payload = { petId = id, action = action }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	closePopup()
	State.Request("Care", payload)
end

-- A small list of choices beside the panel.
local function openPopup(title: string, entries: { { text: string, onClick: () -> (), color: Color3? } }, emptyText: string?, emptyAction: { text: string, onClick: () -> () }?)
	closePopup()
	local frame = UI.new("Frame", {
		Name = "Popup",
		Position = UDim2.new(1, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(210, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Colors.Cream,
		Parent = panel,
	}, { UI.corner(14), UI.stroke(UI.Colors.Edge, 3), UI.padding(8), UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	UI.title({ Text = title, Size = UDim2.new(1, 0, 0, 24), TextSize = 18, LayoutOrder = 0, Parent = frame })
	for i, e in entries do
		UI.button({ Text = e.text, Color = e.color or UI.Colors.Blue, Size = UDim2.new(1, 0, 0, 36), TextSize = 15, LayoutOrder = i, Parent = frame, OnClick = e.onClick })
	end
	if #entries == 0 then
		UI.label({ Text = emptyText or "Nothing here.", Size = UDim2.new(1, 0, 0, 40), TextSize = 14, LayoutOrder = 1, Parent = frame })
		if emptyAction then
			UI.button({ Text = emptyAction.text, Color = UI.Colors.Orange, Size = UDim2.new(1, 0, 0, 36), TextSize = 15, LayoutOrder = 2, Parent = frame, OnClick = emptyAction.onClick })
		end
	end
	UI.button({ Text = "Close", Color = UI.Colors.Gray, Size = UDim2.new(1, 0, 0, 30), TextSize = 14, LayoutOrder = 99, Parent = frame, OnClick = closePopup })
	popup = frame
end

local function itemPopup(actions: { string }, title: string, shopTab: string)
	local entries = {}
	local inventory = State.Profile and State.Profile.inventory or {}
	local ids = {}
	for itemId, count in inventory do
		local item = Config.Items[itemId]
		if item and item.Kind == "Consumable" and table.find(actions, item.Action) and count > 0 then
			table.insert(ids, itemId)
		end
	end
	table.sort(ids, function(a, b)
		return Config.Items[a].Price < Config.Items[b].Price
	end)
	local data = State.PetData(petId() or "")
	local favorite = data and Config.Species[data.species] and Config.Species[data.species].Favorite
	for _, itemId in ids do
		local item = Config.Items[itemId]
		local star = if itemId == favorite then " ⭐" else ""
		table.insert(entries, {
			text = string.format("%s %s ×%d%s", item.Icon, item.Name, inventory[itemId], star),
			onClick = function()
				care("UseItem", { itemId = itemId })
			end,
		})
	end
	openPopup(title, entries, "You don't have any. Buy some in the shop!", {
		text = "🛍️ Go to shop",
		onClick = function()
			closePopup()
			PetPanel.OpenShop(shopTab)
		end,
	})
end

local function movePopup()
	local data = State.PetData(petId() or "")
	if not data or not State.Profile then
		return
	end
	local entries = {}
	for _, room in State.Profile.rooms do
		local def = Config.RoomById(room.id)
		if def and room.id ~= data.room then
			local n = 0
			for _, p in State.Profile.pets do
				if p.room == room.id then
					n += 1
				end
			end
			table.insert(entries, {
				text = string.format("%s (%d/%d)", def.Name, n, def.Capacity),
				color = if n >= def.Capacity then UI.Colors.Gray else UI.Colors.Green,
				onClick = function()
					closePopup()
					local id = petId()
					local result = State.Request("MovePet", { petId = id, roomId = room.id })
					if result.ok then
						local _, order = Config.RoomById(room.id)
						State.SetRoom(order)
						-- Keep the moved pet selected.
						local plot = State.HomePlot()
						local model = plot and id and (plot:FindFirstChild("Pets") :: Folder):FindFirstChild(id)
						if model then
							State.Select(model :: Model)
						end
					end
				end,
			})
		end
	end
	openPopup("Move to…", entries, "Unlock more rooms to move pets around.")
end

local function setPortrait(model: Model)
	portrait:ClearAllChildren()
	local clone = model:Clone()
	for _, d in clone:GetDescendants() do
		if d:IsA("BillboardGui") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	-- Pets face -Z; the portrait camera looks from -Z, turned a little for a 3/4 view.
	clone:PivotTo(CFrame.Angles(0, math.rad(25), 0))
	clone.Parent = portrait
	local root = clone.PrimaryPart
	local h = if root then ((root:GetAttribute("Height") :: number?) or root.Size.Y) else 3
	local cam = UI.new("Camera", { FieldOfView = 30, Parent = portrait })
	cam.CFrame = CFrame.lookAt(Vector3.new(0, h * 0.62, -h * 3.2), Vector3.new(0, h * 0.5, 0))
	portrait.CurrentCamera = cam
end

local function actionButton(id: string, text: string, color: Color3, order: number, tip: string, onClick: () -> ())
	buttons[id] = UI.button({ Name = id, Text = text, Color = color, Size = UDim2.fromOffset(112, 34), TextSize = 15, LayoutOrder = order, Parent = actionsFrame, Tooltip = tip, OnClick = onClick })
end

local function refresh()
	local model = current
	if not model then
		return
	end
	local visiting = State.IsVisiting()
	local data = if visiting then nil else State.PetData(model:GetAttribute("PetId") :: string)
	local gender = model:GetAttribute("Gender")
	nameLabel.Text = (model:GetAttribute("Name") or "?") .. (if gender == "F" then " ♀" else " ♂")
	nameLabel.TextColor3 = if gender == "F" then Color3.fromRGB(230, 90, 150) else Color3.fromRGB(70, 130, 220)
	local mood = (model:GetAttribute("Mood") :: number?) or 0
	local moodText, moodIcon = PetRules.MoodLabel(mood)
	moodLabel.Text = moodIcon .. " " .. moodText .. (if model:GetAttribute("Sleeping") then " · Sleeping 💤" else "")

	if data then
		local rarity = PetRules.Rarity(data.species, data)
		infoLabel.Text = string.format("%s %s · %s%s", data.color, PetRules.DisplaySpecies(data), data.pattern, if rarity == "Rare" then " · ✨Rare" else "")
		for _, need in Config.Needs do
			local v = data.needs[need] or 0
			needBars[need](v / 100, string.format("%s %d%%", Config.NeedInfo[need].Label, math.floor(v + 0.5)))
		end
		needsFrame.Visible = true
		local now = workspace:GetServerTimeNow()
		local sleeping = data.sleeping
		for id, btn in buttons do
			btn.Visible = id ~= "Visit"
		end
		buttons.Sleep.Text = if sleeping then "☀️ Wake" else "💤 Sleep"
		for _, action in { "Play", "Brush" } do
			local left = PetRules.CooldownLeft(data, action, now)
			local label = if action == "Play" then "🎾 Play" else "🪮 Brush"
			buttons[action].Text = if left > 0 then string.format("%s %ds", label, math.ceil(left)) else label
			UI.SetEnabled(buttons[action], left <= 0 and not sleeping)
		end
		for _, id in { "Feed", "Care" } do
			UI.SetEnabled(buttons[id], not sleeping)
		end
	else
		infoLabel.Text = (model:GetAttribute("Species") or "") .. (if model:GetAttribute("Stage") == "Baby" then " (baby)" else "")
		needsFrame.Visible = false
		for id, btn in buttons do
			btn.Visible = id == "Visit"
		end
	end
end

function PetPanel.Open(model: Model)
	current = model
	closePopup()
	panel.Visible = true
	setPortrait(model)
	refresh()
end

function PetPanel.Close()
	current = nil
	closePopup()
	panel.Visible = false
end

function PetPanel.Current(): Model?
	return current
end

function PetPanel.Init()
	local screen = UI.Screen()
	panel = UI.new("Frame", {
		Name = "PetPanel",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, -20),
		Size = UDim2.fromOffset(262, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UI.Colors.Cream,
		Visible = false,
		Parent = screen,
	}, { UI.corner(18), UI.stroke(UI.Colors.Edge, 4) })
	-- The panel's contents; the close button and popups sit outside the list.
	local body = UI.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = panel,
	}, { UI.padding(10), UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
	UI.button({
		Text = "✕",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(32, 32),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		TextSize = 16,
		Parent = panel,
		OnClick = function()
			State.Select(nil)
		end,
	})

	portrait = UI.new("ViewportFrame", {
		Size = UDim2.fromOffset(150, 120),
		BackgroundColor3 = Color3.fromRGB(255, 232, 240),
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.6),
		LayoutOrder = 1,
		Parent = body,
	}, { UI.corner(16), UI.stroke(Color3.fromRGB(240, 170, 200), 3) })
	nameLabel = UI.title({ Size = UDim2.new(1, 0, 0, 28), TextSize = 24, LayoutOrder = 2, Parent = body })
	infoLabel = UI.label({ Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = UI.Colors.Soft, LayoutOrder = 3, Parent = body })
	moodLabel = UI.label({ Size = UDim2.new(1, 0, 0, 20), TextSize = 16, Font = UI.Font, LayoutOrder = 4, Parent = body })

	needsFrame = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 5, Parent = body }, { UI.list(Enum.FillDirection.Vertical, 4) })
	for i, need in Config.Needs do
		local info = Config.NeedInfo[need]
		local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = i, Parent = needsFrame })
		UI.label({ Size = UDim2.fromOffset(26, 22), Text = info.Icon, TextSize = 18, Parent = row })
		local _, set = UI.bar({ Position = UDim2.fromOffset(30, 2), Size = UDim2.new(1, -32, 0, 18), Parent = row, TextSize = 12 }, info.Color)
		needBars[need] = set
	end

	actionsFrame = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 6, Parent = body }, { UI.grid(UDim2.fromOffset(116, 34), 6) })
	actionButton("Pet", "✋ Pet", UI.Colors.Pink, 1, "Give some love", function()
		care("Pet")
	end)
	actionButton("Feed", "🍖 Feed", UI.Colors.Orange, 2, "Feed food from your inventory", function()
		itemPopup({ "Feed" }, "Feed with…", "Food")
	end)
	actionButton("Play", "🎾 Play", UI.Colors.Blue, 3, "Play with a toy in this room", function()
		care("Play")
	end)
	actionButton("Brush", "🪮 Brush", Color3.fromRGB(90, 190, 210), 4, "A quick brush keeps fur clean", function()
		care("Brush")
	end)
	actionButton("Care", "🧴 Care", UI.Colors.Purple, 5, "Bath, treats and vitamins", function()
		itemPopup({ "Bath", "Treat", "Medicine" }, "Use…", "Care")
	end)
	actionButton("Sleep", "💤 Sleep", Color3.fromRGB(120, 140, 220), 6, "Send to bed or wake up", function()
		local data = State.PetData(petId() or "")
		care(if data and data.sleeping then "Wake" else "Sleep")
	end)
	actionButton("Rename", "✏️ Rename", UI.Colors.Gray, 7, "Change this pet's name", function()
		local id = petId()
		local data = id and State.PetData(id)
		if id and data then
			PetPanel.Rename(id, data.name)
		end
	end)
	actionButton("Move", "🚪 Move", UI.Colors.Green, 8, "Move to another room", movePopup)
	actionButton("Visit", "✋ Pet", UI.Colors.Pink, 9, "Pet your neighbour's pet (bonus once a day)", function()
		local model = current
		if not model then
			return
		end
		State.Request("VisitPet", { ownerId = model:GetAttribute("Owner"), petId = model:GetAttribute("PetId") })
	end)

	State.SelectionChanged:Connect(function(model)
		if model then
			PetPanel.Open(model)
		else
			PetPanel.Close()
		end
	end)
	State.ProfileChanged:Connect(refresh)
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum >= 0.5 and current then
			accum = 0
			if not current.Parent then
				State.Select(nil)
				return
			end
			refresh()
		end
	end)
end

return PetPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Client-side state shared by the UI modules: the player's profile (sent by
-- the server as JSON), which home and room the camera is looking at, the
-- selected pet, and a helper for server requests.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestRemote = remotes:WaitForChild("Request") :: RemoteFunction

local State = {}

-- Minimal signal: Connect(fn) / Fire(...).
local function signal()
	local handlers = {}
	return {
		Connect = function(_, fn)
			table.insert(handlers, fn)
			return {
				Disconnect = function()
					local i = table.find(handlers, fn)
					if i then
						table.remove(handlers, i)
					end
				end,
			}
		end,
		Fire = function(_, ...)
			for _, fn in table.clone(handlers) do
				task.spawn(fn, ...)
			end
		end,
	}
end
State.Signal = signal

State.Profile = nil :: any
State.ProfileChanged = signal()
-- The plot being viewed (own home, or a neighbour's while visiting).
State.ViewPlot = nil :: Model?
State.RoomIndex = 1
State.RoomChanged = signal()
State.SelectedPet = nil :: Model?
State.SelectionChanged = signal()
State.Decorating = false
State.DecorateChanged = signal()
State.Busy = false

function State.HomePlot(): Model?
	local name = player:GetAttribute("Plot")
	local plots = workspace:FindFirstChild("Plots")
	if not name or not plots then
		return nil
	end
	return plots:FindFirstChild(name) :: Model?
end

function State.IsVisiting(): boolean
	return State.ViewPlot ~= nil and State.ViewPlot ~= State.HomePlot()
end

function State.RoomId(): string
	return Config.Rooms[State.RoomIndex].Id
end

function State.RoomModel(): Model?
	local plot = State.ViewPlot
	if not plot then
		return nil
	end
	return (plot:FindFirstChild("Rooms") :: Folder):FindFirstChild(State.RoomId()) :: Model?
end

function State.RoomCFrame(plot: Model?, order: number): CFrame
	local p = plot or State.ViewPlot
	local origin = if p then p:GetAttribute("Origin") :: Vector3 else Vector3.zero
	return CFrame.new(origin + Vector3.new((order - 1) * Config.Room.Spacing, 0, 0))
end

function State.SetRoom(index: number)
	index = math.clamp(index, 1, #Config.Rooms)
	if index ~= State.RoomIndex then
		State.RoomIndex = index
		State.RoomChanged:Fire(index)
	end
end

function State.SetView(plot: Model?, roomIndex: number?)
	State.ViewPlot = plot
	State.RoomIndex = roomIndex or 1
	State.Select(nil)
	State.RoomChanged:Fire(State.RoomIndex)
end

function State.Select(pet: Model?)
	if State.SelectedPet ~= pet then
		State.SelectedPet = pet
		State.SelectionChanged:Fire(pet)
	end
end

-- The saved data for one of the player's own pets.
function State.PetData(petId: string): any
	return State.Profile and State.Profile.pets[petId]
end

function State.HasRoom(roomId: string): boolean
	if not State.Profile then
		return false
	end
	for _, r in State.Profile.rooms do
		if r.id == roomId then
			return true
		end
	end
	return false
end

function State.RoomData(roomId: string): any
	if not State.Profile then
		return nil
	end
	for _, r in State.Profile.rooms do
		if r.id == roomId then
			return r
		end
	end
	return nil
end

local function readProfile()
	local json = player:GetAttribute("Profile")
	if typeof(json) ~= "string" then
		return
	end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if ok and typeof(data) == "table" then
		-- JSON turns empty dictionaries into empty arrays; both iterate the same.
		data.pets = data.pets or {}
		data.inventory = data.inventory or {}
		data.styles = data.styles or {}
		data.births = data.births or {}
		State.Profile = data
		State.ProfileChanged:Fire(data)
	end
end

function State.Init()
	player:GetAttributeChangedSignal("Profile"):Connect(readProfile)
	readProfile()
end

-- Feedback hooks set by the HUD (toast for errors, click sound).
State.OnError = function(_msg: string) end
State.OnRequest = function() end

-- Calls the server. Shows the error message (if any) and returns the result.
function State.Request(name: string, payload: any?): any
	State.OnRequest()
	local ok, result = pcall(function()
		return requestRemote:InvokeServer(name, payload or {})
	end)
	if not ok or typeof(result) ~= "table" then
		State.OnError("Couldn't reach the server. Please try again.")
		return { ok = false }
	end
	if not result.ok and result.msg then
		State.OnError(result.msg)
	end
	return result
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- UI toolkit: the cosy late-2000s browser-game look (cream panels, glossy
-- rounded buttons, chunky outlines), plus windows, bars, tooltips and sounds.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer

local UI = {}

local rgb = Color3.fromRGB
UI.Colors = {
	Cream = rgb(255, 249, 236),
	Panel = rgb(255, 244, 222),
	Edge = rgb(196, 140, 120),
	Ink = rgb(92, 64, 70),
	Soft = rgb(150, 120, 120),
	Pink = rgb(246, 120, 166),
	Blue = rgb(92, 168, 240),
	Green = rgb(110, 196, 110),
	Yellow = rgb(250, 196, 60),
	Purple = rgb(170, 130, 230),
	Orange = rgb(250, 150, 70),
	Gray = rgb(186, 180, 186),
	Red = rgb(232, 90, 90),
	White = rgb(255, 255, 255),
}
UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamMedium

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or UI.Colors.Edge, Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.textStroke(color: Color3?, thickness: number?): UIStroke
	return UI.new("UIStroke", { Color = color or UI.Colors.Ink, Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function UI.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return UI.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function UI.list(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.grid(cell: UDim2, padding: number?): UIGridLayout
	return UI.new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(props: { [string]: any }): TextLabel
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = UI.BodyFont,
		TextColor3 = UI.Colors.Ink,
		TextSize = 16,
		TextWrapped = true,
	}
	for k, v in props do
		base[k] = v
	end
	return UI.new("TextLabel", base)
end

function UI.title(props: { [string]: any }): TextLabel
	props.Font = props.Font or UI.Font
	props.TextSize = props.TextSize or 22
	return UI.label(props)
end

---------------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------------

local SOUNDS = {
	Click = "rbxasset://sounds/button.wav",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Pop = "rbxasset://sounds/clickfast.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
}
UI.SoundOn = true
local soundCache: { [string]: Sound } = {}

function UI.Play(name: string, volume: number?)
	if not UI.SoundOn then
		return
	end
	local s = soundCache[name]
	if not s then
		local id = SOUNDS[name]
		if not id then
			return
		end
		s = UI.new("Sound", { SoundId = id, Volume = volume or 0.5, Parent = SoundService })
		soundCache[name] = s
	end
	(s :: Sound).PlaybackSpeed = 0.95 + math.random() * 0.1
	SoundService:PlayLocalSound(s :: Sound)
end

---------------------------------------------------------------------------
-- Buttons
---------------------------------------------------------------------------

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Parent: Instance?,
	TextSize: number?,
	LayoutOrder: number?,
	OnClick: (() -> ())?,
	Tooltip: string?,
	Name: string?,
}

-- Glossy rounded button. Call UI.SetEnabled to grey it out.
function UI.button(props: ButtonProps): TextButton
	local color = props.Color or UI.Colors.Pink
	local btn = UI.new("TextButton", {
		Name = props.Name or "Button",
		Text = props.Text,
		Font = UI.Font,
		TextSize = props.TextSize or 18,
		TextColor3 = UI.Colors.White,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		TextWrapped = true,
	}, {
		UI.corner(12),
		UI.stroke(color:Lerp(Color3.new(0, 0, 0), 0.3), 3),
		UI.textStroke(color:Lerp(Color3.new(0, 0, 0), 0.45), 1.5),
		UI.new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)),
			Rotation = 90,
		}),
		UI.new("UIScale", { Scale = 1 }),
	})
	btn:SetAttribute("BaseColor", color)
	btn:SetAttribute("Enabled", true)
	local scale = btn:FindFirstChildOfClass("UIScale") :: UIScale
	local function tween(target: number)
		TweenService:Create(scale, TweenInfo.new(0.08), { Scale = target }):Play()
	end
	btn.MouseEnter:Connect(function()
		if btn:GetAttribute("Enabled") then
			tween(1.05)
		end
	end)
	btn.MouseLeave:Connect(function()
		tween(1)
	end)
	btn.MouseButton1Down:Connect(function()
		if btn:GetAttribute("Enabled") then
			tween(0.94)
		end
	end)
	btn.MouseButton1Up:Connect(function()
		tween(1)
	end)
	if props.OnClick then
		local onClick = props.OnClick
		btn.Activated:Connect(function()
			if btn:GetAttribute("Enabled") then
				UI.Play("Click", 0.4)
				onClick()
			end
		end)
	end
	if props.Tooltip then
		UI.tooltip(btn, props.Tooltip)
	end
	if props.Parent then
		btn.Parent = props.Parent
	end
	return btn
end

function UI.SetEnabled(btn: GuiButton, enabled: boolean)
	btn:SetAttribute("Enabled", enabled)
	local base = btn:GetAttribute("BaseColor") :: Color3
	btn.BackgroundColor3 = if enabled then base else UI.Colors.Gray
	local stroke = btn:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = (if enabled then base else UI.Colors.Gray):Lerp(Color3.new(0, 0, 0), 0.3)
	end
end

---------------------------------------------------------------------------
-- Screen, tooltips and bars
---------------------------------------------------------------------------

local screen: ScreenGui
local tooltipLabel: TextLabel
local tooltipOwner: GuiObject? = nil

function UI.Screen(): ScreenGui
	return screen
end

function UI.Init()
	screen = UI.new("ScreenGui", {
		Name = "HappyPetsUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Scale everything with the window so phones and big monitors both work.
	local uiScale = UI.new("UIScale", { Parent = screen })
	local camera = workspace.CurrentCamera
	local function rescale()
		local size = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 720), 0.55, 1.25)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	tooltipLabel = UI.label({
		Name = "Tooltip",
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 0,
		BackgroundColor3 = UI.Colors.Ink,
		TextColor3 = UI.Colors.White,
		TextSize = 14,
		TextWrapped = false,
		Visible = false,
		ZIndex = 100,
		Parent = screen,
	})
	UI.corner(6).Parent = tooltipLabel
	UI.padding(6).Parent = tooltipLabel
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement and tooltipLabel.Visible then
			local scale = uiScale.Scale
			local pos = UserInputService:GetMouseLocation()
			tooltipLabel.Position = UDim2.fromOffset((pos.X + 14) / scale, (pos.Y + 4) / scale)
		end
	end)
end

function UI.UIScale(): number
	local s = screen:FindFirstChildOfClass("UIScale")
	return if s then s.Scale else 1
end

function UI.tooltip(gui: GuiObject, text: string | () -> string)
	gui.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return
		end
		tooltipOwner = gui
		tooltipLabel.Text = if typeof(text) == "function" then text() else text
		local pos = UserInputService:GetMouseLocation()
		local scale = UI.UIScale()
		tooltipLabel.Position = UDim2.fromOffset((pos.X + 14) / scale, (pos.Y + 4) / scale)
		tooltipLabel.Visible = tooltipLabel.Text ~= ""
	end)
	gui.MouseLeave:Connect(function()
		if tooltipOwner == gui then
			tooltipLabel.Visible = false
		end
	end)
	gui.AncestryChanged:Connect(function()
		if not gui:IsDescendantOf(game) and tooltipOwner == gui then
			tooltipLabel.Visible = false
		end
	end)
end

-- A rounded progress bar. Returns the frame and a setter (fraction 0..1, text).
function UI.bar(props: { [string]: any }, color: Color3): (Frame, (number, string?) -> ())
	local back = UI.new("Frame", {
		BackgroundColor3 = rgb(236, 222, 210),
		Size = props.Size or UDim2.fromOffset(160, 16),
		Position = props.Position or UDim2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { UI.corner(8), UI.stroke(UI.Colors.Edge, 2) })
	local fill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = color,
		Size = UDim2.fromScale(0.5, 1),
		Parent = back,
	}, {
		UI.corner(8),
		UI.new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), Rotation = 90 }),
	})
	local text = UI.label({
		Size = UDim2.fromScale(1, 1),
		Font = UI.Font,
		TextSize = props.TextSize or 13,
		TextColor3 = UI.Colors.White,
		ZIndex = 2,
		Parent = back,
	})
	UI.textStroke(UI.Colors.Ink, 1.5).Parent = text
	local function set(fraction: number, label: string?)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		fill.Visible = fraction > 0.01
		text.Text = label or ""
	end
	return back, set
end

---------------------------------------------------------------------------
-- Windows
---------------------------------------------------------------------------

local openWindow: Frame? = nil
local openName: string? = nil
local closeHandlers: { [Frame]: () -> () } = {}
UI.WindowChanged = nil :: any

function UI.CloseWindow()
	local w = openWindow
	if w then
		openWindow = nil
		openName = nil
		local onClose = closeHandlers[w]
		closeHandlers[w] = nil
		w.Parent:Destroy()
		if onClose then
			onClose()
		end
	end
end

function UI.OpenWindowName(): string?
	return openName
end

-- Opens a modal window (closing any other). Returns the window frame and a
-- scrolling content frame with a vertical list layout.
function UI.window(name: string, title: string, size: Vector2, onClose: (() -> ())?): (Frame, ScrollingFrame)
	UI.CloseWindow()
	-- A full-screen holder above the HUD: a dimmed backdrop that closes the
	-- window when clicked, with the window itself on top.
	local overlay = UI.new("Frame", {
		Name = "Overlay_" .. name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = screen,
	})
	local backdrop = UI.new("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = overlay,
	})
	backdrop.Activated:Connect(function()
		UI.CloseWindow()
	end)
	local scale = UI.UIScale()
	local view = workspace.CurrentCamera.ViewportSize / scale
	local w = math.min(size.X, view.X - 24)
	local h = math.min(size.Y, view.Y - 90)
	local frame = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 6),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = UI.Colors.Cream,
		ZIndex = 2,
		Active = true,
		Parent = overlay,
	}, { UI.corner(18), UI.stroke(UI.Colors.Edge, 4) })
	-- Title ribbon.
	local ribbon = UI.new("Frame", {
		Name = "Ribbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(math.min(w - 40, 320), 44),
		BackgroundColor3 = UI.Colors.Pink,
		ZIndex = 3,
		Parent = frame,
	}, {
		UI.corner(14),
		UI.stroke(rgb(200, 80, 120), 3),
		UI.new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215)), Rotation = 90 }),
	})
	local titleLabel = UI.title({ Text = title, Size = UDim2.fromScale(1, 1), TextColor3 = UI.Colors.White, TextSize = 24, Parent = ribbon })
	UI.textStroke(rgb(170, 60, 100), 2).Parent = titleLabel
	local close = UI.button({
		Name = "Close",
		Text = "✕",
		Color = UI.Colors.Red,
		Size = UDim2.fromOffset(38, 38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		TextSize = 20,
		Parent = frame,
		OnClick = UI.CloseWindow,
	})
	close.ZIndex = 4
	local content = UI.new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 1, -46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UI.Colors.Edge,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center), UI.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }) })
	openWindow = frame
	openName = name
	if onClose then
		closeHandlers[frame] = onClose
	end
	local s = UI.new("UIScale", { Scale = 0.85, Parent = frame })
	TweenService:Create(s, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	UI.Play("Pop", 0.3)
	return frame, content
end

-- A row frame for window content.
function UI.row(parent: Instance, height: number, order: number?): Frame
	return UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = order or 0,
		Parent = parent,
	})
end

-- A row of tab buttons. onSelect(tabName) is called on click; returns a
-- function that highlights the given tab.
function UI.tabs(parent: Instance, names: { string }, onSelect: (string) -> (), order: number?): (string) -> ()
	local row = UI.row(parent, 40, order)
	UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center).Parent = row
	local buttons = {}
	local function highlight(name: string)
		for n, b in buttons do
			local active = n == name
			b.BackgroundColor3 = if active then UI.Colors.Pink else UI.Colors.Blue
			b:SetAttribute("BaseColor", b.BackgroundColor3)
			local stroke = b:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Thickness = if active then 4 else 3
			end
		end
	end
	local width = math.clamp(math.floor(560 / #names) - 6, 70, 110)
	for i, n in names do
		buttons[n] = UI.button({
			Text = n,
			Color = UI.Colors.Blue,
			Size = UDim2.fromOffset(width, 36),
			TextSize = 16,
			LayoutOrder = i,
			Parent = row,
			OnClick = function()
				highlight(n)
				onSelect(n)
			end,
		})
	end
	return highlight
end

-- Simple "are you sure?" dialog.
function UI.confirm(title: string, message: string, yesText: string, onYes: () -> ())
	local _, content = UI.window("Confirm", title, Vector2.new(420, 250))
	UI.label({ Text = message, Size = UDim2.new(1, 0, 0, 80), TextSize = 18, LayoutOrder = 1, Parent = content })
	local row = UI.row(content, 48, 2)
	UI.list(Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center).Parent = row
	UI.button({ Text = "Cancel", Color = UI.Colors.Gray, Size = UDim2.fromOffset(130, 44), LayoutOrder = 1, Parent = row, OnClick = UI.CloseWindow })
	UI.button({
		Text = yesText,
		Color = UI.Colors.Green,
		Size = UDim2.fromOffset(150, 44),
		LayoutOrder = 2,
		Parent = row,
		OnClick = function()
			UI.CloseWindow()
			onYes()
		end,
	})
end

-- Lets windows know if the player is on a touch screen.
function UI.IsTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

function UI.Inset(): number
	return GuiService:GetGuiInset().Y
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Windows</string><ProtectedString name="Source"><![CDATA[-- The pop-up windows: Adopt, My Pets, Shop, Items, Breed, Rooms, Visit,
-- Settings, plus the name dialog used for adopting, babies and renaming.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetRules = require(Shared:WaitForChild("PetRules"))
local PetModels = require(Shared:WaitForChild("PetModels"))
local FurnitureModels = require(Shared:WaitForChild("FurnitureModels"))
local State = require(script.Parent:WaitForChild("State"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local Windows = {}

-- Set by the client.
Windows.StartPlacing = function(_itemId: string) end
Windows.Toast = function(_text: string) end

local rgb = Color3.fromRGB
local RARE = rgb(190, 120, 240)

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

-- A 3D preview of a model. `fromFront` is the side the camera looks from.
local function preview(parent: Instance, model: Model, size: UDim2, order: number?, fromFront: boolean?): ViewportFrame
	local vp = UI.new("ViewportFrame", {
		Size = size,
		BackgroundColor3 = rgb(255, 238, 244),
		Ambient = rgb(200, 200, 200),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, -0.5),
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(12) })
	model.Parent = vp
	local cf, extents = model:GetBoundingBox()
	local radius = extents.Magnitude * 0.5
	local dir = if fromFront then Vector3.new(0.45, 0.55, 1) else Vector3.new(0.45, 0.45, -1)
	local cam = UI.new("Camera", { FieldOfView = 32, Parent = vp })
	cam.CFrame = CFrame.lookAt(cf.Position + dir.Unit * radius * 3.1, cf.Position)
	vp.CurrentCamera = cam
	return vp
end

local function petPreview(parent: Instance, look: any, size: UDim2, order: number?): ViewportFrame
	return preview(parent, PetModels.Build(look), size, order, false)
end

local function card(parent: Instance, order: number?, color: Color3?): Frame
	return UI.new("Frame", {
		BackgroundColor3 = color or UI.Colors.Panel,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(14), UI.stroke(UI.Colors.Edge, 2) })
end

local function cardGrid(parent: Instance, cell: Vector2, order: number?): Frame
	local f = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order or 0,
		Parent = parent,
	})
	local grid = UI.grid(UDim2.fromOffset(cell.X, cell.Y), 10)
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = f
	return f
end

local function note(parent: Instance, text: string, order: number?): TextLabel
	return UI.label({ Text = text, Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 16, TextColor3 = UI.Colors.Soft, LayoutOrder = order or 0, Parent = parent })
end

local function petCount(roomId: string?): number
	local n = 0
	for _, p in (State.Profile and State.Profile.pets or {}) do
		if not roomId or p.room == roomId then
			n += 1
		end
	end
	return n
end

local function sortedPets(): { any }
	local list = {}
	for _, p in (State.Profile and State.Profile.pets or {}) do
		table.insert(list, p)
	end
	table.sort(list, function(a, b)
		return (tonumber(string.sub(a.id, 2)) or 0) < (tonumber(string.sub(b.id, 2)) or 0)
	end)
	return list
end

local function selectPet(petId: string)
	local plot = State.HomePlot()
	local model = plot and (plot:FindFirstChild("Pets") :: Folder):FindFirstChild(petId)
	local data = State.PetData(petId)
	if not model or not data then
		return
	end
	if State.IsVisiting() then
		State.SetView(plot, 1)
	end
	local _, order = Config.RoomById(data.room)
	State.SetRoom(order or 1)
	State.Select(model :: Model)
end

---------------------------------------------------------------------------
-- Name dialog
---------------------------------------------------------------------------

-- Asks for a name (and optionally boy/girl). onSubmit returns true to close.
function Windows.NameDialog(title: string, message: string, default: string, askGender: boolean, onSubmit: (string, string) -> boolean)
	local _, content = UI.window("Name", title, Vector2.new(440, if askGender then 360 else 290))
	note(content, message, 1)
	local box = UI.new("TextBox", {
		Size = UDim2.new(1, -20, 0, 46),
		BackgroundColor3 = UI.Colors.White,
		Font = UI.Font,
		TextSize = 22,
		TextColor3 = UI.Colors.Ink,
		PlaceholderText = "Type a name",
		PlaceholderColor3 = UI.Colors.Gray,
		Text = default,
		ClearTextOnFocus = false,
		LayoutOrder = 2,
		Parent = content,
	}, { UI.corner(12), UI.stroke(UI.Colors.Edge, 3) })
	local gender = if math.random() < 0.5 then "F" else "M"
	if askGender then
		local row = UI.row(content, 46, 3)
		UI.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
		local boy, girl
		local function paint()
			boy.BackgroundColor3 = if gender == "M" then rgb(70, 130, 220) else UI.Colors.Gray
			boy:SetAttribute("BaseColor", boy.BackgroundColor3)
			girl.BackgroundColor3 = if gender == "F" then rgb(230, 90, 150) else UI.Colors.Gray
			girl:SetAttribute("BaseColor", girl.BackgroundColor3)
		end
		boy = UI.button({ Text = "♂ Boy", Size = UDim2.fromOffset(130, 42), LayoutOrder = 1, Parent = row, OnClick = function()
			gender = "M"
			paint()
		end })
		girl = UI.button({ Text = "♀ Girl", Size = UDim2.fromOffset(130, 42), LayoutOrder = 2, Parent = row, OnClick = function()
			gender = "F"
			paint()
		end })
		paint()
	end
	local okButton: TextButton
	local function submit()
		local name = PetRules.CleanName(box.Text)
		if not name then
			Windows.Toast("Names need 1-20 letters or numbers.")
			return
		end
		UI.SetEnabled(okButton, false)
		okButton.Text = "…"
		local close = onSubmit(name, gender)
		if close then
			UI.CloseWindow()
		elseif okButton.Parent then
			UI.SetEnabled(okButton, true)
			okButton.Text = "OK"
		end
	end
	okButton = UI.button({ Text = "OK", Color = UI.Colors.Green, Size = UDim2.fromOffset(160, 46), LayoutOrder = 4, Parent = content, OnClick = submit })
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
	task.defer(function()
		box:CaptureFocus()
	end)
end

local SUGGESTED = { "Mittens", "Biscuit", "Pumpkin", "Daisy", "Pepper", "Mochi", "Luna", "Oreo", "Peanut", "Clover", "Ziggy", "Hazel", "Noodle", "Maple", "Sprout", "Pip" }

local function suggestName(): string
	return SUGGESTED[math.random(1, #SUGGESTED)]
end

---------------------------------------------------------------------------
-- Adopt
---------------------------------------------------------------------------

function Windows.Adopt()
	local _, content = UI.window("Adopt", "Adoption Centre", Vector2.new(760, 600))
	local info = State.Request("GetAdoption")
	if not info.ok or not content.Parent then
		return
	end
	local starter = info.starter
	local body: Frame? = nil

	local function showSpecies(speciesId: string)
		if body then
			body:Destroy()
		end
		body = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = content }, { UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center) })
		local entry
		for _, e in info.species do
			if e.species == speciesId then
				entry = e
			end
		end
		local def = Config.Species[speciesId]
		if not entry.unlocked then
			note(body :: Frame, string.format("🔒 %ss unlock at level %d. Keep caring for your pets to level up!", def.Name, def.Level), 1)
			return
		end
		local grid = cardGrid(body :: Frame, Vector2.new(170, 250), 2)
		for _, c in entry.candidates do
			local rare = c.rarity == "Rare"
			local f = card(grid, c.index, if rare then rgb(248, 236, 255) else nil)
			UI.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center).Parent = f
			UI.padding(6).Parent = f
			petPreview(f, { species = speciesId, color = c.look.color, pattern = c.look.pattern, eyes = c.look.eyes, stage = "Adult" }, UDim2.fromOffset(150, 120), 1)
			UI.title({ Text = (if rare then "✨ " else "") .. c.look.color .. " " .. def.Name, Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = if rare then RARE else UI.Colors.Ink, LayoutOrder = 2, Parent = f })
			UI.label({ Text = c.look.pattern .. " · " .. c.look.eyes .. " eyes", Size = UDim2.new(1, 0, 0, 18), TextSize = 13, TextColor3 = UI.Colors.Soft, LayoutOrder = 3, Parent = f })
			local free = starter and speciesId == "Cat"
			local price = if free then 0 else c.price
			local btn = UI.button({
				Text = if c.taken then "Adopted ✓" elseif free then "Adopt FREE" else "Adopt 🪙" .. price,
				Color = if free then UI.Colors.Green else UI.Colors.Pink,
				Size = UDim2.fromOffset(150, 38),
				TextSize = 16,
				LayoutOrder = 4,
				Parent = f,
				OnClick = function()
					Windows.NameDialog("Name your " .. string.lower(def.Name), "What will you call your new " .. c.look.color .. " " .. string.lower(def.Name) .. "?", suggestName(), true, function(name, gender)
						local result = State.Request("Adopt", { species = speciesId, index = c.index, name = name, gender = gender })
						if result.ok then
							UI.Play("Coin", 0.5)
							task.defer(function()
								local _, order = Config.RoomById(result.room)
								State.SetView(State.HomePlot(), order or 1)
								task.wait(0.4)
								selectPet(result.petId)
							end)
						end
						return result.ok == true
					end)
				end,
			})
			if c.taken or (not free and State.Profile and State.Profile.coins < price) then
				UI.SetEnabled(btn, false)
			end
		end
	end

	if starter then
		note(content, "Welcome to Happy Pets! 🐱 Choose your very first kitten. It's free! Then feed it, play with it, and build it a cosy home.", 1)
	else
		local p = State.Profile
		note(content, string.format("Your home has room for %d pets (%d now). New pets arrive every day. Rare coats are marked ✨.", p and p.capacity or 0, petCount()), 1)
	end
	local tabs = {}
	for _, e in info.species do
		if not starter or e.species == "Cat" then
			table.insert(tabs, e.species)
		end
	end
	local highlight = UI.tabs(content, tabs, showSpecies, 2)
	highlight(tabs[1])
	showSpecies(tabs[1])
	if not starter then
		UI.button({
			Text = "🔄 Show me different pets (🪙" .. info.rerollCost .. ")",
			Color = UI.Colors.Blue,
			Size = UDim2.fromOffset(320, 40),
			TextSize = 16,
			LayoutOrder = 4,
			Parent = content,
			OnClick = function()
				local r = State.Request("RerollAdoption")
				if r.ok then
					Windows.Adopt()
				end
			end,
		})
	end
end

---------------------------------------------------------------------------
-- My Pets
---------------------------------------------------------------------------

function Windows.Pets()
	local _, content = UI.window("Pets", "My Pets", Vector2.new(760, 600))
	local p = State.Profile
	if not p then
		return
	end
	local pets = sortedPets()
	note(content, string.format("%d of %d spaces used. Unlock rooms to make space for more pets.", #pets, p.capacity), 1)
	if #pets == 0 then
		note(content, "You don't have any pets yet!", 2)
		UI.button({ Text = "🐾 Adopt a pet", Color = UI.Colors.Pink, Size = UDim2.fromOffset(200, 44), LayoutOrder = 3, Parent = content, OnClick = Windows.Adopt })
		return
	end
	local grid = cardGrid(content, Vector2.new(220, 236), 2)
	for i, pet in pets do
		local f = card(grid, i)
		UI.padding(6).Parent = f
		UI.list(Enum.FillDirection.Vertical, 3, Enum.HorizontalAlignment.Center).Parent = f
		petPreview(f, pet, UDim2.fromOffset(200, 100), 1)
		local g = if pet.gender == "F" then " ♀" else " ♂"
		UI.title({ Text = pet.name .. g, Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = if pet.gender == "F" then rgb(230, 90, 150) else rgb(70, 130, 220), LayoutOrder = 2, Parent = f })
		local rare = PetRules.Rarity(pet.species, pet) == "Rare"
		UI.label({ Text = string.format("%s%s %s · %s", if rare then "✨" else "", pet.color, PetRules.DisplaySpecies(pet), pet.pattern), Size = UDim2.new(1, 0, 0, 16), TextSize = 13, TextColor3 = UI.Colors.Soft, LayoutOrder = 3, Parent = f })
		local moodText, moodIcon = PetRules.MoodLabel(PetRules.Mood(pet))
		local roomDef = Config.RoomById(pet.room)
		UI.label({ Text = string.format("%s %s · %s%s", moodIcon, moodText, roomDef and roomDef.Name or "?", if pet.sleeping then " · 💤" else ""), Size = UDim2.new(1, 0, 0, 16), TextSize = 13, LayoutOrder = 4, Parent = f })
		local row = UI.row(f, 34, 5)
		UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center).Parent = row
		UI.button({ Text = "🔍 Find", Color = UI.Colors.Blue, Size = UDim2.fromOffset(98, 32), TextSize = 14, LayoutOrder = 1, Parent = row, OnClick = function()
			UI.CloseWindow()
			selectPet(pet.id)
		end })
		UI.button({ Text = "✏️ Rename", Color = UI.Colors.Gray, Size = UDim2.fromOffset(98, 32), TextSize = 14, LayoutOrder = 2, Parent = row, OnClick = function()
			Windows.Rename(pet.id, pet.name)
		end })
	end
end

function Windows.Rename(petId: string, current: string)
	Windows.NameDialog("Rename", "Choose a new name for " .. current .. ".", current, false, function(name)
		local result = State.Request("Rename", { petId = petId, name = name })
		if result.ok then
			Windows.Toast("Renamed to " .. tostring(result.name) .. "!")
		end
		return result.ok == true
	end)
end

---------------------------------------------------------------------------
-- Shop
---------------------------------------------------------------------------

local function styleSwatch(parent: Instance, style: any, kind: string, order: number?): Frame
	local swatch = UI.new("Frame", { Size = UDim2.fromOffset(150, 80), BackgroundColor3 = style.Color, LayoutOrder = order or 0, Parent = parent }, { UI.corner(10), UI.stroke(UI.Colors.Edge, 2) })
	local accent = if kind == "Wallpaper" then style.Accent else style.Alt
	if style.Pattern == "Stripes" then
		for i = 0, 4 do
			UI.new("Frame", { Position = UDim2.new(i * 0.2 + 0.05, 0, 0, 0), Size = UDim2.new(0.1, 0, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = swatch })
		end
	elseif style.Pattern == "Dots" or style.Pattern == "Stars" then
		for i = 0, 5 do
			local dot = UI.new("Frame", { Position = UDim2.new((i % 3) * 0.3 + 0.12, 0, (i // 3) * 0.45 + 0.15, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = accent, Rotation = if style.Pattern == "Stars" then 45 else 0, Parent = swatch })
			if style.Pattern == "Dots" then
				UI.corner(7).Parent = dot
			end
		end
	elseif style.Pattern == "Checker" then
		for x = 0, 5 do
			for y = 0, 2 do
				if (x + y) % 2 == 1 then
					UI.new("Frame", { Position = UDim2.fromScale(x / 6, y / 3), Size = UDim2.fromScale(1 / 6, 1 / 3), BackgroundColor3 = accent, BorderSizePixel = 0, Parent = swatch })
				end
			end
		end
	end
	return swatch
end

local function ownsStyle(kind: string, style: any): boolean
	return style.Price == 0 or (State.Profile and State.Profile.styles[style.Id] == true)
end

function Windows.Shop(startTab: string?)
	local _, content = UI.window("Shop", "Pet Shop", Vector2.new(780, 620))
	local body: Frame? = nil
	local currentTab = startTab or "Food"

	local function showTab(tab: string)
		currentTab = tab
		if body then
			body:Destroy()
		end
		body = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = content }, { UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center) })
		local p = State.Profile
		if not p then
			return
		end

		if tab == "Styles" then
			for kindIndex, kind in { "Wallpaper", "Floor" } do
				UI.title({ Text = if kind == "Wallpaper" then "Wallpaper" else "Floors", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = kindIndex * 10, Parent = body })
				local grid = cardGrid(body :: Frame, Vector2.new(170, 190), kindIndex * 10 + 1)
				local list = if kind == "Wallpaper" then Config.Wallpapers else Config.Floors
				for i, style in list do
					if style.Id == "grass" then
						continue
					end
					local f = card(grid, i)
					UI.padding(8).Parent = f
					UI.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center).Parent = f
					styleSwatch(f, style, kind, 1)
					UI.title({ Text = style.Name, Size = UDim2.new(1, 0, 0, 20), TextSize = 16, LayoutOrder = 2, Parent = f })
					local owned = ownsStyle(kind, style)
					local locked = p.level < style.Level
					local btn = UI.button({
						Text = if owned then "Owned ✓" elseif locked then "🔒 Level " .. style.Level else "Buy 🪙" .. style.Price,
						Color = UI.Colors.Orange,
						Size = UDim2.fromOffset(150, 36),
						TextSize = 15,
						LayoutOrder = 3,
						Parent = f,
						OnClick = function()
							local r = State.Request("BuyStyle", { kind = kind, styleId = style.Id })
							if r.ok then
								Windows.Toast("Bought " .. style.Name .. "! Apply it from 🏠 Rooms.")
								showTab(currentTab)
							end
						end,
					})
					if owned or locked or p.coins < style.Price then
						UI.SetEnabled(btn, false)
					end
				end
			end
			return
		end

		local ids = {}
		for id, item in Config.Items do
			if item.Tab == tab then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a, b)
			local ia, ib = Config.Items[a], Config.Items[b]
			if ia.Level ~= ib.Level then
				return ia.Level < ib.Level
			end
			return ia.Price < ib.Price
		end)
		local grid = cardGrid(body :: Frame, Vector2.new(170, 236), 1)
		for i, id in ids do
			local item = Config.Items[id]
			local locked = p.level < item.Level
			local f = card(grid, i)
			UI.padding(6).Parent = f
			UI.list(Enum.FillDirection.Vertical, 3, Enum.HorizontalAlignment.Center).Parent = f
			if item.Kind == "Furniture" then
				preview(f, FurnitureModels.Create(id), UDim2.fromOffset(150, 90), 1, true)
			else
				local icon = UI.new("Frame", { Size = UDim2.fromOffset(150, 90), BackgroundColor3 = rgb(255, 238, 244), LayoutOrder = 1, Parent = f }, { UI.corner(12) })
				UI.label({ Size = UDim2.fromScale(1, 1), Text = item.Icon, TextSize = 52, Parent = icon })
			end
			UI.title({ Text = item.Name, Size = UDim2.new(1, 0, 0, 20), TextSize = 16, LayoutOrder = 2, Parent = f })
			local effects = {}
			if item.Effects then
				for _, need in Config.Needs do
					local v = item.Effects[need]
					if v then
						table.insert(effects, string.format("%s+%d", Config.NeedInfo[need].Icon, v))
					end
				end
			end
			local desc = item.Desc .. (if #effects > 0 then "\n" .. table.concat(effects, " ") elseif item.Comfort and item.Comfort > 0 then "\n😌 Comfort +" .. item.Comfort else "")
			UI.label({ Text = desc, Size = UDim2.new(1, 0, 0, 40), TextSize = 12, TextColor3 = UI.Colors.Soft, LayoutOrder = 3, Parent = f })
			local owned = p.inventory[id] or 0
			UI.label({ Text = if owned > 0 then "You have " .. owned else " ", Size = UDim2.new(1, 0, 0, 14), TextSize = 12, LayoutOrder = 4, Parent = f })
			local row = UI.row(f, 36, 5)
			UI.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center).Parent = row
			local function buy(qty: number)
				local r = State.Request("Buy", { itemId = id, qty = qty })
				if r.ok then
					UI.Play("Coin", 0.4)
					if item.Kind == "Furniture" then
						UI.confirm("Bought " .. item.Name .. "!", "Place it in your room now? You can also place it later from 🎒 Items.", "Place it!", function()
							Windows.StartPlacing(id)
						end)
					else
						Windows.Toast(string.format("Bought %d × %s!", qty, item.Name))
						showTab(currentTab)
					end
				end
			end
			if locked then
				local b = UI.button({ Text = "🔒 Level " .. item.Level, Color = UI.Colors.Gray, Size = UDim2.fromOffset(150, 34), TextSize = 15, LayoutOrder = 1, Parent = row })
				UI.SetEnabled(b, false)
			else
				local b1 = UI.button({ Text = "🪙" .. item.Price, Color = UI.Colors.Orange, Size = UDim2.fromOffset(if item.Kind == "Consumable" then 74 else 150, 34), TextSize = 15, LayoutOrder = 1, Parent = row, Tooltip = "Buy one", OnClick = function()
					buy(1)
				end })
				UI.SetEnabled(b1, p.coins >= item.Price)
				if item.Kind == "Consumable" then
					local b5 = UI.button({ Text = "×5 🪙" .. item.Price * 5, Color = UI.Colors.Orange, Size = UDim2.fromOffset(74, 34), TextSize = 13, LayoutOrder = 2, Parent = row, Tooltip = "Buy five", OnClick = function()
						buy(5)
					end })
					UI.SetEnabled(b5, p.coins >= item.Price * 5)
				end
			end
		end
	end

	note(content, "Food and care items are used on pets. Toys and furniture go in your rooms, and decorations keep pets happy for longer.", 1)
	local highlight = UI.tabs(content, Config.ShopTabs, showTab, 2)
	highlight(currentTab)
	showTab(currentTab)
end

---------------------------------------------------------------------------
-- Items (inventory)
---------------------------------------------------------------------------

function Windows.Items()
	local _, content = UI.window("Items", "My Items", Vector2.new(720, 580))
	local p = State.Profile
	if not p then
		return
	end
	local consumables, furniture = {}, {}
	for id, count in p.inventory do
		local item = Config.Items[id]
		if item and count > 0 then
			table.insert(if item.Kind == "Consumable" then consumables else furniture, id)
		end
	end
	table.sort(consumables)
	table.sort(furniture)

	UI.title({ Text = "Food & care", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1, Parent = content })
	if #consumables == 0 then
		note(content, "No food or care items. Pick some up in the shop!", 2)
	else
		local grid = cardGrid(content, Vector2.new(150, 150), 2)
		for i, id in consumables do
			local item = Config.Items[id]
			local f = card(grid, i)
			UI.padding(6).Parent = f
			UI.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center).Parent = f
			UI.label({ Text = item.Icon, Size = UDim2.new(1, 0, 0, 44), TextSize = 38, LayoutOrder = 1, Parent = f })
			UI.title({ Text = item.Name, Size = UDim2.new(1, 0, 0, 20), TextSize = 15, LayoutOrder = 2, Parent = f })
			UI.label({ Text = "×" .. p.inventory[id], Size = UDim2.new(1, 0, 0, 18), TextSize = 15, LayoutOrder = 3, Parent = f })
			UI.button({ Text = "Use", Color = UI.Colors.Green, Size = UDim2.fromOffset(120, 32), TextSize = 15, LayoutOrder = 4, Parent = f, Tooltip = "Use on the selected pet", OnClick = function()
				local pet = State.SelectedPet
				if not pet or State.IsVisiting() then
					Windows.Toast("Click one of your pets first, then use the item.")
					UI.CloseWindow()
					return
				end
				local r = State.Request("Care", { petId = pet:GetAttribute("PetId"), action = "UseItem", itemId = id })
				if r.ok then
					UI.CloseWindow()
				end
			end })
		end
	end

	UI.title({ Text = "Furniture & toys", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 3, Parent = content })
	if #furniture == 0 then
		note(content, "Everything you own is already placed. Buy more in the shop, or use 🛋️ Decorate to put items away.", 4)
	else
		local grid = cardGrid(content, Vector2.new(150, 170), 4)
		for i, id in furniture do
			local item = Config.Items[id]
			local f = card(grid, i)
			UI.padding(6).Parent = f
			UI.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center).Parent = f
			preview(f, FurnitureModels.Create(id), UDim2.fromOffset(130, 70), 1, true)
			UI.title({ Text = item.Name, Size = UDim2.new(1, 0, 0, 20), TextSize = 15, LayoutOrder = 2, Parent = f })
			UI.label({ Text = "×" .. p.inventory[id], Size = UDim2.new(1, 0, 0, 16), TextSize = 14, LayoutOrder = 3, Parent = f })
			UI.button({ Text = "Place", Color = UI.Colors.Green, Size = UDim2.fromOffset(120, 32), TextSize = 15, LayoutOrder = 4, Parent = f, OnClick = function()
				UI.CloseWindow()
				Windows.StartPlacing(id)
			end })
		end
	end
end

---------------------------------------------------------------------------
-- Breed
---------------------------------------------------------------------------

function Windows.Breed()
	local _, content = UI.window("Breed", "Baby Pets", Vector2.new(760, 620))
	local p = State.Profile
	if not p then
		return
	end
	local now = workspace:GetServerTimeNow()

	-- Babies on the way.
	if #p.births > 0 then
		UI.title({ Text = "Babies on the way", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1, Parent = content })
		local grid = cardGrid(content, Vector2.new(200, 210), 2)
		for i, b in p.births do
			local def = Config.Species[b.species]
			local f = card(grid, i, rgb(255, 240, 246))
			UI.padding(6).Parent = f
			UI.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center).Parent = f
			local ready = b.readyAt <= now
			if ready then
				petPreview(f, { species = b.species, color = b.look.color, pattern = b.look.pattern, eyes = b.look.eyes, stage = "Baby" }, UDim2.fromOffset(180, 100), 1)
			else
				local egg = UI.new("Frame", { Size = UDim2.fromOffset(180, 100), BackgroundColor3 = rgb(255, 238, 244), LayoutOrder = 1, Parent = f }, { UI.corner(12) })
				UI.label({ Size = UDim2.fromScale(1, 1), Text = "🎀", TextSize = 50, Parent = egg })
			end
			local status = UI.title({ Text = if ready then "A " .. string.lower(def.Baby) .. " is here!" else "", Size = UDim2.new(1, 0, 0, 22), TextSize = 16, LayoutOrder = 2, Parent = f })
			if not ready then
				local conn
				conn = RunService.Heartbeat:Connect(function()
					if not status.Parent then
						conn:Disconnect()
						return
					end
					local left = math.max(0, b.readyAt - workspace:GetServerTimeNow())
					status.Text = string.format("Arriving in %d:%02d", left // 60, math.floor(left % 60))
					if left <= 0 then
						conn:Disconnect()
						Windows.Breed()
					end
				end)
			end
			local btn = UI.button({ Text = "💕 Meet baby", Color = UI.Colors.Pink, Size = UDim2.fromOffset(170, 38), TextSize = 16, LayoutOrder = 3, Parent = f, OnClick = function()
				Windows.NameDialog("Name your " .. string.lower(def.Baby), "Your new " .. b.look.color .. " " .. string.lower(def.Baby) .. " needs a name!", suggestName(), true, function(name, gender)
					local r = State.Request("ClaimBirth", { birthId = b.id, name = name, gender = gender })
					if r.ok then
						task.defer(function()
							local _, order = Config.RoomById(r.room)
							State.SetView(State.HomePlot(), order or 1)
							task.wait(0.4)
							selectPet(r.petId)
						end)
					end
					return r.ok == true
				end)
			end })
			UI.SetEnabled(btn, ready)
		end
	end

	note(content, string.format("Pick a boy and a girl of the same kind. Both must be grown up and happy. Costs 🪙%d; the baby arrives after %d minutes and inherits its parents' coats, with a small chance of something rare ✨.", Config.Breeding.Cost, Config.Breeding.Duration // 60), 3)

	local adults = {}
	for _, pet in sortedPets() do
		if pet.stage == "Adult" then
			table.insert(adults, pet)
		end
	end
	if #adults < 2 then
		note(content, "You need at least two grown-up pets (a boy and a girl of the same kind). Adopt more from 🐾 Adopt!", 4)
		return
	end

	local chosen: { [string]: any } = { M = nil, F = nil }
	local row = UI.row(content, 0, 5)
	row.AutomaticSize = Enum.AutomaticSize.Y
	UI.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center).Parent = row
	local breedButton: TextButton
	local summary: TextLabel
	local columnButtons: { [string]: { [string]: TextButton } } = { M = {}, F = {} }

	local function refreshChoice()
		for gender, buttons in columnButtons do
			for id, btn in buttons do
				local on = chosen[gender] and chosen[gender].id == id
				local base = if gender == "F" then rgb(230, 90, 150) else rgb(70, 130, 220)
				btn.BackgroundColor3 = if on then base else rgb(200, 196, 200)
				btn:SetAttribute("BaseColor", btn.BackgroundColor3)
			end
		end
		local a, b = chosen.M, chosen.F
		if a and b then
			local ok, why = PetRules.CanBreed(a, b, workspace:GetServerTimeNow())
			summary.Text = if ok then string.format("%s + %s 💕 Their baby could be %s or %s, %s or %s.", a.name, b.name, a.color, b.color, a.pattern, b.pattern) else "⚠ " .. tostring(why)
			UI.SetEnabled(breedButton, ok == true and p.coins >= Config.Breeding.Cost)
		else
			summary.Text = "Choose one pet from each column."
			UI.SetEnabled(breedButton, false)
		end
	end

	for _, gender in { "M", "F" } do
		local col = UI.new("Frame", { Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = if gender == "M" then 1 else 2, Parent = row }, { UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center) })
		UI.title({ Text = if gender == "M" then "♂ Boys" else "♀ Girls", Size = UDim2.new(1, 0, 0, 24), TextColor3 = if gender == "F" then rgb(230, 90, 150) else rgb(70, 130, 220), Parent = col })
		local any = false
		for i, pet in adults do
			if pet.gender == gender then
				any = true
				local cooling = workspace:GetServerTimeNow() - (pet.lastBredAt or 0) < Config.Breeding.Cooldown
				columnButtons[gender][pet.id] = UI.button({
					Text = string.format("%s · %s %s%s", pet.name, pet.color, Config.Species[pet.species].Name, if cooling then " ⏳" else ""),
					Color = rgb(200, 196, 200),
					Size = UDim2.new(1, 0, 0, 36),
					TextSize = 14,
					LayoutOrder = i,
					Parent = col,
					OnClick = function()
						chosen[gender] = pet
						refreshChoice()
					end,
				})
			end
		end
		if not any then
			note(col, "No grown-up " .. (if gender == "M" then "boys" else "girls") .. " yet.", 99)
		end
	end
	summary = note(content, "", 6)
	summary.TextColor3 = UI.Colors.Ink
	breedButton = UI.button({ Text = "💞 Breed (🪙" .. Config.Breeding.Cost .. ")", Color = UI.Colors.Pink, Size = UDim2.fromOffset(240, 46), LayoutOrder = 7, Parent = content, OnClick = function()
		if not chosen.M or not chosen.F then
			return
		end
		local r = State.Request("Breed", { a = chosen.M.id, b = chosen.F.id })
		if r.ok then
			Windows.Breed()
		end
	end })
	refreshChoice()
end

---------------------------------------------------------------------------
-- Rooms
---------------------------------------------------------------------------

function Windows.Rooms()
	local _, content = UI.window("Rooms", "My Home", Vector2.new(760, 620))
	local p = State.Profile
	if not p then
		return
	end
	note(content, "Unlock rooms to make space for more pets, and give each room its own wallpaper and floor. Buy new styles in 🛍️ Shop → Styles.", 1)
	for order, def in Config.Rooms do
		local roomData = State.RoomData(def.Id)
		local f = card(content, order + 1)
		f.Size = UDim2.new(1, -10, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		UI.padding(10).Parent = f
		UI.list(Enum.FillDirection.Vertical, 6).Parent = f
		local header = UI.row(f, 36, 1)
		UI.title({ Text = (if roomData then "" else "🔒 ") .. def.Name, Size = UDim2.new(0.5, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
		if roomData then
			local n = petCount(def.Id)
			UI.label({ Text = string.format("%d/%d pets", n, def.Capacity), Position = UDim2.fromScale(0.45, 0), Size = UDim2.new(0.25, 0, 1, 0), TextSize = 15, Parent = header })
			UI.button({ Text = "Go there", Color = UI.Colors.Blue, Size = UDim2.fromOffset(120, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), TextSize = 15, Parent = header, OnClick = function()
				UI.CloseWindow()
				State.SetView(State.HomePlot(), order)
			end })
			if def.Outdoor then
				note(f, "An outdoor garden with room for " .. def.Capacity .. " pets.", 2)
			else
				for kindIndex, kind in { "Wallpaper", "Floor" } do
					local list = if kind == "Wallpaper" then Config.Wallpapers else Config.Floors
					local strip = UI.new("ScrollingFrame", {
						Size = UDim2.new(1, 0, 0, 74),
						BackgroundTransparency = 1,
						CanvasSize = UDim2.new(),
						AutomaticCanvasSize = Enum.AutomaticSize.X,
						ScrollingDirection = Enum.ScrollingDirection.X,
						ScrollBarThickness = 6,
						LayoutOrder = 1 + kindIndex,
						Parent = f,
					}, { UI.list(Enum.FillDirection.Horizontal, 6) })
					UI.label({ Text = kind, Size = UDim2.fromOffset(70, 60), TextSize = 14, Font = UI.Font, LayoutOrder = 0, Parent = strip })
					local currentId = if kind == "Wallpaper" then roomData.wallpaper else roomData.floor
					for i, style in list do
						if style.Id == "grass" or not ownsStyle(kind, style) then
							continue
						end
						local btn = UI.new("TextButton", { Size = UDim2.fromOffset(90, 60), Text = "", AutoButtonColor = true, BackgroundTransparency = 1, LayoutOrder = i, Parent = strip })
						local sw = styleSwatch(btn, style, kind)
						sw.Size = UDim2.fromScale(1, 1)
						sw.Active = false
						for _, d in sw:GetDescendants() do
							if d:IsA("GuiObject") then
								d.Active = false
							end
						end
						local st = sw:FindFirstChildOfClass("UIStroke")
						if st and style.Id == currentId then
							st.Color = UI.Colors.Pink
							st.Thickness = 5
						end
						UI.tooltip(btn, style.Name)
						btn.Activated:Connect(function()
							UI.Play("Click", 0.4)
							local r = State.Request("SetStyle", { roomId = def.Id, kind = kind, styleId = style.Id })
							if r.ok then
								State.SetView(State.HomePlot(), order)
								Windows.Rooms()
							end
						end)
					end
				end
			end
		else
			local nextRoom = nil
			for _, d in Config.Rooms do
				if not State.HasRoom(d.Id) then
					nextRoom = d
					break
				end
			end
			local isNext = nextRoom and nextRoom.Id == def.Id
			note(f, string.format("Room for %d more pets. Needs level %d and 🪙%d.%s", def.Capacity, def.Level, def.Price, if isNext then "" else " Unlock the rooms before it first."), 2)
			if isNext then
				local btn = UI.button({ Text = "🔓 Unlock (🪙" .. def.Price .. ")", Color = UI.Colors.Green, Size = UDim2.fromOffset(220, 40), TextSize = 16, LayoutOrder = 3, Parent = f, OnClick = function()
					UI.confirm("Unlock " .. def.Name .. "?", "This costs 🪙" .. def.Price .. ".", "Unlock!", function()
						local r = State.Request("UnlockRoom", { roomId = def.Id })
						if r.ok then
							UI.Play("Coin", 0.6)
							State.SetView(State.HomePlot(), order)
						end
					end)
				end })
				UI.SetEnabled(btn, p.level >= def.Level and p.coins >= def.Price)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Visit
---------------------------------------------------------------------------

function Windows.Visit()
	local _, content = UI.window("Visit", "Visit Neighbours", Vector2.new(560, 520))
	note(content, string.format("Visit other players' homes and pet their pets. Each pet you pet gives you 🪙%d (up to %d a day), and makes its owner's pet happier!", Config.Visit.Coins, Config.Visit.PerDay), 1)
	local plots = workspace:FindFirstChild("Plots")
	local any = false
	for i, plot in (if plots then plots:GetChildren() else {}) do
		if plot:GetAttribute("Owner") ~= player.UserId then
			any = true
			local f = card(content, i + 1)
			f.Size = UDim2.new(1, -10, 0, 56)
			local pets = plot:FindFirstChild("Pets")
			UI.title({ Text = "🏡 " .. tostring(plot:GetAttribute("OwnerName")), Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.6, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
			UI.label({ Text = (if pets then #pets:GetChildren() else 0) .. " pets", Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0.2, 0, 1, 0), TextSize = 15, Parent = f })
			UI.button({ Text = "Visit", Color = UI.Colors.Green, Size = UDim2.fromOffset(110, 40), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Parent = f, OnClick = function()
				UI.CloseWindow()
				State.SetView(plot :: Model, 1)
			end })
		end
	end
	if not any then
		note(content, "Nobody else is here right now. Invite a friend to visit your pets!", 2)
	end
	if State.IsVisiting() then
		UI.button({ Text = "🏠 Go home", Color = UI.Colors.Pink, Size = UDim2.fromOffset(180, 42), LayoutOrder = 99, Parent = content, OnClick = function()
			UI.CloseWindow()
			State.SetView(State.HomePlot(), 1)
		end })
	end
end

---------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------

function Windows.Settings()
	local _, content = UI.window("Settings", "Settings", Vector2.new(520, 560))
	local p = State.Profile
	local soundOn = not p or p.settings.sound ~= false
	local soundButton: TextButton
	soundButton = UI.button({ Text = if soundOn then "🔊 Sound: On" else "🔈 Sound: Off", Color = UI.Colors.Blue, Size = UDim2.fromOffset(220, 44), LayoutOrder = 1, Parent = content, OnClick = function()
		soundOn = not soundOn
		UI.SoundOn = soundOn
		soundButton.Text = if soundOn then "🔊 Sound: On" else "🔈 Sound: Off"
		State.Request("SetSetting", { key = "sound", value = soundOn })
	end })

	UI.title({ Text = "How to play", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 2, Parent = content })
	note(content, table.concat({
		"• Click a pet to see its needs and care for it.",
		"• Keep Food, Fun, Energy and Clean up and Health follows.",
		"• Happy pets leave 🪙 gifts. Click them to collect!",
		"• Toys let pets play; beds help them sleep faster; decorations keep them happy longer.",
		"• ◀ ▶ switch rooms. Mouse wheel zooms. Right-drag or Q/E turns the view.",
		"• In Decorate mode click furniture to move it. R rotates.",
	}, "\n"), 3)

	if p then
		UI.title({ Text = "Your stats", Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 4, Parent = content })
		note(content, string.format("Care actions: %d · Pets adopted: %d · Babies: %d · Gifts: %d", p.stats.care, p.stats.adopted, p.stats.bred, p.stats.gifts), 5)
	end
	local status = player:GetAttribute("SaveStatus")
	note(content, if status == "Offline" then "⚠ Saving is unavailable on this server (DataStores are off), so progress won't be kept." else "💾 Your home saves automatically every minute and when you leave.", 6)

	UI.button({ Text = "Reset save…", Color = UI.Colors.Red, Size = UDim2.fromOffset(200, 40), TextSize = 16, LayoutOrder = 7, Parent = content, OnClick = function()
		UI.confirm("Reset everything?", "This deletes ALL your pets, coins, furniture and levels and starts over. This can't be undone!", "Yes, reset", function()
			UI.confirm("Are you really sure?", "Last chance! Every pet will be gone.", "Reset forever", function()
				local r = State.Request("ResetSave", { confirm = "RESET" })
				if r.ok then
					Windows.Toast("Your save was reset. Welcome back!")
				end
			end)
		end)
	end })
end

return Windows
]]></ProtectedString></Properties></Item></Item><Item class="StarterCharacterScripts" referent="RBX0000001F"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item></roblox>
